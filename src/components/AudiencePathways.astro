---
import { audiencePathways, destinationOrganizations } from "@/data/audiences";

interface Props {
  eyebrow?: string;
  title?: string;
  intro?: string;
  id?: string;
  compact?: boolean;
}

const {
  eyebrow = "Find your route",
  title = "Every audience has a useful next home.",
  intro = "Global Enterprise remains the direct home for institutional advisory. When another part of the organization is better equipped for the reader's next step, we make that handoff explicit.",
  id = "audience-pathways",
  compact = false,
} = Astro.props;

const pathways = compact ? audiencePathways.filter((pathway) => pathway.priority !== "P2") : audiencePathways;
---

<section id={id} class="section-pad bg-paper" aria-labelledby={`${id}-title`}>
  <div class="container-site">
    <div class="grid gap-10 lg:grid-cols-[.72fr_1.28fr] lg:items-end lg:gap-20">
      <div>
        <p class="eyebrow text-cobalt">{eyebrow}</p>
        <h2 id={`${id}-title`} class="section-title mt-5 max-w-3xl">{title}</h2>
      </div>
      <p class="max-w-3xl text-lg leading-relaxed text-muted">{intro}</p>
    </div>

    <div class="mt-12 grid gap-px border border-line bg-line sm:grid-cols-2 xl:grid-cols-4" role="list" aria-label="Audience pathways">
      {pathways.map((pathway) => {
        const destination = destinationOrganizations[pathway.destinationKey];
        return (
          <article class="flex min-h-[19rem] flex-col bg-white p-7 md:p-8" role="listitem">
            <div class="flex items-start justify-between gap-4">
              <p class="eyebrow text-cobalt">{pathway.eyebrow}</p>
              <span class="text-xs font-bold uppercase tracking-[0.12em] text-muted">{pathway.priority}</span>
            </div>
            <h3 class="mt-8 font-display text-2xl font-medium leading-tight tracking-[-0.05em]">{pathway.title}</h3>
            <p class="mt-4 text-sm leading-relaxed text-muted">{pathway.description}</p>
            <div class="mt-auto flex flex-col items-start gap-3 pt-8">
              {pathway.external ? (
                <a class="ink-link" href={pathway.href} target="_blank" rel="noopener noreferrer" data-track="audience_destination" data-track-label={pathway.id}>
                  {pathway.linkLabel} <span aria-hidden="true">↗</span>
                </a>
              ) : (
                <a class="ink-link" href={pathway.href} data-track="audience_destination" data-track-label={pathway.id}>
                  {pathway.linkLabel} <span aria-hidden="true">↗</span>
                </a>
              )}
              {pathway.supportingHref && pathway.supportingLabel && <a class="text-xs font-bold uppercase tracking-[0.1em] text-muted underline decoration-cobalt/30 underline-offset-4 hover:text-cobalt" href={pathway.supportingHref}>{pathway.supportingLabel}</a>}
              <p class="text-[0.68rem] uppercase tracking-[0.1em] text-muted/80">Primary home: {destination.name}</p>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>
