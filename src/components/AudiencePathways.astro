---
import { audiencePathways, destinationOrganizations } from "@/data/audiences";
import { serviceAudiencePathways } from "@/data/site";

interface Props {
  eyebrow?: string;
  title?: string;
  intro?: string;
  id?: string;
  compact?: boolean;
  audienceKeys?: string[];
  pathwayIds?: string[];
  servicePathwayIds?: string[];
}

const {
  eyebrow = "Find your route",
  title = "The next step is part of the system.",
  intro = "Global Enterprise remains the direct home for institutional advisory. When another part of the organization is better equipped for the reader's next step, we make that handoff explicit.",
  id = "organization-map",
  compact = false,
  audienceKeys = [],
  pathwayIds = [],
  servicePathwayIds = [],
} = Astro.props;

const requestedAudienceKeys = new Set(audienceKeys);
const requestedPathwayIds = new Set(pathwayIds);
const pathways = pathwayIds.length === 0 && servicePathwayIds.length > 0 ? [] : audiencePathways.filter((pathway) => {
  if (compact && pathway.priority === "P2") return false;
  if (requestedAudienceKeys.size > 0 && !pathway.audienceKeys.some((key) => requestedAudienceKeys.has(key))) return false;
  if (requestedPathwayIds.size > 0 && !requestedPathwayIds.has(pathway.id)) return false;
  return true;
});
const servicePathways = serviceAudiencePathways.filter((pathway) => {
  if (servicePathwayIds.length === 0 || !servicePathwayIds.includes(pathway.id)) return false;
  return true;
});
---

<section id={id} class="section-pad bg-paper" aria-labelledby={`${id}-title`}>
  <div class="container-site">
    <div class="grid gap-10 lg:grid-cols-[.72fr_1.28fr] lg:items-end lg:gap-20">
      <div>
        <p class="eyebrow text-cobalt">{eyebrow}</p>
        <h2 id={`${id}-title`} class="section-title mt-5 max-w-3xl">{title}</h2>
      </div>
      <p class="max-w-3xl text-lg leading-relaxed text-muted">{intro}</p>
    </div>

    <div class="mt-12 grid gap-px border border-line bg-line sm:grid-cols-2 xl:grid-cols-4" role="list" aria-label="Connected workbenches">
      {pathways.map((pathway) => {
        const destination = destinationOrganizations[pathway.destinationKey];
        return (
          <article class="flex min-h-[19rem] flex-col bg-white p-7 md:p-8" role="listitem">
            <div class="flex items-start justify-between gap-4">
              <p class="eyebrow text-cobalt">{pathway.eyebrow}</p>
            </div>
            <h3 class="mt-8 font-display text-2xl font-medium leading-tight tracking-[-0.05em]">{pathway.title}</h3>
            <p class="mt-4 text-sm leading-relaxed text-muted">{pathway.description}</p>
            <div class="mt-auto flex flex-col items-start gap-3 pt-8">
              {pathway.external ? <a class="ink-link" href={pathway.href} target="_blank" rel="noopener noreferrer" data-track="audience_destination" data-track-label={pathway.id}>{pathway.linkLabel} <span aria-hidden="true">↗</span></a> : <a class="ink-link" href={pathway.href} data-track="audience_destination" data-track-label={pathway.id}>{pathway.linkLabel} <span aria-hidden="true">↗</span></a>}
              {pathway.supportingHref && pathway.supportingLabel && <a class="text-xs font-bold uppercase tracking-[0.1em] text-muted underline decoration-cobalt/30 underline-offset-4 hover:text-cobalt" href={pathway.supportingHref}>{pathway.supportingLabel}</a>}
              <p class="text-[0.68rem] uppercase tracking-[0.1em] text-muted/80">Primary home: {destination.name}</p>
            </div>
          </article>
        );
      })}
      {servicePathways.map((pathway) => (
        <article class="flex min-h-[19rem] flex-col bg-white p-7 md:p-8" role="listitem">
          <div class="flex items-start justify-between gap-4">
            <p class="eyebrow text-cobalt">{pathway.eyebrow}</p>
          </div>
          <h3 class="mt-8 font-display text-2xl font-medium leading-tight tracking-[-0.05em]"><a class="transition-colors hover:text-cobalt" href={pathway.href}>{pathway.title}</a></h3>
          <p class="mt-4 text-sm leading-relaxed text-muted">{pathway.description}</p>
          <div class="mt-auto flex flex-col items-start gap-3 pt-8">
            <a class="ink-link" href={pathway.href} data-track="audience_destination" data-track-label={pathway.id}>{pathway.linkLabel} <span aria-hidden="true">↗</span></a>
            {pathway.supportingHref && pathway.supportingLabel && <a class="text-xs font-bold uppercase tracking-[0.1em] text-muted underline decoration-cobalt/30 underline-offset-4 hover:text-cobalt" href={pathway.supportingHref}>{pathway.supportingLabel}</a>}
            <p class="text-[0.68rem] uppercase tracking-[0.1em] text-muted/80">Primary home: Global Enterprise</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
