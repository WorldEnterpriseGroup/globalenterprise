---
import { engagements } from "@/data/site";

interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<div class:list={["grid gap-px border border-line bg-line", compact ? "md:grid-cols-3" : "md:grid-cols-3"]}>
  {engagements.map((engagement) => (
    <a class="group bg-paper p-8 transition-colors hover:bg-cobalt hover:text-white md:p-10" href={engagement.href} data-track="engagement_view" data-track-label={engagement.title}>
      <div class="flex items-start justify-between gap-4">
        <p class="font-display text-4xl text-cobalt transition-colors group-hover:text-lime">{engagement.number}</p>
        <span class="pill transition-colors group-hover:border-white/30 group-hover:text-white/75">{engagement.duration}</span>
      </div>
      <h3 class="mt-12 font-display text-2xl font-medium tracking-[-0.04em]">{engagement.title}</h3>
      <p class="mt-4 font-bold text-cobalt transition-colors group-hover:text-lime">{engagement.fit}</p>
      <p class="mt-4 leading-relaxed text-muted transition-colors group-hover:text-white/70">{engagement.deliverable}</p>
      <span class="mt-8 inline-flex text-xs font-bold uppercase tracking-[0.12em] text-cobalt transition-colors group-hover:text-lime">Discuss this path ↗</span>
    </a>
  ))}
</div>
