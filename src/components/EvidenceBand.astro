---
import AssetImage from "@/components/AssetImage.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import { publicSignals } from "@/data/site";

interface Props {
  eyebrow?: string;
  title?: string;
  text?: string;
  limit?: number;
  photoSrc?: string;
  photoAlt?: string;
  photoCaption?: string;
}

const {
  eyebrow = "The public record",
  title = "The context behind the work.",
  text = "Good strategy starts with evidence, then turns evidence into a decision the organization can act on.",
  limit = publicSignals.length,
  photoSrc,
  photoAlt = "",
  photoCaption = "",
} = Astro.props;
---

<section class="section-pad bg-paper">
  <div class="container-site">
    <div class:list={[photoSrc && "evidence-band-intro"]}>
      <SectionHeading eyebrow={eyebrow} title={title} text={text} />
      {photoSrc && <figure class="evidence-band-photo">
        <AssetImage src={photoSrc} alt={photoAlt} width={1536} height={1024} loading="lazy" decoding="async" class="aspect-[4/3] w-full object-cover" />
        {photoCaption && <figcaption>{photoCaption}</figcaption>}
      </figure>}
    </div>
    <div class="mt-14 grid gap-px border border-line bg-line md:grid-cols-2 xl:grid-cols-5">
      {publicSignals.slice(0, limit).map((signal) => (
        <article class="bg-paper p-7 md:p-8">
          <p class="font-display text-5xl font-medium tracking-[-0.06em] text-cobalt">{signal.value}</p>
          <h3 class="mt-5 font-display text-xl font-medium leading-tight tracking-[-0.04em]">{signal.label}</h3>
          <p class="mt-4 text-sm leading-relaxed text-muted">{signal.text}</p>
          <a class="mt-6 inline-flex text-[0.68rem] font-bold uppercase tracking-[0.12em] text-cobalt underline decoration-cobalt/30 underline-offset-4 hover:decoration-cobalt" href={signal.source} target="_blank" rel="noreferrer">{signal.sourceLabel} ↗</a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .evidence-band-intro {
    display: grid;
    gap: 2rem;
    align-items: end;
  }

  @media (min-width: 900px) {
    .evidence-band-intro { grid-template-columns: minmax(0, 1.2fr) minmax(16rem, 0.8fr); }
  }

  .evidence-band-photo {
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--color-line);
    background: white;
    box-shadow: 0.8rem 0.8rem 0 color-mix(in srgb, var(--color-cobalt) 13%, transparent);
  }

  .evidence-band-photo figcaption {
    padding: 0.7rem 0.85rem;
    color: var(--color-muted);
    font-size: 0.68rem;
    line-height: 1.45;
  }
</style>
