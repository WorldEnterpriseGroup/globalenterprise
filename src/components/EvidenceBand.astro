---
import AssetImage from "@/components/AssetImage.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import { publicSignals } from "@/data/site";

interface Props {
  eyebrow?: string;
  title?: string;
  text?: string;
  limit?: number;
  photoSrc?: string;
  photoAlt?: string;
  photoCaption?: string;
}

const {
  eyebrow = "The public record",
  title = "The context behind the work.",
  text = "Good strategy starts with evidence, then turns evidence into a decision the organization can act on.",
  limit = publicSignals.length,
  photoSrc,
  photoAlt = "",
  photoCaption = "",
} = Astro.props;
---

<section class="section-pad bg-paper">
  <div class="container-site">
    <div class="evidence-band-intro">
      <SectionHeading eyebrow={eyebrow} title={title} text={text} />
    </div>
    <div class:list={["evidence-band-grid", photoSrc && "evidence-band-grid-with-photo"]}>
      {publicSignals.slice(0, limit).map((signal) => (
        <article class="bg-paper p-7 md:p-8">
          <p class="font-display text-5xl font-medium tracking-[-0.06em] text-cobalt">{signal.value}</p>
          <h3 class="mt-5 font-display text-xl font-medium leading-tight tracking-[-0.04em]">{signal.label}</h3>
          <p class="mt-4 text-sm leading-relaxed text-muted">{signal.text}</p>
          <a class="mt-6 inline-flex text-[0.68rem] font-bold uppercase tracking-[0.12em] text-cobalt underline decoration-cobalt/30 underline-offset-4 hover:decoration-cobalt" href={signal.source} target="_blank" rel="noreferrer">{signal.sourceLabel} ↗</a>
        </article>
      ))}
      {photoSrc && <figure class="evidence-band-photo">
        <AssetImage src={photoSrc} alt={photoAlt} width={1536} height={1024} loading="lazy" decoding="async" class="w-full object-cover" />
        {photoCaption && <figcaption>{photoCaption}</figcaption>}
      </figure>}
    </div>
  </div>
</section>

<style>
  .evidence-band-intro {
    padding-bottom: clamp(2rem, 3.5vw, 3.5rem);
  }

  .evidence-band-grid {
    display: grid;
    gap: 1px;
    border: 1px solid var(--color-line);
    background: var(--color-line);
  }

  .evidence-band-grid > article {
    min-width: 0;
  }

  .evidence-band-photo {
    display: flex;
    min-width: 0;
    min-height: 18rem;
    flex-direction: column;
    margin: 0;
    overflow: hidden;
    background: white;
  }

  :global(.evidence-band-photo img) {
    display: block;
    min-height: 0;
    flex: 1 1 auto;
    aspect-ratio: auto;
    object-fit: cover;
    object-position: 50% 50%;
  }

  .evidence-band-photo figcaption {
    flex: 0 0 auto;
    padding: 0.7rem 0.85rem;
    color: var(--color-muted);
    font-size: 0.68rem;
    line-height: 1.45;
  }

  @media (min-width: 768px) {
    .evidence-band-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1280px) {
    .evidence-band-grid-with-photo {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    .evidence-band-photo {
      min-height: 100%;
    }
  }
</style>
