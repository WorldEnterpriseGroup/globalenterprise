---
import { footerColumns, site } from "@/data/site";
---

<footer class="border-t border-line bg-ink text-white">
  <div class="container-site section-pad grid gap-14 lg:grid-cols-[1.5fr_1fr_1fr]">
    <div>
      <a class="mb-7 flex items-center gap-3" href="/" aria-label={`${site.name} home`}>
        <span class="grid size-9 place-items-center bg-lime text-lg font-bold text-ink">GE</span>
        <span class="font-display text-lg font-bold uppercase tracking-[-0.04em]">Global <span class="text-lime">Enterprise</span></span>
      </a>
      <p class="max-w-sm text-lg leading-relaxed text-white/65">Where intelligence meets the institution, the work has to hold.</p>
      <a class="mt-8 inline-flex text-sm font-bold text-lime underline decoration-lime/40 underline-offset-4 hover:decoration-lime" href={`mailto:${site.email}`}>{site.email}</a>
    </div>
    {footerColumns.map((column) => (
      <div>
        <p class="mb-5 text-xs font-bold uppercase tracking-[0.16em] text-white/45">{column.title}</p>
        <ul class="space-y-3">
          {column.links.map((link) => <li><a class="text-white/80 transition-colors hover:text-lime" href={link.href}>{link.label}</a></li>)}
        </ul>
      </div>
    ))}
  </div>
  <div class="container-site flex flex-col gap-4 border-t border-white/15 py-6 text-xs text-white/45 sm:flex-row sm:items-center sm:justify-between">
    <p>© {new Date().getFullYear()} Global Enterprise. Built for what comes next.</p>
    <div class="flex gap-5"><a class="hover:text-lime" href="/privacy/">Privacy</a><a class="hover:text-lime" href="/terms/">Terms</a>{site.social.linkedin && <a class="hover:text-lime" href={site.social.linkedin} rel="me">LinkedIn ↗</a>}</div>
  </div>
</footer>
