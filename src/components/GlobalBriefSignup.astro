---
import { site } from "@/data/site";

interface Props {
  dark?: boolean;
}

const { dark = true } = Astro.props;
---

<section class:list={["global-brief", dark ? "global-brief-dark" : ""]}>
  <div class="container-site grid gap-10 lg:grid-cols-[.9fr_1.1fr] lg:items-end lg:gap-20">
    <div>
      <p class="eyebrow text-lime">The Global Brief</p>
      <h2 class="mt-5 max-w-3xl font-display text-4xl font-medium tracking-[-0.05em] md:text-5xl">One standard. Translated for the system in front of you.</h2>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-white/65">A substantial field guide for leaders coordinating AI, infrastructure, data, and capability across regions, partners, and time zones—with a translation framework, context lens, management artifacts, worksheet, source notes, and explicit limitations.</p>
      <ul class="mt-7 grid gap-3 text-sm text-white/65 sm:grid-cols-3 lg:grid-cols-1">
        <li><span class="text-lime">01</span> A cross-border decision frame and context lens</li>
        <li><span class="text-lime">02</span> Management artifacts for local adaptation</li>
        <li><span class="text-lime">03</span> A worksheet, source notes, and practical first move</li>
      </ul>
    </div>
    <form class="global-brief-form" action={site.briefEndpoint || site.formEndpoint} method="POST" data-lead-form data-form-kind="global_brief" aria-describedby="global-brief-form-notice">
      <input type="hidden" name="_subject" value="Request the Global Brief" />
      <input type="hidden" name="_next" value={`${site.url}/insights/thanks/?source=global-brief`} />
      <input type="hidden" name="_template" value="table" />
      <input type="hidden" name="report" value="global-operating-model-brief" />
      <input type="hidden" name="form_kind" value="global_brief" />
      <input type="hidden" name="source_url" value={`${site.url}/`} />
      <input type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true" class="absolute -left-[9999px] h-px w-px overflow-hidden" />
      <p id="global-brief-form-notice" class="form-notice">{site.publicFormNotice} The required fields are enough to request the guide; the optional fields help us route a relevant follow-up.</p>
      <fieldset>
        <legend>Delivery details</legend>
        <div class="grid gap-6 sm:grid-cols-2">
          <label class="field-label" for="global-brief-name">Name <span class="required-note">Required</span>
            <input id="global-brief-name" type="text" name="name" autocomplete="name" placeholder="Your name" required />
          </label>
          <label class="field-label" for="global-brief-email">Work email <span class="required-note">Required</span>
            <input id="global-brief-email" type="email" name="email" autocomplete="email" placeholder="name@organization.com" required />
          </label>
          <label class="field-label" for="global-brief-organization">Organization <span class="required-note">Required</span>
            <input id="global-brief-organization" type="text" name="organization" autocomplete="organization" placeholder="Organization name" required />
          </label>
          <label class="field-label" for="global-brief-context">Primary context <span class="required-note">Required</span>
            <select id="global-brief-context" name="context" required>
              <option value="" selected disabled>Choose a lens</option>
              <option>North America</option>
              <option>Europe</option>
              <option>Middle East & Africa</option>
              <option>Asia-Pacific</option>
              <option>Latin America & the Caribbean</option>
              <option>Cross-border / multi-region</option>
            </select>
          </label>
        </div>
      </fieldset>
      <fieldset aria-describedby="global-brief-routing-help">
        <legend>Decision context</legend>
        <p id="global-brief-routing-help" class="form-helper">These short choices help us understand the decision context without asking for sensitive operating details. The planning horizon is optional.</p>
        <div class="grid gap-6 sm:grid-cols-2">
          <label class="field-label" for="global-brief-role">Role in the work <span class="required-note">Required</span>
            <select id="global-brief-role" name="role" required>
              <option value="" selected disabled>Choose a role</option>
              <option>Executive leadership</option>
              <option>Operations or transformation</option>
              <option>Technology, data, or security</option>
              <option>Policy, strategy, or research</option>
              <option>Other / cross-functional</option>
            </select>
          </label>
          <label class="field-label" for="global-brief-stage">Decision stage <span class="required-note">Required</span>
            <select id="global-brief-stage" name="decision_stage" required>
              <option value="" selected disabled>Choose a stage</option>
              <option>Building the case</option>
              <option>Comparing approaches</option>
              <option>Planning a transition</option>
              <option>Operating and learning</option>
            </select>
          </label>
        </div>
      </fieldset>
      <fieldset class="contact-preferences">
        <legend>Contact preferences</legend>
        <label class="checkbox-label" for="global-brief-consent">
          <input id="global-brief-consent" class="mt-1 size-4 shrink-0 accent-cobalt" type="checkbox" name="consent" value="yes" required />
          <span>I agree to receive the requested Global Brief and be contacted about it. I understand this public form is not for sensitive information. <span class="required-note">Required</span></span>
        </label>
        <label class="checkbox-label" for="global-brief-signal-opt-in">
          <input id="global-brief-signal-opt-in" class="mt-1 size-4 shrink-0 accent-cobalt" type="checkbox" name="signal_opt_in" value="yes" />
          <span>Also send me occasional evidence-led notes. I can unsubscribe at any time. <span class="optional-note">Optional</span></span>
        </label>
      </fieldset>
      <button class="btn-primary mt-7" type="submit" data-track="global_brief_submit">Send me the field guide <span aria-hidden="true">↗</span></button>
    </form>
  </div>
</section>

<style>
  .global-brief { padding-block: clamp(4rem, 8vw, 7.5rem); background: var(--color-cobalt); color: white; }
  .global-brief-dark { background: var(--color-ink); }
  .global-brief-form { padding: clamp(1.5rem, 4vw, 3rem); border: 1px solid rgb(255 255 255 / 16%); background: rgb(255 255 255 / 6%); }
  .global-brief-form fieldset { min-width: 0; margin: 0; padding: 0; border: 0; }
  .global-brief-form fieldset + fieldset { margin-top: 1.75rem; padding-top: 1.5rem; border-top: 1px solid rgb(255 255 255 / 16%); }
  .global-brief-form legend { color: rgb(255 255 255 / 88%); font-size: 0.72rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; }
  .global-brief-form .field-label { display: grid; gap: 0.55rem; color: rgb(255 255 255 / 74%); font-size: 0.76rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
  .global-brief-form .required-note, .global-brief-form .optional-note { margin-left: 0.35rem; color: var(--color-lime); font-size: 0.63rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
  .global-brief-form .optional-note { color: rgb(255 255 255 / 48%); }
  .global-brief-form .form-notice, .global-brief-form .form-helper { max-width: 48rem; color: rgb(255 255 255 / 62%); font-size: 0.78rem; line-height: 1.55; }
  .global-brief-form .form-notice { margin-bottom: 1.75rem; padding-left: 0.85rem; border-left: 2px solid var(--color-lime); }
  .global-brief-form .form-helper { margin-top: 0.65rem; margin-bottom: 1.25rem; }
  .global-brief-form input:not([type="checkbox"]), .global-brief-form select { width: 100%; min-height: 3.35rem; border: 0; border-bottom: 1px solid rgb(255 255 255 / 32%); border-radius: 0; background: transparent; color: white; font-size: 1rem; font-weight: 400; letter-spacing: normal; outline: none; text-transform: none; }
  .global-brief-form select { color-scheme: dark; }
  .global-brief-form input:focus, .global-brief-form select:focus { border-color: var(--color-lime); }
  .global-brief-form input:focus-visible, .global-brief-form select:focus-visible, .global-brief-form button:focus-visible {
    outline: 3px solid var(--color-lime);
    outline-offset: 4px;
  }
  .global-brief-form option { color: var(--color-ink); }
  .global-brief-form .checkbox-label { display: flex; align-items: flex-start; gap: 0.75rem; margin-top: 1rem; color: rgb(255 255 255 / 66%); font-size: 0.82rem; font-weight: 400; letter-spacing: normal; line-height: 1.55; text-transform: none; }
  .global-brief-form .checkbox-label:first-of-type { margin-top: 1.15rem; }
  .global-brief li { display: flex; gap: 0.65rem; }
  .global-brief li span { flex: 0 0 auto; font-family: var(--font-display); }
</style>
