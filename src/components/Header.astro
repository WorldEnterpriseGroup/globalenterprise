---
import { navigationPanel, site } from "@/data/site";

const currentPath = Astro.url.pathname;
const isHome = currentPath === "/";
const linkTone = isHome ? "text-white/85 hover:text-white" : "text-ink/80 hover:text-cobalt";
const panelTone = isHome ? "mega-panel-home" : "";
---

<header class:list={["fixed top-0 z-[70] w-full", isHome ? "bg-ink/90 text-white backdrop-blur-md" : "border-b border-line/80 bg-paper/95 text-ink backdrop-blur-xl"]} data-site-header>
  <div class="container-site flex min-h-[5.3rem] items-center justify-between gap-6">
    <a class="group flex items-center gap-3" href="/" aria-label={`${site.name} home`}>
      <span class="grid size-9 place-items-center bg-cobalt text-lg font-bold text-white transition-transform group-hover:rotate-12">GE</span>
      <span class="font-display text-lg font-medium tracking-[-0.03em]">Global <span class={isHome ? "text-lime" : "text-cobalt"}>Enterprise</span></span>
    </a>

    <button class:list={["grid size-11 place-items-center rounded-full border md:hidden", isHome ? "border-white/40 text-white" : "border-line text-ink"]} type="button" aria-expanded="false" aria-controls="site-navigation" aria-label="Open navigation" data-menu-toggle>
      <span class="sr-only" data-menu-label>Open navigation</span>
      <span class="flex w-5 flex-col gap-1.5" aria-hidden="true"><i class="block h-px w-full bg-current"></i><i class="block h-px w-3/4 bg-current"></i><i class="block h-px w-full bg-current"></i></span>
    </button>

    <nav id="site-navigation" aria-label="Primary navigation" class:list={["absolute left-0 top-full hidden w-full px-5 py-5 md:static md:block md:w-auto md:border-0 md:bg-transparent md:p-0", isHome ? "border-b border-white/20 bg-ink" : "border-b border-line bg-paper"]} data-navigation>
      <ul class="flex flex-col gap-2 md:flex-row md:items-center md:gap-6">
        <li>
          <button class:list={["flex w-full cursor-pointer items-center gap-2 py-2 text-left text-sm transition-colors md:w-auto", linkTone]} type="button" aria-expanded="false" aria-haspopup="true" aria-controls="mega-navigation" data-mega-toggle>
            Explore <span class="text-xs transition-transform" data-mega-chevron>⌄</span>
          </button>
        </li>
        <li><a class:list={["block py-2 text-sm transition-colors", linkTone, currentPath.startsWith("/about") ? "text-cobalt" : ""]} href="/about/" aria-current={currentPath.startsWith("/about") ? "page" : undefined}>Approach</a></li>
        <li class="relative">
          <button class:list={["flex w-full cursor-pointer items-center gap-2 py-2 text-left text-sm transition-colors md:w-auto", linkTone, currentPath.startsWith("/industries") ? "text-cobalt" : ""]} type="button" aria-expanded="false" aria-haspopup="true" aria-controls="industry-dropdown" data-industry-toggle>
            Industries <span class="text-xs transition-transform" data-industry-chevron>⌄</span>
          </button>
          <div id="industry-dropdown" class="industry-dropdown" data-industry-dropdown data-state="closed" aria-hidden="true">
            <a class="industry-dropdown-all" href="/industries/">All industries <span aria-hidden="true">↗</span></a>
            {navigationPanel.industries.map((item) => <a href={item.href}><span>{item.title}</span><small>{item.signal}</small></a>)}
          </div>
        </li>
        <li><a class:list={["block py-2 text-sm transition-colors", linkTone, currentPath.startsWith("/case-studies") ? "text-cobalt" : ""]} href="/case-studies/" aria-current={currentPath.startsWith("/case-studies") ? "page" : undefined}>Work</a></li>
        <li><a class:list={["block py-2 text-sm transition-colors", linkTone, currentPath.startsWith("/insights") ? "text-cobalt" : ""]} href="/insights/" aria-current={currentPath.startsWith("/insights") ? "page" : undefined}>Insights</a></li>
        <li><a class:list={["block py-2 text-sm transition-colors", linkTone, currentPath.startsWith("/resources") ? "text-cobalt" : ""]} href="/resources/" aria-current={currentPath.startsWith("/resources") ? "page" : undefined}>Resources</a></li>
        <li class="pt-3 md:pt-0"><a class:list={["btn-primary w-full md:w-auto", isHome ? "bg-white text-ink" : ""]} href="/contact/">Principal dialogue <span aria-hidden="true">↗</span></a></li>
      </ul>

      <div class="mt-7 border-t border-white/15 pt-6 md:hidden" data-mobile-directory>
        <p class="mega-kicker">Capabilities</p>
        <div class="mt-3 grid gap-1">
          <a class="mobile-mega-link" href="/services/">All capabilities</a>
          {navigationPanel.capabilities.map((item) => <a class="mobile-mega-link" href={item.href}>{item.title}</a>)}
        </div>
        <p class="mega-kicker mt-7">Industries</p>
        <div class="mt-3 grid grid-cols-2 gap-1">
          {navigationPanel.industries.map((item) => <a class="mobile-mega-link" href={item.href}>{item.title}</a>)}
        </div>
        <p class="mega-kicker mt-7">Explore & company</p>
        <div class="mt-3 grid grid-cols-2 gap-1">
          {[...navigationPanel.explore, ...navigationPanel.company].map((item) => <a class="mobile-mega-link" href={item.href}>{item.label}</a>)}
        </div>
      </div>
    </nav>
  </div>

  <div id="mega-navigation" class:list={["mega-panel", panelTone]} data-mega-panel data-state="closed" aria-hidden="true">
    <div class="container-site grid gap-9 py-9 lg:grid-cols-[.72fr_1.28fr_.72fr] lg:gap-10 lg:py-10">
      <div>
        <p class="mega-kicker">Navigate the system</p>
        <div class="mt-4 divide-y divide-line/70 border-y border-line/70">
          {navigationPanel.explore.map((item) => <a class="mega-directory-link" href={item.href}><span><strong>{item.label}</strong><small>{item.description}</small></span><span aria-hidden="true">↗</span></a>)}
        </div>
        <p class="mega-kicker mt-8">Company</p>
        <div class="mt-3 grid grid-cols-2 gap-x-5 gap-y-2">
          {navigationPanel.company.map((item) => <a class="mega-plain-link" href={item.href}>{item.label}<span aria-hidden="true">↗</span></a>)}
        </div>
      </div>

      <div class="lg:border-l lg:border-line lg:pl-9">
        <div class="flex items-end justify-between gap-4"><div><p class="mega-kicker">Capabilities</p><p class="mt-2 text-sm text-muted">The disciplines we bring together when the problem crosses boundaries.</p></div><a class="mega-view-all" href="/services/">View all ↗</a></div>
        <div class="mt-5 grid gap-x-7 gap-y-2 sm:grid-cols-2">
          {navigationPanel.capabilities.map((item) => <a class="mega-service" href={item.href}><span class="mega-icon" aria-hidden="true">{item.number}</span><span><strong>{item.title}</strong><small>{item.short}</small></span></a>)}
        </div>
        <p class="mega-kicker mt-8">Industries</p>
        <div class="mt-3 grid grid-cols-2 gap-x-5 gap-y-2">
          {navigationPanel.industries.map((item) => <a class="mega-plain-link" href={item.href}>{item.title}<span aria-hidden="true">↗</span></a>)}
        </div>
      </div>

      <aside class="mega-feature">
        <p class="mega-kicker text-cobalt">{navigationPanel.feature.label}</p>
        <p class="mega-quote-mark" aria-hidden="true">“</p>
        <h2 class="mt-2 font-display text-3xl font-medium leading-tight tracking-[-0.05em]">{navigationPanel.feature.title}</h2>
        <p class="mt-4 text-sm leading-relaxed text-muted">{navigationPanel.feature.description}</p>
        <a class="ink-link mt-6" href={navigationPanel.feature.href}>Read the perspective <span aria-hidden="true"></span></a>
      </aside>
    </div>
  </div>
</header>

<script>
  const initializeHeader = () => {
    const header = document.querySelector("[data-site-header]");
    const menuToggle = header?.querySelector<HTMLButtonElement>("[data-menu-toggle]");
    const navigation = header?.querySelector("[data-navigation]");
    const megaToggle = header?.querySelector("[data-mega-toggle]");
    const megaPanel = header?.querySelector("[data-mega-panel]");
    const megaChevron = header?.querySelector("[data-mega-chevron]");
    const industryToggle = header?.querySelector("[data-industry-toggle]");
    const industryDropdown = header?.querySelector("[data-industry-dropdown]");
    const industryChevron = header?.querySelector("[data-industry-chevron]");
    const menuLabel = header?.querySelector("[data-menu-label]");

    if (!header || header.hasAttribute("data-header-bound")) return;
    header.setAttribute("data-header-bound", "true");

    const setMega = (open: boolean) => {
      megaToggle?.setAttribute("aria-expanded", String(open));
      megaPanel?.setAttribute("aria-hidden", String(!open));
      megaPanel?.setAttribute("data-state", open ? "open" : "closed");
      megaPanel?.classList.toggle("is-open", open);
      megaChevron?.classList.toggle("rotate-180", open);
    };

    const setIndustries = (open: boolean) => {
      industryToggle?.setAttribute("aria-expanded", String(open));
      industryDropdown?.setAttribute("aria-hidden", String(!open));
      industryDropdown?.setAttribute("data-state", open ? "open" : "closed");
      industryChevron?.classList.toggle("rotate-180", open);
    };

    menuToggle?.addEventListener("click", () => {
      const isOpen = menuToggle.getAttribute("aria-expanded") === "true";
      menuToggle.setAttribute("aria-expanded", String(!isOpen));
      menuToggle.setAttribute("aria-label", isOpen ? "Open navigation" : "Close navigation");
      menuLabel && (menuLabel.textContent = isOpen ? "Open navigation" : "Close navigation");
      navigation?.classList.toggle("hidden", isOpen);
      if (isOpen) setMega(false);
      if (!isOpen) navigation?.querySelector<HTMLElement>("a, button")?.focus();
    });

    megaToggle?.addEventListener("click", () => { setIndustries(false); setMega(megaPanel?.getAttribute("data-state") !== "open"); });
    industryToggle?.addEventListener("click", () => { setMega(false); setIndustries(industryDropdown?.getAttribute("data-state") !== "open"); });
    document.addEventListener("click", (event) => {
      if (megaPanel?.getAttribute("data-state") === "open" && !(event.target instanceof Node && header.contains(event.target))) setMega(false);
      if (industryDropdown?.getAttribute("data-state") === "open" && !(event.target instanceof Node && header.contains(event.target))) setIndustries(false);
    });
    navigation?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => {
      if (window.innerWidth < 768) {
        menuToggle?.setAttribute("aria-expanded", "false");
        menuToggle?.setAttribute("aria-label", "Open navigation");
        if (menuLabel) menuLabel.textContent = "Open navigation";
        navigation.classList.add("hidden");
      }
    }));
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        setMega(false);
        setIndustries(false);
        if (menuToggle?.getAttribute("aria-expanded") === "true") {
          menuToggle.setAttribute("aria-expanded", "false");
          menuToggle.setAttribute("aria-label", "Open navigation");
          if (menuLabel) menuLabel.textContent = "Open navigation";
          navigation?.classList.add("hidden");
          menuToggle.focus();
        }
      }
    });
  };

  initializeHeader();
  document.addEventListener("astro:page-load", initializeHeader);
</script>
