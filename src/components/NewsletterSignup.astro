---
import { site } from "@/data/site";

interface Props {
  dark?: boolean;
}

const { dark = false } = Astro.props;
---

<section class:list={["newsletter-signup", dark ? "newsletter-signup-dark" : ""]}>
  <div class="container-site grid gap-8 lg:grid-cols-[1fr_.9fr] lg:items-end">
    <div>
      <p class="eyebrow">The Signal</p>
      <h2 class="mt-5 font-display text-3xl font-medium tracking-[-0.05em] md:text-4xl">A short note for the next decision.</h2>
      <p class="mt-4 max-w-2xl leading-relaxed text-muted">Occasional evidence-led perspectives on operating models, enterprise AI, modernization, and the work of making change useful.</p>
    </div>
    <form class="grid gap-4" action={site.formEndpoint} method="POST" data-lead-form data-form-kind="signal" aria-describedby="signal-form-errors">
      <input type="hidden" name="_subject" value="Subscribe to The Signal" />
      <input type="hidden" name="_next" value={`${site.url}/insights/thanks/`} />
      <input type="hidden" name="_template" value="table" />
      <input type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true" class="absolute -left-[9999px] h-px w-px overflow-hidden" />
      <div id="signal-form-errors" class="form-error-summary" data-form-summary role="alert" aria-live="assertive" tabindex="-1" hidden></div>
      <label class="sr-only" for="signal-email">Work email</label>
      <div class="flex flex-col gap-3 sm:flex-row">
        <input id="signal-email" class="min-h-[3.25rem] min-w-0 flex-1 border border-line bg-white px-5 text-base outline-none transition-colors focus:border-cobalt" type="email" name="email" autocomplete="email" placeholder="Work email" required aria-required="true" aria-invalid="false" />
        <button class="btn-dark shrink-0" type="submit" data-track="newsletter_submit">Request The Signal <span aria-hidden="true">↗</span></button>
      </div>
      <label class="flex items-start gap-3 text-xs text-muted" for="signal-consent"><input id="signal-consent" class="mt-0.5 size-4 accent-cobalt" type="checkbox" name="consent" value="yes" required aria-required="true" aria-invalid="false" />I agree to receive occasional notes. The public form routes the request for review; I can unsubscribe at any time.</label>
    </form>
  </div>
</section>

<style>
  .newsletter-signup .form-error-summary, .newsletter-signup .form-field-error { display: block; margin-top: 0.45rem; color: var(--color-cobalt); font-size: 0.78rem; line-height: 1.5; }
  .newsletter-signup .form-error-summary { margin-bottom: 0.25rem; padding-left: 0.75rem; border-left: 2px solid var(--color-cobalt); }
  .newsletter-signup .form-error-summary[hidden], .newsletter-signup .form-field-error[hidden] { display: none; }
  .newsletter-signup [aria-invalid="true"] { border-color: var(--color-cobalt); }
</style>
