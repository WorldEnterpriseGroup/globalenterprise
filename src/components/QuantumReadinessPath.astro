---
interface ReadinessStep {
  label: string;
  title: string;
  text: string;
  artifact: string;
}

const id = "solution-quantum-intelligence-readiness";
const steps: ReadinessStep[] = [
  {
    label: "Frame",
    title: "Name the strategic question",
    text: "Define the decision, horizon, constraints, and evidence that would make frontier work relevant to the client environment.",
    artifact: "Question brief",
  },
  {
    label: "Sense",
    title: "Separate signal from possibility",
    text: "Map the research signal, sensing input, optimization problem, and uncertainty before selecting a technical path.",
    artifact: "Signal map",
  },
  {
    label: "Test",
    title: "Design a bounded experiment",
    text: "Evaluate feasibility, economics, data access, security, and operating readiness together with a reversible test boundary.",
    artifact: "Experiment boundary",
  },
  {
    label: "Decide",
    title: "Carry learning into the portfolio",
    text: "Turn the evidence into a governed choice: continue, reshape, pause, or prepare for a later capability threshold.",
    artifact: "Decision record",
  },
];

const lenses = [
  { label: "Strategic fit", text: "Which decision becomes clearer or more valuable if the capability matures?" },
  { label: "Readiness", text: "Can the client environment supply the data, talent, controls, and operating attention required?" },
  { label: "Reversibility", text: "What can be learned without committing the institution to an irreversible platform or promise?" },
];
---

<section class="quantum-readiness" data-diagram-id={id} aria-labelledby={`${id}-heading`}>
  <header class="quantum-readiness-header">
    <div>
      <p class="eyebrow text-cobalt">Quantum readiness path · research to decision</p>
      <h2 id={`${id}-heading`} class="mt-5 max-w-3xl font-display text-3xl font-medium tracking-[-0.05em] md:text-5xl">Prepare before the capability becomes ordinary.</h2>
      <p class="mt-5 max-w-2xl text-sm leading-relaxed text-muted">Frontier intelligence earns a place in strategy when the question, evidence boundary, and operating consequence are explicit. This path keeps readiness ahead of hype.</p>
    </div>
    <div class="quantum-readiness-index" aria-label="Quantum readiness path"><span>Q</span><small>research<br />to decision</small></div>
  </header>

  <div class="quantum-readiness-track" aria-label="Quantum readiness sequence">
    <ol class="quantum-readiness-steps">
      {steps.map((step) => (
        <li class="quantum-readiness-step">
          <div class="quantum-readiness-step-mark"><strong>{step.label}</strong></div>
          <div>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </div>
          <p class="quantum-readiness-artifact"><span>Leave with</span>{step.artifact}</p>
        </li>
      ))}
    </ol>
  </div>

  <div class="quantum-readiness-footer">
    <div>
      <p class="eyebrow text-cobalt">Readiness lenses</p>
      <ul class="quantum-readiness-lenses">
        {lenses.map((lens) => <li><strong>{lens.label}</strong><span>{lens.text}</span></li>)}
      </ul>
    </div>
    <aside class="quantum-readiness-note">
      <p class="eyebrow text-cobalt">Platform context</p>
      <p>We evaluate, design, and operate client environments with the constraints in view. Relevant quantum ecosystems may include IBM Quantum, AWS/Amazon Braket, Google Quantum AI/Cirq, and Azure Quantum; the route depends on the question, data boundary, access model, and control requirements.</p>
      <p class="quantum-readiness-disclaimer">These names describe an evaluation landscape, not a partner, certification, or endorsement claim.</p>
    </aside>
  </div>
</section>

<style>
  .quantum-readiness {
    border: 1px solid var(--color-line);
    background: #fff;
    padding: clamp(1.25rem, 4vw, 3rem);
  }

  .quantum-readiness-header,
  .quantum-readiness-footer {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: 2rem;
  }

  .quantum-readiness-header {
    border-bottom: 1px solid var(--color-line);
    padding-bottom: 1.6rem;
  }

  .quantum-readiness-index {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    border-left: 2px solid var(--color-accent);
    padding-left: 0.9rem;
    color: var(--color-cobalt);
  }

  .quantum-readiness-index span {
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 6vw, 5rem);
    font-weight: 500;
    letter-spacing: -0.08em;
    line-height: 0.8;
  }

  .quantum-readiness-index small {
    color: var(--color-muted);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1.25;
    text-transform: uppercase;
  }

  .quantum-readiness-track {
    position: relative;
    margin-top: 1.6rem;
    overflow: hidden;
    background: #f7f8fb;
  }

  .quantum-readiness-track::before {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 4.2rem;
    width: 1px;
    background: color-mix(in srgb, var(--color-cobalt) 30%, transparent);
    content: "";
  }

  .quantum-readiness-steps {
    position: relative;
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .quantum-readiness-step {
    display: grid;
    grid-template-columns: 8.4rem minmax(0, 1fr) minmax(10rem, 14rem);
    gap: 1.25rem;
    align-items: center;
    min-height: 8.2rem;
    border-bottom: 1px solid var(--color-line);
    padding: 1.3rem 1.25rem;
  }

  .quantum-readiness-step:last-child {
    border-bottom: 0;
  }

  .quantum-readiness-step-mark {
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .quantum-readiness-step-mark span {
    position: relative;
    z-index: 1;
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid var(--color-cobalt);
    border-radius: 999px;
    background: #f7f8fb;
    color: var(--color-cobalt);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .quantum-readiness-step-mark strong {
    color: var(--color-cobalt);
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .quantum-readiness-step h3 {
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2vw, 1.9rem);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1.05;
  }

  .quantum-readiness-step h3 + p {
    max-width: 46rem;
    margin-top: 0.55rem;
    color: var(--color-muted);
    font-size: 0.82rem;
    line-height: 1.55;
  }

  .quantum-readiness-artifact {
    border-left: 2px solid var(--color-accent);
    padding-left: 0.85rem;
    color: var(--color-ink);
    font-size: 0.78rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .quantum-readiness-artifact span {
    display: block;
    margin-bottom: 0.3rem;
    color: var(--color-muted);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .quantum-readiness-footer {
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 0.65fr);
    margin-top: 1.6rem;
    border-top: 1px solid var(--color-line);
    padding-top: 1.4rem;
  }

  .quantum-readiness-lenses {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .quantum-readiness-lenses li {
    display: grid;
    gap: 0.45rem;
    border-top: 2px solid var(--color-cobalt);
    padding-top: 0.7rem;
  }

  .quantum-readiness-lenses strong {
    color: var(--color-ink);
    font-size: 0.8rem;
  }

  .quantum-readiness-lenses span,
  .quantum-readiness-note p:not(.eyebrow) {
    color: var(--color-muted);
    font-size: 0.76rem;
    line-height: 1.5;
  }

  .quantum-readiness-note {
    border-left: 1px solid var(--color-line);
    padding-left: 1.4rem;
  }

  .quantum-readiness-note .eyebrow {
    margin-bottom: 0.8rem;
  }

  .quantum-readiness-disclaimer {
    margin-top: 0.65rem;
    font-size: 0.66rem !important;
    font-style: italic;
  }

  @media (max-width: 760px) {
    .quantum-readiness-header,
    .quantum-readiness-footer {
      grid-template-columns: 1fr;
    }

    .quantum-readiness-index {
      justify-self: start;
    }

    .quantum-readiness-track::before {
      left: 2.55rem;
    }

    .quantum-readiness-step {
      grid-template-columns: 1fr;
      gap: 0.8rem;
      padding: 1.25rem 1rem 1.3rem;
    }

    .quantum-readiness-step-mark {
      margin-left: -0.2rem;
    }

    .quantum-readiness-artifact {
      margin-left: 3.3rem;
    }

    .quantum-readiness-lenses {
      grid-template-columns: 1fr;
    }

    .quantum-readiness-note {
      border-top: 1px solid var(--color-line);
      border-left: 0;
      padding-top: 1.25rem;
      padding-left: 0;
    }
  }
</style>
