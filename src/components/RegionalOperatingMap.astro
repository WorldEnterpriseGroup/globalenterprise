---
const regionalNodes = [
  { short: "NA", name: "North America", slug: "na", className: "regional-map-node-na" },
  { short: "EU", name: "Europe", slug: "eu", className: "regional-map-node-eu" },
  { short: "MEA", name: "Middle East & Africa", slug: "mea", className: "regional-map-node-mea" },
  { short: "APAC", name: "Asia-Pacific", slug: "asia", className: "regional-map-node-asia" },
  { short: "LATAM", name: "Latin America & Caribbean", slug: "latam", className: "regional-map-node-latam" },
  { short: "SA", name: "South America", slug: "sa", className: "regional-map-node-sa" },
];
---

<figure class="regional-operating-map" data-diagram-id="home-regional-operating-map">
  <div class="regional-map-canvas">
    <svg class="regional-map-lines" viewBox="0 0 800 500" preserveAspectRatio="none" aria-hidden="true">
      <path d="M400 250 L132 92 M400 250 L668 92 M400 250 L92 250 M400 250 L708 250 M400 250 L132 408 M400 250 L668 408" />
      <circle cx="400" cy="250" r="76" />
    </svg>
    <div class="regional-map-center">
      <span class="regional-map-center-index">00</span>
      <strong>One operating standard</strong>
      <span>Translate · coordinate · adapt · transfer</span>
    </div>
    {regionalNodes.map((node, index) => (
      <a class:list={["regional-map-node", node.className]} href={`/region/${node.slug}/`}>
        <span class="regional-map-node-index">0{index + 1}</span>
        <strong>{node.short}</strong>
        <span>{node.name}</span>
      </a>
    ))}
  </div>
  <figcaption><strong>One standard. Six mechanisms.</strong> Each regional context changes the path between mandate, infrastructure, capability, and service outcome. The diagram is a strategic lens, not a physical office map.</figcaption>
</figure>

<style>
  .regional-operating-map { min-width: 0; margin: 0; padding: clamp(1rem, 2vw, 1.5rem); border: 1px solid rgb(255 255 255 / 18%); background: linear-gradient(145deg, color-mix(in srgb, var(--color-cobalt) 70%, var(--color-ink)), var(--color-ink)); color: white; box-shadow: 0.85rem 0.85rem 0 color-mix(in srgb, var(--color-cobalt) 18%, transparent); }
  .regional-map-canvas { position: relative; min-height: 20rem; overflow: hidden; border: 1px solid rgb(255 255 255 / 15%); background: radial-gradient(circle at 50% 50%, rgb(95 145 197 / 24%), transparent 33%), linear-gradient(135deg, rgb(255 255 255 / 5%), transparent 58%); }
  .regional-map-lines { position: absolute; inset: 0; width: 100%; height: 100%; }
  .regional-map-lines path, .regional-map-lines circle { fill: none; stroke: rgb(199 244 94 / 58%); stroke-width: 1.25; stroke-dasharray: 4 7; vector-effect: non-scaling-stroke; }
  .regional-map-lines circle { stroke: rgb(255 255 255 / 18%); stroke-dasharray: none; }
  .regional-map-center, .regional-map-node { position: absolute; display: grid; align-content: center; min-width: 0; border: 1px solid rgb(255 255 255 / 24%); background: rgb(15 18 27 / 86%); color: white; text-decoration: none; }
  .regional-map-center { top: 50%; left: 50%; width: 10.5rem; height: 10.5rem; padding: 1.2rem; border-color: var(--color-accent); border-radius: 50%; transform: translate(-50%, -50%); text-align: center; box-shadow: 0 0 0 0.7rem rgb(199 244 94 / 9%), 0 1rem 2rem rgb(0 0 0 / 24%); }
  .regional-map-center-index, .regional-map-node-index { color: var(--color-accent); font-family: var(--font-display); font-size: 0.75rem; }
  .regional-map-center strong { margin-top: 0.75rem; font-family: var(--font-display); font-size: 1.1rem; font-weight: 500; letter-spacing: -0.03em; line-height: 1.05; }
  .regional-map-center > span:last-child { margin-top: 0.6rem; color: rgb(255 255 255 / 60%); font-size: 0.58rem; line-height: 1.35; }
  .regional-map-node { width: 8rem; min-height: 4.7rem; padding: 0.75rem; transition: background-color 180ms ease, border-color 180ms ease, transform 180ms ease; }
  .regional-map-node strong { margin-top: 0.35rem; color: var(--color-accent); font-family: var(--font-display); font-size: 1.45rem; font-weight: 500; letter-spacing: -0.04em; line-height: 1; }
  .regional-map-node > span:last-child { margin-top: 0.35rem; color: rgb(255 255 255 / 68%); font-size: 0.62rem; line-height: 1.2; }
  .regional-map-node:hover, .regional-map-node:focus-visible { border-color: var(--color-accent); background: var(--color-cobalt); transform: translateY(-0.2rem); }
  .regional-map-node-na { top: 1rem; left: 1rem; }
  .regional-map-node-eu { top: 1rem; right: 1rem; }
  .regional-map-node-mea { top: 50%; left: 1rem; transform: translateY(-50%); }
  .regional-map-node-mea:hover, .regional-map-node-mea:focus-visible { transform: translateY(calc(-50% - 0.2rem)); }
  .regional-map-node-asia { top: 50%; right: 1rem; transform: translateY(-50%); }
  .regional-map-node-asia:hover, .regional-map-node-asia:focus-visible { transform: translateY(calc(-50% - 0.2rem)); }
  .regional-map-node-latam { bottom: 1rem; left: 1rem; }
  .regional-map-node-sa { right: 1rem; bottom: 1rem; }
  .regional-operating-map figcaption { margin-top: 0.9rem; color: rgb(255 255 255 / 62%); font-size: 0.7rem; line-height: 1.55; }
  .regional-operating-map figcaption strong { color: white; }
  @media (max-width: 640px) {
    .regional-map-canvas { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.5rem; min-height: 0; padding: 0.65rem; }
    .regional-map-lines { display: none; }
    .regional-map-center, .regional-map-node { position: static; transform: none; }
    .regional-map-center { grid-column: 1 / -1; grid-row: 1; width: auto; height: auto; min-height: 7rem; border-radius: 0.5rem; }
    .regional-map-node { width: auto; min-height: 4.7rem; }
    .regional-map-node-mea:hover, .regional-map-node-mea:focus-visible, .regional-map-node-asia:hover, .regional-map-node-asia:focus-visible { transform: translateY(-0.2rem); }
  }
</style>
