---
interface Props {
  eyebrow: string;
  title: string;
  text?: string;
  align?: "left" | "center";
}

const { eyebrow, title, text, align = "left" } = Astro.props;
---

<div class:list={["max-w-3xl", align === "center" ? "mx-auto text-center" : ""]}>
  <p class:list={["eyebrow", align === "center" ? "justify-center" : ""]}>{eyebrow}</p>
  <h2 class="section-title mt-5">{title}</h2>
  {text && <p class="body-copy mt-6 max-w-2xl">{text}</p>}
</div>
