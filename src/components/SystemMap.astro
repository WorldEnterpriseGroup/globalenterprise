---
import AssetImage from "@/components/AssetImage.astro";

interface Props {
  mediaSrc?: string;
  mediaAlt?: string;
  mediaCaption?: string;
}

const { mediaSrc, mediaAlt = "", mediaCaption = "" } = Astro.props;

const steps = [
  { id: "mandate", marker: "Mandate", title: "Mandate", text: "Name the outcome, the promise, and the decision the organization has to make next.", insight: "Define the institution-level consequence before designing the intervention." },
  { id: "workflow", marker: "Workflow", title: "Workflow", text: "See how the work really moves, where it waits, and where judgment matters.", insight: "Reduce ambiguity by showing how decisions propagate through handoffs and dependencies." },
  { id: "platform", marker: "Platform", title: "Platform", text: "Connect architecture, data, controls, and tools to the work they must support.", insight: "Align digital infrastructure with operating priorities so decisions remain auditable." },
  { id: "capability", marker: "Capability", title: "Capability", text: "Give people the roles, skills, and decision rights required to carry the change.", insight: "Build capacity before scale so capability survives after the project closes." },
  { id: "evidence", marker: "Evidence", title: "Evidence", text: "Make progress observable through measures, feedback, and a cadence that can adapt.", insight: "Protect momentum with repeated measurement, not hope and one-off reporting." },
];
---

<section class="section-pad bg-paper" data-system-map data-diagram-id="home-system-map">
  <div class="container-site grid gap-12 lg:grid-cols-[1fr_1.2fr] lg:gap-20">
    <div>
      <p class="eyebrow">The system view</p>
      <h2 class="section-title mt-5">Change holds when the parts reinforce each other.</h2>
      <p class="body-copy mt-6 max-w-xl">Move through the system to see the questions we keep connected when a problem crosses strategy, technology, and organizational life.</p>
      {mediaSrc && <figure class="mt-10 overflow-hidden border border-line bg-white shadow-[1rem_1rem_0_rgba(16,19,29,.08)]">
        <AssetImage src={mediaSrc} alt={mediaAlt} width={1536} height={1024} loading="lazy" decoding="async" class="aspect-[16/9] w-full object-cover" />
        {mediaCaption && <figcaption class="border-t border-line px-4 py-3 text-xs leading-relaxed text-muted">{mediaCaption}</figcaption>}
      </figure>}
    </div>
    <div class="system-map-canvas">
      <div>
        <div class="system-map-nodes" role="tablist" aria-label="The Global Enterprise system view">
          {steps.map((step, index) => <button class:list={["system-map-node", index === 0 ? "is-active" : ""]} type="button" role="tab" aria-selected={index === 0 ? "true" : "false"} aria-controls={`system-map-panel-${step.id}`} data-system-map-tab={step.id}><span>{step.marker}</span><strong>{step.title}</strong></button>)}
        </div>
        <p class="system-map-instructions mt-4 text-xs uppercase tracking-[0.1em] text-muted">Select any stage to refresh the operational reading.</p>
      </div>
      <div class="system-map-panel-wrap">
        <div class="system-map-panel" role="tabpanel" id="system-map-panel-mandate" data-system-map-panel="mandate" aria-live="polite">
          <p class="eyebrow">Mandate</p>
          <p class="mt-4 text-2xl font-medium leading-tight tracking-[-0.04em]" data-system-map-text>{steps[0].text}</p>
          <p class="mt-5 text-sm leading-relaxed text-muted">The map is a practical sequence: align what matters, sequence what is uncertain, then secure what cannot be skipped.</p>
          <a class="ink-link mt-7" href="/about/">See our approach <span aria-hidden="true"></span></a>
        </div>
        <div class="system-map-insight-grid" data-system-map-insights>
          {steps.map((step, index) => (
            <article class:list={["system-map-insight", index === 0 ? "is-active" : ""]} data-system-map-insight={step.id}>
              <p class="eyebrow text-cobalt">{step.marker}</p>
              <p class="mt-2 text-sm leading-relaxed text-muted">{step.insight}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const initializeSystemMap = () => {
    document.querySelectorAll<HTMLElement>("[data-system-map]").forEach((root) => {
      if (root.hasAttribute("data-bound")) return;
      root.setAttribute("data-bound", "true");
      const steps = {
        mandate: { marker: "Mandate", title: "Mandate", text: "Name the outcome, the promise, and the decision the organization has to make next.", href: "/about/", label: "See our approach" },
        workflow: { marker: "Workflow", title: "Workflow", text: "See how the work really moves, where it waits, and where judgment matters.", href: "/services/operating-model/", label: "Explore operating model design" },
        platform: { marker: "Platform", title: "Platform", text: "Connect architecture, data, controls, and tools to the work they must support.", href: "/services/cloud-data/", label: "Explore cloud and data foundations" },
        capability: { marker: "Capability", title: "Capability", text: "Give people the roles, skills, and decision rights required to carry the change.", href: "/services/leadership-talent/", label: "Explore leadership and talent" },
        evidence: { marker: "Evidence", title: "Evidence", text: "Make progress observable through measures, feedback, and a cadence that can adapt.", href: "/insights/", label: "Explore the signal" },
      } as Record<string, { marker: string; title: string; text: string; href: string; label: string }>;
      const panel = root.querySelector<HTMLElement>("[data-system-map-panel]");
      const text = root.querySelector<HTMLElement>("[data-system-map-text]");
      const eyebrow = panel?.querySelector<HTMLElement>(".eyebrow");
      const link = panel?.querySelector<HTMLAnchorElement>("a");
      const cards = root.querySelectorAll<HTMLElement>("[data-system-map-insight]");
      root.querySelectorAll<HTMLButtonElement>("[data-system-map-tab]").forEach((tab) => tab.addEventListener("click", () => {
        const step = steps[tab.dataset.systemMapTab ?? "mandate"];
        root.querySelectorAll("[data-system-map-tab]").forEach((candidate) => {
          candidate.classList.toggle("is-active", candidate === tab);
          candidate.setAttribute("aria-selected", String(candidate === tab));
        });
        cards.forEach((card) => {
          card.classList.toggle("is-active", card.dataset.systemMapInsight === tab.dataset.systemMapTab);
        });
        if (panel && text && eyebrow && link) {
          panel.id = `system-map-panel-${tab.dataset.systemMapTab}`;
          eyebrow.textContent = step.marker;
          text.textContent = step.text;
          link.href = step.href;
          link.innerHTML = `${step.label} <span aria-hidden="true"></span>`;
        }
      }));
    });
  };

  initializeSystemMap();
  document.addEventListener("astro:page-load", initializeSystemMap);
</script>
