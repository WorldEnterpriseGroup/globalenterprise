---
import Base from "@/layouts/Base.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import AssetImage from "@/components/AssetImage.astro";
import { getCollection } from "astro:content";

interface Props {
  title: string;
  description: string;
  showHeroImage?: boolean;
}

const { title, description, showHeroImage = true } = Astro.props;
const cases = (await getCollection("caseStudies")).filter((entry) => !entry.data.draft);
---

<Base title={title} description={description} image="/media/original/work-field-visit.avif" keywords={["enterprise consulting case studies", "operating model case study", "cloud data transformation", "automation at scale", "federal IT strategy"]}>
  <section class="bg-ink py-20 text-white md:py-28"><div class:list={["container-site grid gap-12", showHeroImage ? "lg:grid-cols-[1fr_.72fr] lg:items-end" : ""]}><div class:list={[showHeroImage ? "" : "max-w-4xl"]}><p class="eyebrow text-lime">Selected work</p><h1 class="section-title mt-7 max-w-5xl">The work is the proof.</h1><p class="mt-8 max-w-2xl text-xl leading-relaxed text-white/65">A field note is useful when it shows the operating move behind the outcome—not a before-and-after decoration.</p></div>{showHeroImage && <figure class="relative overflow-hidden bg-cobalt"><AssetImage src="/media/original/work-field-visit.avif" width={1536} height={1024} loading="eager" decoding="async" alt="An operations team walking through an industrial control room during a site visit" class="aspect-[16/9] w-full object-cover opacity-90" /><figcaption class="absolute inset-x-0 bottom-0 bg-ink/75 p-4 text-xs uppercase tracking-[0.12em] text-white/70">The field is where the system tells the truth.</figcaption></figure>}</div></section>
  <section class="section-pad bg-white"><div class="container-site"><SectionHeading eyebrow="Field notes" title="Patterns that travel." text="Every engagement is different. The underlying moves are often surprisingly consistent. Where identifiers are withheld, the mechanism and evidence boundary are stated plainly." /><div class="mt-14 divide-y divide-line border-y border-line">{cases.map((entry) => <a class="group grid gap-5 py-8 md:grid-cols-[1fr_1fr_auto] md:items-center" href={`/case-studies/${entry.id}/`}><div><p class="text-xs font-bold uppercase tracking-[0.12em] text-cobalt">{entry.data.sector} · {entry.data.service}</p><h2 class="mt-3 font-display text-3xl font-medium leading-tight tracking-[-0.05em] transition-colors group-hover:text-cobalt">{entry.data.title}</h2>{entry.data.confidential && <p class="mt-3 text-xs font-bold uppercase tracking-[0.12em] text-muted">Confidential portfolio field note</p>}</div><p class="max-w-xl text-sm leading-relaxed text-muted">{entry.data.result}</p><span class="text-2xl transition-transform group-hover:translate-x-1 group-hover:-translate-y-1" aria-hidden="true">↗</span></a>)}</div></div></section>
  <section class="section-pad bg-paper"><div class="container-site grid gap-12 lg:grid-cols-[.7fr_1.3fr] lg:gap-24"><div><p class="eyebrow text-cobalt">The field-note test</p><h2 class="section-title mt-5 max-w-3xl">Read for the move, the boundary, and what remains.</h2><p class="mt-6 max-w-xl text-lg leading-relaxed text-muted">A useful case study makes the operating mechanism inspectable without turning private work into a public endorsement.</p></div><div class="grid gap-px border border-line bg-line md:grid-cols-3"><article class="bg-paper p-7 md:p-8"><p class="text-xs font-bold uppercase tracking-[0.12em] text-cobalt">Mechanism</p><h3 class="mt-12 font-display text-2xl font-medium leading-tight tracking-[-0.04em]">Name the operating move.</h3><p class="mt-4 text-sm leading-relaxed text-muted">Show how decisions, workflows, ownership, and measures were connected.</p></article><article class="bg-paper p-7 md:p-8"><p class="text-xs font-bold uppercase tracking-[0.12em] text-cobalt">Boundary</p><h3 class="mt-12 font-display text-2xl font-medium leading-tight tracking-[-0.04em]">Say what cannot be published.</h3><p class="mt-4 text-sm leading-relaxed text-muted">Separate confidential portfolio context from evidence a reader can verify.</p></article><article class="bg-paper p-7 md:p-8"><p class="text-xs font-bold uppercase tracking-[0.12em] text-cobalt">Transfer</p><h3 class="mt-12 font-display text-2xl font-medium leading-tight tracking-[-0.04em]">Make the next move visible.</h3><p class="mt-4 text-sm leading-relaxed text-muted">Leave the reader with a question they can carry into the next operating review.</p></article></div></div></section>
  <section class="bg-lime"><div class="container-site flex flex-col gap-8 py-16 md:flex-row md:items-center md:justify-between"><h2 class="max-w-2xl font-display text-5xl font-bold tracking-[-0.07em]">Your hard thing could be next.</h2><a class="btn-dark shrink-0" href="/contact/">Bring us the brief <span aria-hidden="true">↗</span></a></div></section>
</Base>
