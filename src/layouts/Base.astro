---
import { ClientRouter } from "astro:transitions";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ContextualNext from "@/components/ContextualNext.astro";
import { industries, services, site } from "@/data/site";
import "@/styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: "website" | "article";
  noindex?: boolean;
  keywords?: string[];
  author?: string;
  publishedTime?: string;
  modifiedTime?: string;
  serviceSchema?: { name: string; description: string };
}

const { title, description, image = "/og-image.svg", type = "website", noindex = false, keywords = [], author = site.name, publishedTime, modifiedTime, serviceSchema } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).toString();
const pathname = Astro.url.pathname;
const industryMatch = industries.find((item) => pathname.startsWith(`/industries/${item.slug}`));
const serviceMatch = services.find((item) => pathname.startsWith(`/services/${item.slug}`));
const pageVisual = industryMatch
  ? { src: industryMatch.image, alt: `${industryMatch.title} strategy working session`, eyebrow: `${industryMatch.title} · sector signal`, title: "Context changes the answer. We make the next decision clearer.", icon: "pulse" }
  : serviceMatch
    ? { src: serviceMatch.image, alt: `${serviceMatch.title} consulting working session`, eyebrow: `${serviceMatch.title} · capability in practice`, title: "A capability becomes valuable when it can travel through the organization.", icon: "system" }
    : pathname.startsWith("/insights")
      ? { src: "/media/generated/ai-governance.avif", alt: "Leaders reviewing an enterprise AI operating model", eyebrow: "Evidence into action", title: "The useful question is what the evidence changes in the operating model.", icon: "compass" }
      : pathname.startsWith("/case-studies")
        ? { src: "/media/generated/federal-mission.avif", alt: "Enterprise transformation leaders reviewing performance signals", eyebrow: "Selected work · field note", title: "The work is the proof when the system keeps improving after launch.", icon: "arrow" }
        : pathname.startsWith("/careers") || pathname.startsWith("/team")
          ? { src: "/media/generated/education-future.avif", alt: "A diverse group collaborating in a modern learning space", eyebrow: "The people behind the work", title: "Good strategy is a team sport with unusually high standards.", icon: "people" }
          : pathname.startsWith("/contact")
            ? { src: "/media/generated/enterprise-hero.avif", alt: "A quiet enterprise boardroom prepared for a working session", eyebrow: "Start with the real question", title: "A useful first conversation begins before the brief is perfect.", icon: "compass" }
            : { src: "/media/generated/enterprise-hero.avif", alt: "Modern city skyline seen from a strategy room", eyebrow: "Global Enterprise", title: "Clarity is a competitive advantage when the world is changing quickly.", icon: "system" };
const socialImagePath = image === "/og-image.svg" ? "/og-image.png" : image;
const socialImage = new URL(socialImagePath, site.url).toString();
const logo = new URL("/favicon.svg", site.url).toString();
const breadcrumbLabels: Record<string, string> = {
  about: "Approach",
  careers: "Careers",
  "case-studies": "Work",
  contact: "Contact",
  faq: "FAQ",
  industries: "Industries",
  insights: "Insights",
  privacy: "Privacy",
  services: "Capabilities",
  team: "Team",
  terms: "Terms",
};
const breadcrumbItems = [{ name: site.name, item: new URL("/", site.url).toString() }, ...pathname.split("/").filter(Boolean).map((segment, index, segments) => ({
  name: index === segments.length - 1 ? title.split(" | ")[0] : breadcrumbLabels[segment] ?? segment.replaceAll("-", " ").replace(/\b\w/g, (letter) => letter.toUpperCase()),
  item: new URL(`/${segments.slice(0, index + 1).join("/")}/`, site.url).toString(),
}))];
const graph = [
  {
  "@type": ["Organization", "ProfessionalService"],
  "@id": `${site.url}/#organization`,
  name: site.name,
  url: site.url,
  logo,
  description: site.description,
  email: site.email,
  telephone: site.phone,
  areaServed: "Worldwide",
  serviceType: ["Business consulting", "Enterprise architecture", "Intelligent automation"],
  knowsAbout: ["Operating model design", "Enterprise AI", "Cloud and data foundations", "Transformation governance"],
  ...(site.social.linkedin ? { sameAs: [site.social.linkedin] } : {}),
  },
  { "@type": "WebSite", "@id": `${site.url}/#website`, name: site.name, url: site.url, description: site.description, publisher: { "@id": `${site.url}/#organization` } },
  { "@type": type === "article" ? "Article" : "WebPage", name: title, url: canonical, description, isPartOf: { "@type": "WebSite", name: site.name, url: site.url }, ...(type === "article" ? { author: { "@type": "Organization", name: author }, datePublished: publishedTime, dateModified: modifiedTime ?? publishedTime, image: socialImage } : {}) },
  ...(serviceSchema ? [{ "@type": "Service", name: serviceSchema.name, description: serviceSchema.description, provider: { "@id": `${site.url}/#organization` }, areaServed: "Worldwide", url: canonical }] : []),
  { "@type": "BreadcrumbList", itemListElement: breadcrumbItems.map((item, index) => ({ "@type": "ListItem", position: index + 1, name: item.name, item: item.item })) },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#315b8e" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(", ")} />}
    <meta name="author" content={author} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={pageVisual.alt} />
    <meta property="og:image:type" content={socialImage.endsWith(".svg") ? "image/svg+xml" : socialImage.endsWith(".png") ? "image/png" : "image/avif"} />
    <meta name="twitter:image:alt" content={pageVisual.alt} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    {pathname === "/" && <link rel="preload" as="image" href="/media/generated/enterprise-hero.avif" type="image/avif" fetchpriority="high" />}
    <link rel="alternate" type="application/rss+xml" title={`${site.name} insights`} href="/rss.xml" />
    {site.analytics.plausibleDomain && <script is:inline defer data-domain={site.analytics.plausibleDomain} src="https://plausible.io/js/script.js"></script>}
    <script is:inline type="application/ld+json" set:html={JSON.stringify({ "@context": "https://schema.org", "@graph": graph })}></script>
    <ClientRouter />
  </head>
  <body>
    <a class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:bg-lime focus:px-4 focus:py-3 focus:text-ink" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <ContextualNext />
    <Footer />
    <script>
      const initializeSiteAnalytics = () => {
        if (document.documentElement.hasAttribute("data-analytics-bound")) return;
        document.documentElement.setAttribute("data-analytics-bound", "true");
        const analyticsWindow = window as any;
        analyticsWindow.plausible = analyticsWindow.plausible || function (...args: unknown[]) {
          (analyticsWindow.plausible.q = analyticsWindow.plausible.q || []).push(args);
        };
        const track = (eventName: string, props: Record<string, string> = {}) => {
          const analyticsWindow = window as Window & { plausible?: (name: string, options?: { props?: Record<string, string> }) => void; gtag?: (...args: unknown[]) => void };
          analyticsWindow.plausible?.(eventName, { props });
          analyticsWindow.gtag?.("event", eventName, props);
          window.dispatchEvent(new CustomEvent("site:analytics", { detail: { eventName, props } }));
        };
        document.addEventListener("click", (event) => {
          const target = event.target instanceof Element ? event.target.closest<HTMLElement>("a, button") : null;
          if (!target) return;
          const href = target.getAttribute("href") ?? "";
          const explicit = target.dataset.track;
          const eventName = explicit ?? (href.startsWith("/contact/") ? "cta_click" : href.startsWith("/insights/") ? "insight_open" : href.startsWith("/solutions/") ? "solution_open" : "");
          if (!eventName) return;
          track(eventName, { label: target.dataset.trackLabel ?? target.textContent?.replace(/\s+/g, " ").trim().slice(0, 80) ?? "", href });
        });
        document.addEventListener("focusin", (event) => {
          const target = event.target instanceof HTMLInputElement || event.target instanceof HTMLTextAreaElement ? event.target : null;
          const form = target?.closest<HTMLFormElement>("form[data-lead-form]");
          if (!form || form.hasAttribute("data-form-started")) return;
          form.setAttribute("data-form-started", "true");
          track("form_start", { form: form.dataset.formKind ?? "lead" });
        });
        document.addEventListener("submit", (event) => {
          const form = event.target instanceof HTMLFormElement && event.target.matches("[data-lead-form]") ? event.target : null;
          if (form) track("form_submit", { form: form.dataset.formKind ?? "lead" });
        });
      };
      initializeSiteAnalytics();
      document.addEventListener("astro:page-load", initializeSiteAnalytics);
    </script>
  </body>
</html>
