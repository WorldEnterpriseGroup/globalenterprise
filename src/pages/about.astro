---
import Base from "@/layouts/Base.astro";
import EvidenceBand from "@/components/EvidenceBand.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import AssetImage from "@/components/AssetImage.astro";
import { experienceHighlights, principles } from "@/data/site";
---

<Base title="About Global Enterprise | How we work" description="Meet Global Enterprise: a practical strategy and systems partner for leaders moving complex organizations forward." keywords={["Global Enterprise consulting", "enterprise strategy partner", "AI advisory", "ITIL change management", "organizational transformation"]}>
  <section class="bg-ink py-20 text-white md:py-28"><div class="container-site grid gap-12 lg:grid-cols-[1fr_.72fr] lg:items-end"><div><p class="eyebrow text-lime">About Global Enterprise</p><h1 class="section-title mt-7 max-w-5xl">We help good organizations become easier to lead.</h1><p class="mt-8 max-w-2xl text-xl leading-relaxed text-white/65">Our work sits where business strategy, technology, and organizational life meet. We bring structure to complexity, then build with the people who have to live with the result.</p></div><div class="relative overflow-hidden bg-cobalt"><AssetImage src="/media/generated/enterprise-hero.avif" width={1536} height={1024} loading="eager" decoding="async" alt="A quiet enterprise strategy room prepared for a working session" class="aspect-[4/3] w-full object-cover opacity-90" /></div></div></section>
  <section class="section-pad bg-white"><div class="container-site grid gap-12 lg:grid-cols-[.8fr_1.2fr] lg:gap-24"><SectionHeading eyebrow="Our point of view" title="The best transformation is felt in the ordinary day." /><div class="space-y-6 text-lg leading-relaxed text-muted"><p>When the system is working, decisions arrive with the right context. Teams know what they own. Technology clears a path instead of creating another queue.</p><p>That is the measure we use. Not how impressive the plan sounds, but whether the next decision is easier, the next handoff is cleaner, and the organization has more capacity to do its best work.</p><p>Global Enterprise partners with Fortune 500 companies, government agencies, and education institutions on enterprise solutions across strategy, cloud, data, automation, and talent.</p><p>Our experience includes solution strategy for top federal agencies, enterprise AI advisory, healthcare transformation, and ITIL change management carried across a decade of service and platform change. We bring that history without assuming the next organization should copy the last one.</p></div></div></section>

  <EvidenceBand eyebrow="The world we are helping leaders navigate" title="Evidence makes the conversation more honest." text="Public research gives leaders a common starting point. The consulting work is understanding what the evidence means for this organization, this service, and this decision." limit={3} />

  <section class="section-pad bg-white"><div class="container-site"><SectionHeading eyebrow="The experience behind the method" title="We have learned to stay close to the consequence." /><div class="mt-14 grid gap-px border border-line bg-line md:grid-cols-3">{experienceHighlights.map((item) => <article class="bg-white p-8 md:p-10"><p class="font-display text-5xl font-medium tracking-[-0.06em] text-cobalt">{item.number}</p><h2 class="mt-12 font-display text-2xl font-medium tracking-[-0.04em]">{item.label}</h2><p class="mt-4 leading-relaxed text-muted">{item.text}</p></article>)}</div></div></section>
  <section class="section-pad bg-paper"><div class="container-site"><SectionHeading eyebrow="Our principles" title="A few things we will not compromise." /><div class="mt-16 grid border-y border-line md:grid-cols-3">{principles.map((principle) => <div class="border-b border-line py-8 md:border-b-0 md:border-r md:p-9 md:first:pl-0 md:last:border-r-0"><p class="font-display text-2xl font-bold tracking-[-0.04em] text-cobalt">{principle.marker}</p><h2 class="mt-10 font-display text-3xl font-bold tracking-[-0.06em]">{principle.title}</h2><p class="mt-4 leading-relaxed text-muted">{principle.text}</p></div>)}</div></div></section>
  <section class="section-pad bg-cobalt text-white"><div class="container-site grid gap-10 lg:grid-cols-[1fr_.9fr] lg:items-end"><div><p class="eyebrow text-lime">The partner you get</p><h2 class="section-title mt-5 max-w-3xl">Senior thinking. Practical hands. No theater.</h2></div><p class="text-lg leading-relaxed text-white/70">We are comfortable in the boardroom, the backlog, the policy room, and the operating review. The work has to hold up in all four.</p></div></section>
  <section class="bg-lime"><div class="container-site flex flex-col gap-8 py-16 md:flex-row md:items-center md:justify-between"><h2 class="max-w-2xl font-display text-5xl font-bold tracking-[-0.07em]">Let’s make the next move legible.</h2><a class="btn-dark shrink-0" href="/contact/">Talk with us <span aria-hidden="true">↗</span></a></div></section>
</Base>
