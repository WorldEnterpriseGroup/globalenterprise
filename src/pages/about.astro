---
import Base from "@/layouts/Base.astro";
import EvidenceBand from "@/components/EvidenceBand.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import AssetImage from "@/components/AssetImage.astro";
import ArchitectureMap from "@/components/ArchitectureMap.astro";
import IntelligenceStack from "@/components/IntelligenceStack.astro";
import { experienceHighlights, principles } from "@/data/site";
---

<Base title="About Global Enterprise | A future-facing advisory house" description="Global Enterprise is a senior strategy, AI/ML, data, research, and enterprise change partner for institutions carrying consequential decisions." image="/media/original/about-workshop.avif" keywords={["future-facing strategy partner", "enterprise AI advisory", "AI cost management", "data lab build out", "ITIL change management", "quantum intelligence"]}>
  <section class="bg-ink py-20 text-white md:py-28"><div class="container-site grid gap-12 lg:grid-cols-[1fr_.72fr] lg:items-end"><div><p class="eyebrow text-lime">About Global Enterprise</p><h1 class="section-title mt-7 max-w-5xl">A calm, senior view of the next order of complexity.</h1><p class="mt-8 max-w-2xl text-xl leading-relaxed text-white/65">We work where frontier intelligence, enterprise systems, economics, and institutional change meet. The result is not more motion; it is a more capable organization with a clearer hand on the future.</p></div><figure class="relative overflow-hidden bg-cobalt"><AssetImage src="/media/original/about-workshop.avif" width={1536} height={1024} loading="eager" decoding="async" alt="Three colleagues reviewing printed process maps around a workshop table" class="aspect-[4/3] w-full object-cover opacity-90" /><figcaption class="absolute inset-x-0 bottom-0 bg-ink/75 p-4 text-xs uppercase tracking-[0.12em] text-white/70">Composure is a capability when the system is changing.</figcaption></figure></div></section>
  <section class="section-pad bg-white"><div class="container-site grid gap-12 lg:grid-cols-[.8fr_1.2fr] lg:gap-24"><SectionHeading eyebrow="Our point of view" title="Intelligence only matters when an institution can absorb it." /><div class="space-y-6 text-lg leading-relaxed text-muted"><p>When an institution is ready, new intelligence does not arrive as theater. It enters the decision, the operating model, the platform, the control environment, and the ordinary day.</p><p>That is the standard we hold: more signal without more noise, more capability without less judgment, and transformation that compounds rather than resets at the next quarter.</p><p>We work with complex enterprises, public systems, advanced technology, infrastructure, and human capability where the decision has to travel beyond the room.</p><p>Our founders have been recognized repeatedly for AI leadership. Our work pairs that frontier perspective with more than two decades of emerging-technology and ITIL change-management practice, so the future can be designed with both imagination and control.</p></div></div></section>

  <section class="section-pad bg-paper"><div class="container-site"><IntelligenceStack /></div></section>

  <section class="section-pad bg-paper"><div class="container-site"><ArchitectureMap variant="about-architecture" eyebrow="How we think · system architecture" title="The work connects the layers leaders usually inherit separately." caption="Mandate, workflow, platform, capability, and evidence are designed together so the operating model can carry the strategy." /></div></section>

  <EvidenceBand eyebrow="The world we are helping leaders navigate" title="Evidence makes the conversation more honest." text="Public research gives leaders a common starting point. The consulting work is understanding what the evidence means for this organization, this service, and this decision." limit={3} />

  <section class="section-pad bg-white"><div class="container-site"><SectionHeading eyebrow="The experience behind the method" title="We have learned to stay close to the consequence." /><div class="mt-14 grid gap-px border border-line bg-line md:grid-cols-3">{experienceHighlights.map((item) => <article class="bg-white p-8 md:p-10"><p class="font-display text-5xl font-medium tracking-[-0.06em] text-cobalt">{item.number}</p><h2 class="mt-12 font-display text-2xl font-medium tracking-[-0.04em]">{item.label}</h2><p class="mt-4 leading-relaxed text-muted">{item.text}</p></article>)}</div></div></section>
  <section class="section-pad bg-paper"><div class="container-site"><SectionHeading eyebrow="Our principles" title="A few things we will not compromise." /><div class="mt-16 grid border-y border-line md:grid-cols-3">{principles.map((principle) => <div class="border-b border-line py-8 md:border-b-0 md:border-r md:p-9 md:first:pl-0 md:last:border-r-0"><p class="font-display text-2xl font-bold tracking-[-0.04em] text-cobalt">{principle.marker}</p><h2 class="mt-10 font-display text-3xl font-bold tracking-[-0.06em]">{principle.title}</h2><p class="mt-4 leading-relaxed text-muted">{principle.text}</p></div>)}</div></div></section>
  <section class="section-pad bg-cobalt text-white"><div class="container-site grid gap-10 lg:grid-cols-[1fr_.9fr] lg:items-end"><div><p class="eyebrow text-lime">The partner you get</p><h2 class="section-title mt-5 max-w-3xl">Senior thinking. Frontier fluency. Institutional calm.</h2></div><p class="text-lg leading-relaxed text-white/70">We are comfortable at the level where a strategic question becomes architecture, economics, policy, operating rhythm, and change. The work has to remain coherent in every room.</p></div></section>
  <section class="bg-lime"><div class="container-site flex flex-col gap-8 py-16 md:flex-row md:items-center md:justify-between"><h2 class="max-w-2xl font-display text-5xl font-bold tracking-[-0.07em]">Let’s design the institution that can carry what comes next.</h2><a class="btn-dark shrink-0" href="/contact/">Request a principal dialogue <span aria-hidden="true">↗</span></a></div></section>
</Base>
