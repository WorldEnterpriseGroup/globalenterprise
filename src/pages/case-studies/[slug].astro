---
import Base from "@/layouts/Base.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const entries = (await getCollection("caseStudies")).filter((entry) => !entry.data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base title={`${entry.data.title} | Global Enterprise`} description={entry.data.description} image="/media/original/work-field-visit.avif" imageWidth={1536} imageHeight={1024} imageAlt="An operations team walking through an industrial control room" type="article" keywords={[entry.data.sector, entry.data.service, "enterprise transformation", "case study"]}>
  <section class="bg-cobalt py-20 text-white md:py-28"><div class="container-site grid gap-12 lg:grid-cols-[.8fr_1.1fr_.7fr] lg:items-end"><div><p class="eyebrow text-accent">{entry.data.eyebrow}</p><p class="mt-10 text-sm font-bold uppercase tracking-[0.12em] text-white/60">{entry.data.sector} · {entry.data.service}</p></div><h1 class="section-title max-w-5xl">{entry.data.title}</h1><div class="border-l border-white/25 pl-6"><p class="eyebrow text-accent">Field note</p><p class="mt-5 max-w-xs text-lg leading-relaxed text-white/75">The useful proof is the operating move that remains after the engagement.</p></div></div></section>
  <section class="section-pad bg-white"><div class="container-site grid gap-12 lg:grid-cols-[.7fr_1.3fr] lg:gap-24"><div><p class="eyebrow">The difference</p><p class="mt-6 font-display text-3xl font-bold leading-tight tracking-[-0.06em] text-cobalt">{entry.data.result}</p>{entry.data.confidential && <div class="mt-8 border-l-2 border-cobalt pl-5"><p class="text-xs font-bold uppercase tracking-[0.12em] text-cobalt">Confidential portfolio field note</p><p class="mt-3 text-sm leading-relaxed text-muted">{entry.data.evidenceNote ?? "Identifiers are withheld by design. This page describes the operating mechanism and the evidence boundary without implying a public client endorsement."}</p></div>}<div class="mt-8 grid gap-5 border-y border-line py-6 text-sm">{entry.data.environment && <div><p class="font-bold text-cobalt">Environment</p><p class="mt-1 leading-relaxed text-muted">{entry.data.environment}</p></div>}{entry.data.timeframe && <div><p class="font-bold text-cobalt">Timeframe</p><p class="mt-1 leading-relaxed text-muted">{entry.data.timeframe}</p></div>}{entry.data.scope.length > 0 && <div><p class="font-bold text-cobalt">Scope</p><ul class="mt-2 space-y-1 text-muted">{entry.data.scope.map((item) => <li>— {item}</li>)}</ul></div>}</div><a class="btn-dark mt-10" href="/contact/">Discuss a similar challenge <span aria-hidden="true">↗</span></a></div><article class="prose max-w-3xl text-lg leading-relaxed text-muted prose-headings:font-display prose-headings:tracking-[-0.06em] prose-headings:text-ink prose-h2:mt-12 prose-h2:text-4xl prose-p:my-5"><Content /></article></div></section>
  <section class="section-pad bg-paper" data-diagram-id={`case-${entry.id}-mechanism-boundary`}><div class="container-site grid gap-12 lg:grid-cols-[.7fr_1.3fr] lg:gap-24"><div><p class="eyebrow text-cobalt">Mechanism and boundary</p><h2 class="section-title mt-5 max-w-3xl">What to carry into the next review.</h2><p class="mt-6 text-lg leading-relaxed text-muted">This field note describes the operating move and the evidence boundary. It is a prompt for disciplined comparison, not a claim that every environment should use the same design.</p></div><div class="grid gap-px border border-line bg-line md:grid-cols-3"><article class="bg-paper p-7 md:p-8"><p class="text-xs font-bold uppercase tracking-[0.14em] text-cobalt">Operating move</p><p class="mt-10 font-display text-2xl font-medium leading-tight tracking-[-0.04em]">{entry.data.result}</p></article><article class="bg-paper p-7 md:p-8"><p class="text-xs font-bold uppercase tracking-[0.14em] text-cobalt">Scope to inspect</p>{entry.data.scope.length > 0 ? <ul class="mt-8 space-y-3 text-sm leading-relaxed text-muted">{entry.data.scope.map((item) => <li class="border-l-2 border-line pl-3">{item}</li>)}</ul> : <p class="mt-10 text-sm leading-relaxed text-muted">Scope details are intentionally limited in this public note.</p>}</article><article class="bg-paper p-7 md:p-8"><p class="text-xs font-bold uppercase tracking-[0.14em] text-cobalt">Evidence boundary</p><p class="mt-8 text-sm leading-relaxed text-muted">{entry.data.evidenceNote ?? "Identifiers and product details are withheld by design; this page describes the mechanism without implying a public client endorsement."}</p></article></div></div></section>
</Base>
