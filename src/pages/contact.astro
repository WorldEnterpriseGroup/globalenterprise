---
import Base from "@/layouts/Base.astro";
import { site } from "@/data/site";
import AssetImage from "@/components/AssetImage.astro";
import EngagementCards from "@/components/EngagementCards.astro";
---

<Base title="Start a conversation | Global Enterprise" description="Tell Global Enterprise what is changing, what is stuck, and what you need to make the next move." keywords={["contact Global Enterprise", "enterprise consulting inquiry", "transformation strategy consultation", "AI consulting partner"]}>
  <section class="bg-ink py-20 text-white md:py-28"><div class="container-site grid gap-12 lg:grid-cols-[1fr_.65fr_.55fr] lg:items-end"><div><p class="eyebrow text-lime">Start a conversation</p><h1 class="section-title mt-7 max-w-4xl">Bring us the hard thing.</h1><p class="mt-8 max-w-2xl text-xl leading-relaxed text-white/65">A useful first conversation does not need a perfect brief. Tell us what is changing, what is stuck, and what a better version would make possible.</p></div><div class="border-t border-white/20 pt-7 text-white/70"><p class="text-xs font-bold uppercase tracking-[0.14em] text-lime">Direct line</p><a class="mt-4 block text-2xl font-bold text-white hover:text-lime" href={`mailto:${site.email}`}>{site.email}</a><a class="mt-2 block text-lg text-white/70 hover:text-lime" href={`tel:${site.phone.replaceAll(" ", "")}`}>{site.phone}</a></div><div class="relative overflow-hidden bg-cobalt"><AssetImage src="/media/generated/enterprise-hero.avif" width={1536} height={1024} loading="eager" decoding="async" alt="A quiet enterprise boardroom prepared for a working session" class="aspect-[4/3] w-full object-cover opacity-85" /></div></div></section>
  <section class="section-pad bg-white"><div class="container-site grid gap-12 lg:grid-cols-[.7fr_1.3fr] lg:gap-24"><div><p class="eyebrow">A few useful prompts</p><ul class="mt-8 space-y-4 text-lg font-bold leading-snug"><li>What has become harder as you have grown?</li><li>Where is good work getting stuck?</li><li>What would your leaders do differently with better signal?</li></ul><div class="mt-12 border-t border-line pt-7"><p class="text-xs font-bold uppercase tracking-[0.14em] text-cobalt">What happens next</p><p class="mt-4 leading-relaxed text-muted">We read the brief before the first conversation. We come prepared with a few hypotheses, a sharper set of questions, and a view on where a useful first release might begin.</p></div></div><form class="grid gap-6" action={site.formEndpoint} method="POST" data-lead-form data-form-kind="contact"><input type="hidden" name="_subject" value="New Global Enterprise inquiry" /><input type="hidden" name="_next" value={`${site.url}/contact/thanks/`} /><input type="hidden" name="_template" value="table" /><input type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true" class="absolute -left-[9999px] h-px w-px overflow-hidden" /><div class="grid gap-6 sm:grid-cols-2"><label class="grid gap-2 text-sm font-bold" for="contact-name">Name<input id="contact-name" class="border-b-2 border-line bg-transparent px-0 py-3 text-lg font-normal outline-none transition-colors focus:border-cobalt" type="text" name="name" autocomplete="name" required /></label><label class="grid gap-2 text-sm font-bold" for="contact-email">Work email<input id="contact-email" class="border-b-2 border-line bg-transparent px-0 py-3 text-lg font-normal outline-none transition-colors focus:border-cobalt" type="email" name="email" autocomplete="email" required /></label></div><label class="grid gap-2 text-sm font-bold" for="contact-organization">Organization<input id="contact-organization" class="border-b-2 border-line bg-transparent px-0 py-3 text-lg font-normal outline-none transition-colors focus:border-cobalt" type="text" name="organization" autocomplete="organization" /></label><label class="grid gap-2 text-sm font-bold" for="contact-message">What are you working through?<textarea id="contact-message" class="min-h-36 resize-y border-b-2 border-line bg-transparent px-0 py-3 text-lg font-normal outline-none transition-colors focus:border-cobalt" name="message" required></textarea></label><label class="flex items-start gap-3 text-sm text-muted" for="contact-consent"><input id="contact-consent" class="mt-1 size-4 accent-cobalt" type="checkbox" name="consent" value="yes" required />I agree to be contacted about this inquiry.</label><button class="btn-dark w-fit" type="submit" data-track="contact_submit">Send the brief <span aria-hidden="true">↗</span></button></form></div></section>

  <section class="section-pad bg-paper"><div class="container-site"><p class="eyebrow">Ways to begin</p><h2 class="section-title mt-5 max-w-3xl">A clear first step makes the conversation more useful.</h2><p class="body-copy mt-6 max-w-2xl">Choose the scale that fits the decision in front of you; we can adjust the path once we understand the context.</p><div class="mt-10"><EngagementCards /></div></div></section>
</Base>
