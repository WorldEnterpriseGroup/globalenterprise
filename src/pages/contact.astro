---
import Base from "@/layouts/Base.astro";
import { site } from "@/data/site";
import AssetImage from "@/components/AssetImage.astro";
import IntelligenceStack from "@/components/IntelligenceStack.astro";
---

<Base title="Principal dialogue | Global Enterprise" description="A private first conversation for leaders shaping high-consequence systems across AI/ML, data, frontier intelligence, and enterprise change." image="/media/original/contact-workbench.avif" keywords={["principal advisory dialogue", "enterprise AI strategy", "AI cost management", "data lab build out", "quantum intelligence", "ITIL change management"]}>
  <section class="bg-ink py-20 text-white md:py-28">
    <div class="container-site grid gap-12 lg:grid-cols-[1fr_.65fr_.55fr] lg:items-end">
      <div class="min-w-0">
        <p class="eyebrow text-lime">When the decision reaches beyond the room</p>
        <h1 class="section-title mt-7 max-w-4xl">Bring the mandate behind the question.</h1>
        <p class="mt-8 max-w-2xl text-xl leading-relaxed text-white/65">We begin where intelligence, economics, trust, and change have to hold at the same time. Not a generic discovery call—an initial conversation about the decision, the system around it, and what would make it move.</p>
      </div>
      <div class="border-t border-white/20 pt-7 text-white/70">
        <p class="text-xs font-bold uppercase tracking-[0.14em] text-lime">Direct line</p>
        <a class="mt-4 block text-2xl font-bold text-white hover:text-lime" href={`mailto:${site.email}`}>{site.email}</a>
        <a class="mt-2 block text-lg text-white/70 hover:text-lime" href={`tel:${site.phone.replaceAll(" ", "")}`}>{site.phone}</a>
        <p class="mt-6 max-w-xs text-sm leading-relaxed text-white/45">New York · Global reach · Sensitive context handled through the appropriate channel</p>
      </div>
      <figure class="relative overflow-hidden bg-cobalt"><AssetImage src="/media/original/contact-workbench.avif" width={1536} height={1024} loading="eager" decoding="async" alt="Hands arranging working papers and a notebook on a wooden table" class="aspect-[16/9] w-full object-cover opacity-85" /><figcaption class="absolute inset-x-0 bottom-0 bg-ink/75 p-4 text-xs uppercase tracking-[0.12em] text-white/70">A serious conversation starts with the real brief.</figcaption></figure>
    </div>
  </section>

  <section class="section-pad bg-white">
    <div class="container-site grid gap-12 lg:grid-cols-[.7fr_1.3fr] lg:gap-24">
      <div class="min-w-0">
        <p class="eyebrow">The right level of context</p>
        <h2 class="mt-6 font-display text-4xl font-medium tracking-[-0.05em] md:text-5xl">Write for the room that will make the decision.</h2>
        <div class="mt-9 border-t border-line pt-7">
          <p class="text-xs font-bold uppercase tracking-[0.14em] text-cobalt">Useful context includes</p>
          <ul class="mt-5 space-y-4 text-lg font-medium leading-snug">
            <li>the mandate, portfolio, or institutional horizon</li>
            <li>the decision that is blocked or becoming urgent</li>
            <li>the consequence of delay, drift, or the wrong architecture</li>
            <li>the level of confidentiality and the channel required</li>
          </ul>
        </div>
        <div class="mt-10 border-t border-line pt-7">
          <p class="text-xs font-bold uppercase tracking-[0.14em] text-cobalt">What happens next</p>
          <p class="mt-4 leading-relaxed text-muted">A senior member of the team reads the brief before we meet. We arrive with a point of view, a small set of hypotheses, and a clear sense of whether our capabilities are the right fit.</p>
        </div>
      </div>

      <form class="grid min-w-0 gap-6" action={site.formEndpoint} method="POST" data-lead-form data-form-kind="principal-dialogue">
        <input type="hidden" name="_subject" value="Principal dialogue · Global Enterprise" />
        <input type="hidden" name="_next" value={`${site.url}/contact/thanks/`} />
        <input type="hidden" name="_template" value="table" />
        <input type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true" class="absolute -left-[9999px] h-px w-px overflow-hidden" />
        <div class="grid gap-6 sm:grid-cols-2">
          <label class="grid gap-2 text-sm font-bold" for="contact-name">Name<input id="contact-name" class="border-b-2 border-line bg-transparent px-0 py-3 text-lg font-normal outline-none transition-colors focus:border-cobalt" type="text" name="name" autocomplete="name" required /></label>
          <label class="grid gap-2 text-sm font-bold" for="contact-title">Title / role<input id="contact-title" class="border-b-2 border-line bg-transparent px-0 py-3 text-lg font-normal outline-none transition-colors focus:border-cobalt" type="text" name="title" autocomplete="organization-title" required /></label>
        </div>
        <div class="grid gap-6 sm:grid-cols-2">
          <label class="grid gap-2 text-sm font-bold" for="contact-email">Work email<input id="contact-email" class="border-b-2 border-line bg-transparent px-0 py-3 text-lg font-normal outline-none transition-colors focus:border-cobalt" type="email" name="email" autocomplete="email" required /></label>
          <label class="grid gap-2 text-sm font-bold" for="contact-organization">Organization<input id="contact-organization" class="border-b-2 border-line bg-transparent px-0 py-3 text-lg font-normal outline-none transition-colors focus:border-cobalt" type="text" name="organization" autocomplete="organization" required /></label>
        </div>
        <label class="grid min-w-0 gap-2 text-sm font-bold" for="contact-context">Conversation context<select id="contact-context" class="min-h-14 w-full min-w-0 max-w-full border-b-2 border-line bg-transparent px-0 py-3 text-lg font-normal outline-none transition-colors focus:border-cobalt" name="conversation_context" required>
            <option value="" selected disabled>Select the closest context</option>
            <optgroup label="By topic">
              <option>AI/ML portfolio, lab, or operating model</option>
              <option>Data lab, platform, or AI cost management</option>
              <option>Frontier intelligence, quantum, or advanced systems</option>
              <option>Enterprise transformation and change architecture</option>
              <option>Institutional strategy, modernization, or resilience</option>
              <option>Research partnership or strategic inquiry</option>
            </optgroup>
            <optgroup label="By role">
              <option>Chief Executive or Board — strategic mandate</option>
              <option>Chief Technology or Information Officer — platform or architecture decision</option>
              <option>Chief Data or AI Officer — AI portfolio, data lab, or governance</option>
              <option>Government / Agency Executive — mission, modernization, or policy</option>
              <option>SLED Leader — state, local, or education institution</option>
              <option>Program or Portfolio Manager — transformation or change initiative</option>
              <option>Research or Academic Leader — frontier inquiry or institutional partnership</option>
            </optgroup>
          </select></label>
        <div id="contact-routing-hint" class="hidden rounded border border-cobalt/20 bg-cobalt/5 px-5 py-4 text-sm leading-relaxed text-cobalt" aria-live="polite"></div>
        <label class="grid gap-2 text-sm font-bold" for="contact-mandate">The mandate<textarea id="contact-mandate" class="min-h-44 resize-y border-b-2 border-line bg-transparent px-0 py-3 text-lg font-normal outline-none transition-colors focus:border-cobalt" name="mandate" placeholder="State the decision, the horizon, and what is at stake. Please do not include classified, export-controlled, or sensitive information in this form." required></textarea></label>
        <div class="grid gap-6 sm:grid-cols-2">
          <label class="grid min-w-0 gap-2 text-sm font-bold" for="contact-timing">Decision horizon<select id="contact-timing" class="min-h-14 w-full min-w-0 max-w-full border-b-2 border-line bg-transparent px-0 py-3 text-lg font-normal outline-none transition-colors focus:border-cobalt" name="decision_horizon"><option value="">Select if useful</option><option>Immediate / active decision</option><option>Next 90 days</option><option>2027–2028 horizon</option><option>2030–2035 horizon</option><option>Long-range research</option></select></label>
          <label class="grid min-w-0 gap-2 text-sm font-bold" for="contact-scale">Scale of the system<select id="contact-scale" class="min-h-14 w-full min-w-0 max-w-full border-b-2 border-line bg-transparent px-0 py-3 text-lg font-normal outline-none transition-colors focus:border-cobalt" name="system_scale"><option value="">Select if useful</option><option>Enterprise / institution</option><option>Portfolio / multi-program</option><option>Mission-critical platform</option><option>Research or emerging capability</option></select></label>
        </div>
        <label class="flex items-start gap-3 text-sm leading-relaxed text-muted" for="contact-consent"><input id="contact-consent" class="mt-1 size-4 accent-cobalt" type="checkbox" name="consent" value="yes" required />I agree to be contacted about this inquiry. I understand that this form is not a secure channel for classified or controlled information.</label>
        <button class="btn-dark w-fit" type="submit" data-track="contact_submit">Request the dialogue <span aria-hidden="true">↗</span></button>
      </form>
    </div>
  </section>

  <section class="bg-paper"><div class="container-site"><IntelligenceStack /></div></section>

  <section class="section-pad bg-ink text-white">
    <div class="container-site grid gap-10 lg:grid-cols-[.75fr_1.25fr] lg:items-end">
      <div><p class="eyebrow text-lime">The standard</p><h2 class="section-title mt-5 max-w-3xl">We are built for the questions that outlast a planning cycle.</h2></div>
      <div class="grid gap-6 text-lg leading-relaxed text-white/65 md:grid-cols-3 md:gap-8">
        <p><strong class="block text-white">Discretion.</strong> The right channel for the right level of context.</p>
        <p><strong class="block text-white">Precision.</strong> Clear hypotheses before a room is convened.</p>
        <p><strong class="block text-white">Composure.</strong> A steady hand when the system is moving quickly.</p>
      </div>
    </div>
  </section>

  <section class="section-pad bg-paper">
    <div class="container-site">
      <p class="eyebrow text-cobalt">Partner pathways</p>
      <h2 class="mt-6 font-display text-4xl font-medium tracking-[-0.05em] md:text-5xl">Not every need starts with Global Enterprise.</h2>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted">We work with a trusted network of partners for contexts where specialist capability, staffing, or emerging technology are the right first step.</p>
      <div class="mt-12 grid gap-8 md:grid-cols-3">
        <div class="border-t-2 border-cobalt pt-6">
          <p class="text-xs font-bold uppercase tracking-[0.14em] text-cobalt">Learning &amp; development</p>
          <h3 class="mt-4 font-display text-2xl font-medium tracking-[-0.04em]">Ignite Curiosity</h3>
          <p class="mt-4 text-sm leading-relaxed text-muted">Specialist in curiosity-driven learning design, capability programmes, and education-sector engagement. The right first conversation for K–12 curriculum innovation, staff learning journeys, and community-facing learning initiatives.</p>
          <a class="mt-6 inline-flex items-center gap-2 text-sm font-bold text-cobalt hover:underline" href="https://ignitecuriosity.org" target="_blank" rel="noopener noreferrer">Visit Ignite Curiosity <span aria-hidden="true">↗</span></a>
        </div>
        <div class="border-t-2 border-cobalt pt-6">
          <p class="text-xs font-bold uppercase tracking-[0.14em] text-cobalt">Talent &amp; staffing</p>
          <h3 class="mt-4 font-display text-2xl font-medium tracking-[-0.04em]">Tao Staff</h3>
          <p class="mt-4 text-sm leading-relaxed text-muted">Specialist staffing and talent placement for technology, AI, and transformation roles. The right first conversation when you need to build or augment a delivery team before the strategy engagement begins.</p>
          <a class="mt-6 inline-flex items-center gap-2 text-sm font-bold text-cobalt hover:underline" href="https://taostaff.com" target="_blank" rel="noopener noreferrer">Visit Tao Staff <span aria-hidden="true">↗</span></a>
        </div>
        <div class="border-t-2 border-cobalt pt-6">
          <p class="text-xs font-bold uppercase tracking-[0.14em] text-cobalt">Emerging ventures</p>
          <h3 class="mt-4 font-display text-2xl font-medium tracking-[-0.04em]">DreamLimited</h3>
          <p class="mt-4 text-sm leading-relaxed text-muted">Early-stage venture and product partner for AI-native ideas and frontier innovation. The right first conversation for founders and intrapreneurs who need structured thinking before a full transformation mandate is in view.</p>
          <a class="mt-6 inline-flex items-center gap-2 text-sm font-bold text-cobalt hover:underline" href="https://dreamlimited.co" target="_blank" rel="noopener noreferrer">Visit DreamLimited <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </div>
  </section>

  <script>
    const routingHints: Record<string, string> = {
      "Chief Executive or Board — strategic mandate": "A principal mandate session is the right starting point. Describe the decision, the horizon, and what is at stake.",
      "Chief Technology or Information Officer — platform or architecture decision": "Start with the platform or architecture question. Our data-lab and cloud practice maps the decision before selecting technology.",
      "Chief Data or AI Officer — AI portfolio, data lab, or governance": "Select AI/ML portfolio, lab, or operating model above, then describe the governance or cost challenge you are solving.",
      "Government / Agency Executive — mission, modernization, or policy": "Our federal public-service practice starts with mission and service promise before touching systems or procurement.",
      "SLED Leader — state, local, or education institution": "Our SLED practice is built for community accountability. Describe your resident-service or institution challenge and we will route you correctly.",
      "Program or Portfolio Manager — transformation or change initiative": "Our ITIL change-management practice works at programme scale. Describe the release, dependency, or adoption challenge.",
      "Research or Academic Leader — frontier inquiry or institutional partnership": "Our 501(c)(3) research partner INSTAR Lab Inc is the right channel for frontier research partnerships. Describe the inquiry.",
    };
    const select = document.getElementById("contact-context") as HTMLSelectElement | null;
    const hint = document.getElementById("contact-routing-hint") as HTMLDivElement | null;
    if (select && hint) {
      select.addEventListener("change", () => {
        const text = routingHints[select.value];
        if (text) {
          hint.textContent = text;
          hint.classList.remove("hidden");
        } else {
          hint.classList.add("hidden");
          hint.textContent = "";
        }
      });
    }
  </script>
</Base>
