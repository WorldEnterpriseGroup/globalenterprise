---
import Base from "@/layouts/Base.astro";
---

<Base title="Thank you | Global Enterprise" description="Your Global Enterprise inquiry has been received." noindex>
  <section class="bg-cobalt py-24 text-white md:py-36">
    <div class="container-site grid gap-12 lg:grid-cols-[1fr_.8fr] lg:items-end">
      <div>
        <p class="eyebrow text-lime">Message received</p>
        <h1 class="section-title mt-7 max-w-4xl">The next move is in motion.</h1>
        <p class="mt-8 max-w-2xl text-xl leading-relaxed text-white/75">Thank you for sharing the context. We will review it and come back with a useful next step.</p>
        <div class="mt-10 flex flex-wrap gap-4"><a class="btn-primary" href="/">Back to home <span aria-hidden="true">↗</span></a><a class="btn-ghost" href="/insights/">Read the signal <span aria-hidden="true">↗</span></a></div>
      </div>
      <div class="border-l-2 border-lime pl-6"><p class="eyebrow text-lime">While you wait</p><p class="mt-5 max-w-sm text-lg leading-relaxed text-white/70">Browse the work and perspectives that explain how we make complex systems more legible.</p></div>
    </div>
  </section>
</Base>
