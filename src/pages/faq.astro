---
import Base from "@/layouts/Base.astro";
import AssetImage from "@/components/AssetImage.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import { faqItems } from "@/data/site";
import FAQSchema from "@/components/FAQSchema.astro";
---

<Base title="Working with Global Enterprise | FAQ" description="The essentials for leaders considering a senior partnership across AI/ML, data labs, frontier intelligence, and enterprise change." image="/media/original/faq-empty-room.avif" keywords={["Global Enterprise FAQ", "enterprise AI advisory", "AI cost management", "data lab build out", "quantum intelligence"]}>
  <FAQSchema items={faqItems} />
  <section class="bg-cobalt py-20 text-white md:py-28"><div class="container-site grid gap-12 lg:grid-cols-[1fr_.72fr] lg:items-end"><div><p class="eyebrow text-lime">Working at the right level</p><h1 class="section-title mt-7 max-w-5xl">The questions worth asking before the first room.</h1><p class="mt-8 max-w-2xl text-xl leading-relaxed text-white/70">A concise view of our model, our standards, and the kind of context that makes a senior conversation useful.</p></div><div><div class="border border-white/20 p-6"><p class="eyebrow text-lime">The standard</p><p class="mt-5 font-display text-5xl font-medium tracking-[-0.07em]">No theater.</p><p class="mt-4 max-w-xs text-sm leading-relaxed text-white/65">Direct answers, precise boundaries, and a clear next move.</p></div><figure class="mt-8 overflow-hidden border border-white/20 bg-ink"><AssetImage src="/media/original/faq-empty-room.avif" width={1536} height={1024} loading="eager" decoding="async" alt="An empty meeting room with two chairs, folders, and morning light" class="aspect-[2.35/1] w-full object-cover opacity-90" /><figcaption class="border-t border-white/15 px-4 py-3 text-xs leading-relaxed text-white/60">The first room should feel clear before anyone enters it.</figcaption></figure></div></div></section>
  <section class="section-pad bg-white"><div class="container-site grid gap-12 lg:grid-cols-[.7fr_1.3fr] lg:gap-24"><SectionHeading eyebrow="The essentials" title="Useful before the first meeting." /><div class="divide-y divide-line border-y border-line">{faqItems.map((item) => <details class="group py-6"><summary class="flex cursor-pointer list-none items-center justify-between gap-8 font-display text-2xl font-medium tracking-[-0.04em] [&::-webkit-details-marker]:hidden">{item.question}<span class="text-cobalt transition-transform group-open:rotate-45">+</span></summary><p class="max-w-2xl pt-4 leading-relaxed text-muted">{item.answer}</p></details>)}</div></div></section>
  <section class="bg-lime"><div class="container-site flex flex-col gap-8 py-16 md:flex-row md:items-center md:justify-between"><h2 class="max-w-2xl font-display text-4xl font-medium tracking-[-0.05em]">Have a different question?</h2><a class="btn-dark" href="/contact/">Ask us directly <span aria-hidden="true">↗</span></a></div></section>
</Base>
