---
import Base from "@/layouts/Base.astro";
import EvidenceBand from "@/components/EvidenceBand.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import AssetImage from "@/components/AssetImage.astro";
import StartingPoint from "@/components/StartingPoint.astro";
import NewsletterSignup from "@/components/NewsletterSignup.astro";
import SystemMap from "@/components/SystemMap.astro";
import { getCollection } from "astro:content";
import { experienceHighlights, services, site } from "@/data/site";

const insights = (await getCollection("insights")).sort((a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0)).slice(0, 3);
const cases = await getCollection("caseStudies");
---

<Base title="Global Enterprise | Strategy for the next system" description={site.description}>
  <section class="hero-home">
    <AssetImage src="/media/generated/enterprise-hero.avif" width={1920} height={1280} loading="eager" decoding="async" alt="Modern city skyline seen from a strategy room" class="hero-home-image" />
    <div class="container-site relative z-10 flex min-h-[min(50rem,calc(100vh-1rem))] items-center py-28">
      <div class="max-w-2xl text-white">
        <p class="eyebrow text-lime">Global Enterprise · Strategy · Systems · Scale</p>
        <h1 class="display-title mt-8">Strategy for the <span class="text-white/90">next system.</span></h1>
        <p class="mt-7 max-w-xl text-lg leading-relaxed text-white/75">We help leaders make complex organizations easier to understand, easier to operate, and ready for what is changing next.</p>
        <div class="mt-9 flex flex-wrap gap-4"><a class="btn-primary bg-white" href="/contact/" data-track="hero_cta" data-track-label="Request a consultation">Request a consultation <span aria-hidden="true">↗</span></a><a class="btn-ghost text-white" href="/about/">Our approach <span aria-hidden="true">↗</span></a></div>
        <div class="mt-20 grid max-w-xl gap-6 border-t border-white/25 pt-6 text-sm text-white/65 sm:grid-cols-3"><div><p class="font-display text-lg uppercase tracking-[0.12em] text-white">Clarify</p><p class="mt-1">The mandate</p></div><div><p class="font-display text-lg uppercase tracking-[0.12em] text-white">Design</p><p class="mt-1">The system</p></div><div><p class="font-display text-lg uppercase tracking-[0.12em] text-white">Build</p><p class="mt-1">The capability</p></div></div>
      </div>
    </div>
  </section>

  <section class="border-b border-line bg-white py-8"><div class="container-site flex flex-wrap items-center justify-between gap-x-8 gap-y-4 text-sm text-muted"><span class="font-bold text-ink">Built for leaders operating at scale.</span><span>Enterprise services</span><span>Technology & data</span><span>Public sector</span><span>Education</span></div></section>

  <section class="section-pad bg-white"><div class="container-site grid gap-12 lg:grid-cols-[.8fr_1.2fr] lg:gap-24"><SectionHeading eyebrow="The mandate" title="When the stakes are high, clarity is a capability." /><div><p class="max-w-2xl text-2xl leading-snug tracking-[-0.03em] text-ink md:text-3xl">The hardest enterprise problems are rarely isolated. They sit between decisions, systems, and the people responsible for outcomes.</p><p class="body-copy mt-7 max-w-2xl">Global Enterprise brings senior strategy, architecture, and operating experience into one practical partnership. We help you see the system, choose the move, and make it durable.</p><a class="ink-link mt-8" href="/about/">How we work <span aria-hidden="true"></span></a></div></div></section>

  <StartingPoint />

  <SystemMap />

  <EvidenceBand eyebrow="Signals worth designing around" title="The public record is moving fast. Your operating model has to keep up." text="We use public evidence to sharpen the question, then work with leaders to turn it into a strategy that fits their mission, risk, and capacity." limit={4} />

  <section class="section-pad bg-white"><div class="container-site"><SectionHeading eyebrow="Why Global Enterprise" title="Experience that sits close to the consequence." text="Our perspective comes from working across the places where strategy becomes operational: federal missions, healthcare enterprises, technology platforms, and the people who have to carry change." /><div class="mt-14 grid gap-px border border-line bg-line md:grid-cols-3">{experienceHighlights.map((item) => <article class="bg-white p-8 md:p-10"><p class="font-display text-5xl font-medium tracking-[-0.06em] text-cobalt">{item.number}</p><h3 class="mt-12 font-display text-2xl font-medium tracking-[-0.04em]">{item.label}</h3><p class="mt-4 leading-relaxed text-muted">{item.text}</p></article>)}</div></div></section>

  <section class="section-pad bg-paper"><div class="container-site"><div class="flex flex-col justify-between gap-8 md:flex-row md:items-end"><SectionHeading eyebrow="Capabilities" title="A connected view of change." text="Choose the pressure point. We will connect it to the wider system." /><a class="btn-ghost shrink-0" href="/services/">View all capabilities <span aria-hidden="true">↗</span></a></div><div class="mt-14 divide-y divide-line border-y border-line">{services.slice(0, 4).map((service) => <a class="group grid gap-5 py-7 md:grid-cols-[4rem_1fr_auto] md:items-center" href={`/services/${service.slug}/`}><span class="font-display text-3xl text-cobalt">{service.number}</span><div><h3 class="font-display text-2xl font-medium tracking-[-0.04em] transition-colors group-hover:text-cobalt">{service.title}</h3><p class="mt-2 text-sm text-muted">{service.description}</p></div><span class="text-2xl transition-transform group-hover:translate-x-1 group-hover:-translate-y-1" aria-hidden="true">↗</span></a>)}</div></div></section>

  <section class="section-pad bg-white"><div class="container-site"><div class="flex flex-col justify-between gap-8 md:flex-row md:items-end"><SectionHeading eyebrow="Selected work" title="Progress that survives the presentation." text="A few field notes from the work of making enterprise systems more useful." /><a class="btn-ghost shrink-0" href="/case-studies/">View all work <span aria-hidden="true">↗</span></a></div><div class="mt-14 grid gap-8 lg:grid-cols-3">{cases.map((entry, index) => <a class="group" href={`/case-studies/${entry.id}/`}><div class:list={["relative overflow-hidden rounded-2xl bg-cobalt", index === 0 ? "aspect-[4/3] lg:col-span-2" : "aspect-[4/3]"]}><AssetImage src={entry.data.image ?? "/media/generated/enterprise-hero.avif"} width={1024} height={768} loading="lazy" decoding="async" alt={entry.data.title} class="h-full w-full object-cover opacity-80 grayscale transition duration-500 group-hover:scale-105 group-hover:opacity-100 group-hover:grayscale-0" /><div class="absolute inset-0 bg-gradient-to-t from-ink/70 via-transparent to-transparent"></div><span class="absolute bottom-5 left-5 rounded-full border border-white/35 px-3 py-1.5 text-xs font-bold uppercase tracking-[0.1em] text-white">{entry.data.sector}</span></div><p class="mt-5 text-xs font-bold uppercase tracking-[0.12em] text-cobalt">{entry.data.service}</p><h3 class="mt-2 font-display text-2xl font-medium tracking-[-0.04em] transition-colors group-hover:text-cobalt">{entry.data.title}</h3></a>)}</div></div></section>

  <section class="section-pad bg-ink text-white"><div class="container-site grid gap-12 lg:grid-cols-[.75fr_1.25fr] lg:gap-24"><div><p class="eyebrow text-lime">Perspective</p><h2 class="section-title mt-5">Useful ideas for the people carrying the next move.</h2><a class="btn-primary mt-8" href="/insights/">Explore insights <span aria-hidden="true">↗</span></a></div><div class="divide-y divide-white/15 border-y border-white/15">{insights.map((insight) => <a class="group block py-6" href={`/insights/${insight.id}/`}><div class="flex items-start justify-between gap-5"><div><p class="text-xs uppercase tracking-[0.12em] text-white/50">{insight.data.category} · {insight.data.readingTime}</p><h3 class="mt-3 max-w-xl font-display text-2xl font-medium tracking-[-0.04em] transition-colors group-hover:text-lime">{insight.data.title}</h3></div><span class="text-xl transition-transform group-hover:translate-x-1 group-hover:-translate-y-1" aria-hidden="true">↗</span></div></a>)}</div></div></section>

  <NewsletterSignup dark />

  <section class="bg-lime"><div class="container-site flex flex-col gap-8 py-16 md:flex-row md:items-center md:justify-between"><div><p class="eyebrow text-ink">Start with the real question</p><h2 class="mt-5 max-w-3xl font-display text-4xl font-medium tracking-[-0.05em] md:text-5xl">Bring us the hard thing.</h2></div><a class="btn-dark shrink-0" href="/contact/">Request a consultation <span aria-hidden="true">↗</span></a></div></section>
</Base>
