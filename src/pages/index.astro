---
import Base from "@/layouts/Base.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import StartingPoint from "@/components/StartingPoint.astro";
import GlobalPlatformLandscape from "@/components/GlobalPlatformLandscape.astro";
import MediaInterlude from "@/components/MediaInterlude.astro";
import SystemMap from "@/components/SystemMap.astro";
import AssetImage from "@/components/AssetImage.astro";
import { getCollection } from "astro:content";
import { businessReports, experienceHighlights, regionContexts, services, site } from "@/data/site";
import { type EvidenceSource, resolveEvidenceSource } from "@/data/evidence-routes";

const insightEntries = await getCollection("insights");
const serviceEntries = await getCollection("servicePages");
const insights = insightEntries.filter((entry) => !entry.data.draft).sort((a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0)).slice(0, 3);
const cases = (await getCollection("caseStudies")).filter((entry) => !entry.data.draft);
const featuredReports = businessReports.slice(0, 3);
const horizonInsight = insightEntries.find((entry) => entry.id === "the-path-to-2050-is-an-operating-model");
const integrationService = serviceEntries.find((entry) => entry.id === "mergers-acquisitions");
const mnaService = services.find((service) => service.slug === "mergers-acquisitions");
const changeService = services.find((service) => service.slug === "transformation-office");
type SourceInput = Pick<EvidenceSource, "url" | "label">;

const integrationSurfaces = [
  {
    label: "Physical + energy",
    title: "Make the load-bearing layer visible.",
    text: "Power, cooling, facilities, transmission, spectrum, orbit, maintenance, and supply-chain dependencies determine whether the asset can work at all.",
    href: "/industries/energy-infrastructure/",
  },
  {
    label: "Satellite, telecom + global communications",
    title: "Treat reach as a service, not an asset count.",
    text: "Trace terrestrial and satellite paths, network diversity, latency, availability, coverage, sovereignty, and partner exposure across the combined system.",
    href: "/industries/technology-data/",
  },
  {
    label: "Data + intelligence",
    title: "Keep evidence attached to authority.",
    text: "Make ownership, provenance, access, quality, evaluation, cybersecurity, and human review explicit before a new capability enters the workflow.",
    href: "/services/cloud-data/",
  },
  {
    label: "Global finance + capital",
    title: "Move capital to the constraint.",
    text: "Follow cash flows, funding gates, insurance, liquidity, capital allocation, and the value of optionality under uncertainty—not just the synergy slide.",
    href: "/services/mergers-acquisitions/",
  },
  {
    label: "Marketing + customer systems",
    title: "Make the promise travel.",
    text: "The brand, channel, pricing, language, regulatory boundary, and adoption friction determine whether a combined capability becomes useful in each market.",
    href: "/services/operating-model/",
  },
  {
    label: "ITIL service + change",
    title: "Make the combined capability supportable.",
    text: "Service ownership, incidents, problems, changes, configuration, releases, continuity, knowledge, and continual improvement keep integration from becoming unrecorded exceptions.",
    href: "/services/transformation-office/",
  },
];

const scorecardMeasures = [
  { measure: "Time from signal to an authorized decision", question: "Can the combined system turn information into accountable action?", href: "/services/operating-model/" },
  { measure: "Service availability, recovery time, and change failure rate", question: "Can service ownership carry the integration through release and failure?", href: "/services/transformation-office/" },
  { measure: "Energy used per unit of useful computation or delivered service", question: "Does additional capability convert energy into useful service?", href: "/industries/energy-infrastructure/" },
  { measure: "Connectivity reach and quality by market, region, and customer segment", question: "Can satellite, telecom, and terrestrial paths deliver the intended reach?", href: "/industries/technology-data/" },
  { measure: "Critical data with an owner, provenance, access rule, and refresh expectation", question: "Can finance, operations, and leaders trust the inputs?", href: "/services/cloud-data/" },
  { measure: "Customer retention and adoption by market, channel, and language", question: "Does the marketing and customer system make the promise adoptable across borders?", href: "/services/operating-model/" },
  { measure: "Capital deployed against the constraint that limits growth", question: "Is global finance moving capital to the actual bottleneck?", href: "/services/mergers-acquisitions/" },
];

const sourceLinks = [...(horizonInsight?.data.sources ?? []), ...(integrationService?.data.sources ?? [])] as SourceInput[];
const mappedSourceLinks = sourceLinks.map((source) => resolveEvidenceSource(source)).filter(
  (source, index, sources) => sources.findIndex((candidate) => candidate.displayUrl === source.displayUrl) === index,
);
const decisionHubs = [
  {
    city: "Africa",
    region: "Middle East & Africa",
    image: "/media/original/home-global-digital-infrastructure-v2.avif",
    imageAlt: "A hyperscale digital infrastructure campus connected to the energy and skyline of a major city",
  },
  {
    city: "North America",
    region: "North America",
    image: "/media/original/home-global-institution-v2.avif",
    imageAlt: "The grand interior of an international institution overlooking a global city",
  },
  {
    city: "Europe",
    region: "Europe",
    image: "/media/original/home-global-institutions-v2.avif",
    imageAlt: "A major international capital where government institutions, corporate towers, transit, bridges, and waterways meet",
  },
  {
    city: "Latin America & Caribbean",
    region: "Latin America & the Caribbean",
    image: "/media/original/home-mandate-global-v2.avif",
    imageAlt: "A monumental international government and corporate district in morning light",
  },
  {
    city: "South America",
    region: "South America",
    image: "/media/original/home-global-nexus-v2.avif",
    imageAlt: "A major international transport nexus connecting an airport, rail corridors, and a global city",
  },
  {
    city: "Asia-Pacific",
    region: "Asia-Pacific",
    image: "/media/original/home-global-port-v2.avif",
    imageAlt: "A vast international container port and intermodal logistics network beside a global city",
  },
].map((hub) => ({ ...hub, context: regionContexts.find((context) => context.name === hub.region) }));
---

<Base title="Global Enterprise | Global operating systems for infrastructure and public missions" description={site.description} image="/media/hero-city.avif">
<div class="home-compact home-homepage-3k">
  <section class="hero-home">
    <AssetImage src="/media/original/hero-city.avif" width={1600} height={900} loading="eager" fetchpriority="high" decoding="async" sizes="100vw" alt="A global city skyline in clear morning light" class="hero-home-image" />
    <div class="hero-home-content container-site relative z-10 flex min-h-[min(38rem,calc(100vh-1rem))] items-center py-14">
      <div class="max-w-3xl text-white">
        <p class="eyebrow text-lime">Global strategy and operating systems for frontier infrastructure.</p>
        <h1 class="display-title mt-6">A global enterprise for corporations, government systems, and civic institutions assembling long-horizon capability.</h1>
        <p class="mt-5 max-w-2xl text-base leading-relaxed text-white/75">We connect boards, operators, and policy environments through M&amp;A, solution strategy, and service discipline across energy, communications, finance, and national-scale operations.</p>
        <div class="mt-7 flex flex-wrap gap-4"><a class="btn-primary bg-white" href="/contact/" data-track="hero_cta" data-track-label="Request a leadership engagement">Request a leadership engagement <span aria-hidden="true">↗</span></a><a class="btn-ghost text-white" href="/resources/" data-track="hero_cta" data-track-label="Explore business reports">Explore business reports <span aria-hidden="true">↗</span></a></div>
        <div class="mt-14 grid max-w-2xl gap-6 border-t border-white/25 pt-6 text-sm text-white/65 sm:grid-cols-3"><a class="home-hero-stat" href="/operations/"><p class="font-display text-lg uppercase tracking-[0.12em] text-white">Global scale</p><p class="mt-1">Markets and cities <span aria-hidden="true">↗</span></p></a><a class="home-hero-stat" href="/industries/"><p class="font-display text-lg uppercase tracking-[0.12em] text-white">Consequence</p><p class="mt-1">Institutions and missions <span aria-hidden="true">↗</span></p></a><a class="home-hero-stat" href="/services/"><p class="font-display text-lg uppercase tracking-[0.12em] text-white">Operating depth</p><p class="mt-1">Systems and infrastructure <span aria-hidden="true">↗</span></p></a></div>
      </div>
    </div>
  </section>

  <section class="border-b border-line bg-white py-8"><div class="container-site flex flex-wrap items-center justify-between gap-x-8 gap-y-4 text-sm text-muted"><a class="home-thesis-link font-bold text-ink" href="/services/mergers-acquisitions/">The integration thesis comes first. <span aria-hidden="true">↗</span></a><a class="home-thesis-link" href="/services/mergers-acquisitions/">M&amp;A and operating integration <span aria-hidden="true">↗</span></a><a class="home-thesis-link" href="/industries/energy-infrastructure/">Energy and communications infrastructure <span aria-hidden="true">↗</span></a><a class="home-thesis-link" href="/services/operating-model/">Global finance and market systems <span aria-hidden="true">↗</span></a><a class="home-thesis-link" href="/services/transformation-office/">ITIL service continuity <span aria-hidden="true">↗</span></a></div></section>

  <MediaInterlude
    src="/media/original/home-mandate-global-v2.avif"
    alt="A monumental international government and corporate district in morning light"
    eyebrow="The mandate"
    caption="The mandate spans institutions, markets, and public systems. The operating model has to carry that scale."
    tone="white"
    ratio="wide"
    position="50% 30%"
    className="media-interlude-mandate"
    showEyebrow={false}
  >
    <SectionHeading eyebrow="The mandate" title="When global enterprises assemble capability across borders, the integration thesis becomes infrastructure." />
    <div class="mt-9"><p class="max-w-2xl text-2xl leading-snug tracking-[-0.03em] text-ink md:text-3xl">The hardest problems are not isolated technology decisions. They are questions of how capital, energy, communications, finance, marketing systems, and AI become one service without losing judgment, trust, or control.</p><p class="body-copy mt-7 max-w-2xl">Global Enterprise treats M&amp;A as an operating-model question: what capability is being assembled, which constraints govern it, and what service discipline can carry it across markets and time.</p><a class="ink-link mt-8" href="/about/">Our point of view <span aria-hidden="true"></span></a></div>
  </MediaInterlude>

  <details class="home-collapse-block" open>
    <summary class="home-collapse-summary">
      <div class="container-site section-pad">
        <p class="eyebrow text-cobalt">Operating design</p>
        <h2 class="section-title mt-5 max-w-4xl">The standard travels. The context changes.</h2>
        <p class="mt-7 max-w-3xl">The full operating-model narrative is right here, but collapsible. Expand only what your team needs now, or continue into each route for deeper context.</p>
        <div class="home-collapse-cta-wrap">
          <a class="btn-dark" href="/operations/" data-track="home_collapsed_cta" data-track-label="operations">Explore operations <span aria-hidden="true">↗</span></a>
          <a class="btn-ghost" href="/services/" data-track="home_collapsed_cta" data-track-label="services">Explore services <span aria-hidden="true">↗</span></a>
          <a class="btn-ghost" href="/about/" data-track="home_collapsed_cta" data-track-label="about">About the operating thesis <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </summary>
    <div class="home-collapse-content">
      <section class="section-pad bg-white" aria-labelledby="home-hubs-title">
        <div class="container-site">
          <div class="grid gap-10 lg:grid-cols-[.72fr_1.28fr] lg:items-end lg:gap-24">
            <div>
              <p class="eyebrow text-cobalt">Global decision hubs</p>
              <h2 id="home-hubs-title" class="section-title mt-5 max-w-3xl">Regional operating contexts. One integration thesis.</h2>
            </div>
            <p class="body-copy max-w-3xl">We read cross-border transformation through the regions where capital, infrastructure, regulation, communications, and customer demand meet differently. Africa, the Caribbean, Latin America, and South America are represented directly through our global network, with representative channels in London, New York, Hong Kong, and Dubai. City names are perspective inputs, not claims of physical office footprint.</p>
          </div>
          <div class="mt-14 grid gap-px border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
            {decisionHubs.map((hub) => (
              <a class="home-hub-card bg-white" href={hub.context ? `/region/${hub.context.slug}/` : "/operations/"}>
                <div class="home-hub-media">
                  <AssetImage src={hub.image} width={1536} height={1024} alt={hub.imageAlt} class="home-hub-image" loading="lazy" decoding="async" sizes="(min-width: 1024px) 25vw, 50vw" />
                </div>
                <div class="home-hub-copy">
                  <p class="eyebrow text-cobalt">{hub.region}</p>
                  <h3 class="mt-10 font-display text-3xl font-medium tracking-[-0.05em]">{hub.city}</h3>
                  <p class="mt-4 font-display text-xl leading-tight tracking-[-0.03em]">{hub.context?.title ?? "A connected operating context."}</p>
                  <p class="mt-4 text-sm leading-relaxed text-muted">{hub.context?.description ?? "A context lens for decisions that cross markets, institutions, and infrastructure."}</p>
                </div>
              </a>
            ))}
          </div>
          <p class="mt-6 text-xs leading-relaxed text-muted">Context note: the hub names identify operating perspectives used in this narrative. They do not establish physical offices. Representatives and advisory channels are active across Africa, the Caribbean, Latin America, South America, and the broader global network.</p>
          <div class="home-hub-footnote mt-6 flex flex-wrap gap-3">
            <a class="btn-dark" href="/operations/">Explore region-driven operations <span aria-hidden="true">↗</span></a>
            <a class="btn-ghost" href="/services/mergers-acquisitions/">View M&amp;A integration routes <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </section>

      <StartingPoint mediaSrc="/media/original/home-global-nexus-v2.avif" mediaAlt="A major international transport nexus connecting an airport, rail corridors, and a global city" mediaCaption="Start with the whole operating system: institutions, infrastructure, capital, and movement at metropolitan scale." mediaRatio="wide" />

      <GlobalPlatformLandscape />
    </div>
  </details>

  <details class="home-collapse-block">
    <summary class="home-collapse-summary">
      <div class="container-site section-pad">
        <p class="eyebrow text-cobalt">Thesis and integration</p>
        <h2 class="section-title mt-5 max-w-4xl">Capability emerges where strategy, systems, and operations are integrated.</h2>
        <p class="mt-7 max-w-3xl">Expand this block when you want the full thesis and M&amp;A architecture context, or continue straight to route pages with deeper evidence and implementation detail.</p>
        <div class="home-collapse-cta-wrap">
          <a class="btn-dark" href="/insights/" data-track="home_collapsed_cta" data-track-label="insights">Explore insights <span aria-hidden="true">↗</span></a>
          <a class="btn-ghost" href="/services/mergers-acquisitions/" data-track="home_collapsed_cta" data-track-label="ma">Explore M&amp;A operating integration <span aria-hidden="true">↗</span></a>
          <a class="btn-ghost" href="/services/transformation-office/" data-track="home_collapsed_cta" data-track-label="transformation">Explore change operating model <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </summary>
    <div class="home-collapse-content">
      <section class="section-pad bg-paper home-thesis" aria-labelledby="home-thesis-title">
        <div class="container-site">
          <div class="grid gap-10 lg:grid-cols-[1.08fr_.92fr] lg:items-end lg:gap-24">
            <div>
              <p class="eyebrow text-cobalt">The 2050 thesis</p>
              <h2 id="home-thesis-title" class="section-title mt-5 max-w-4xl">By 2050, capability will be judged by what the combined system can make reliable.</h2>
              <p class="body-copy mt-7 max-w-3xl">{horizonInsight?.data.description ?? "M&A, energy, communications, and machine intelligence are becoming one infrastructure question: can civilization compound capability without losing control?"}</p>
            </div>
            <aside class="home-thesis-boundary" aria-label="Kardashev thesis boundary">
              <p class="eyebrow text-cobalt">A forcing lens, not a forecast</p>
              <h3 class="mt-4 font-display text-3xl font-medium tracking-[-0.05em]">Kardashev is a direction, not a dashboard.</h3>
              <p class="mt-4 text-sm leading-relaxed text-muted">The Kardashev scale is a speculative lens for thinking about energy use. It is not a corporate maturity score or permission to consume without limits. The useful question is whether more energy becomes more useful, resilient, and widely available capability without losing human control.</p>
            </aside>
          </div>

          <div class="mt-12 grid gap-px border border-line bg-line sm:grid-cols-3" aria-label="Current system signals">
            <a class="home-signal-card bg-white p-6 md:p-7" href="/insights/un-desa-population-scale-is-an-operating-constraint/">
              <p class="font-display text-4xl font-medium tracking-[-0.06em] text-cobalt">9.6B</p>
              <h3 class="mt-5 font-display text-xl font-medium tracking-[-0.04em]">people projected in 2050</h3>
              <p class="mt-3 text-sm leading-relaxed text-muted">UN DESA medium projection. Population scale changes the infrastructure question.</p>
              <span class="mt-5 inline-flex text-xs font-bold uppercase tracking-[0.1em] text-cobalt underline decoration-cobalt/30 underline-offset-4">UN DESA ↗</span>
            </a>
            <a class="home-signal-card bg-white p-6 md:p-7" href="/insights/itu-connectivity-is-not-access/">
              <p class="font-display text-4xl font-medium tracking-[-0.06em] text-cobalt">6B / 2.2B</p>
              <h3 class="mt-5 font-display text-xl font-medium tracking-[-0.04em]">online / offline</h3>
              <p class="mt-3 text-sm leading-relaxed text-muted">ITU latest estimate. Reach still depends on quality, affordability, skills, and geography.</p>
              <span class="mt-5 inline-flex text-xs font-bold uppercase tracking-[0.1em] text-cobalt underline decoration-cobalt/30 underline-offset-4">ITU ↗</span>
            </a>
            <a class="home-signal-card bg-white p-6 md:p-7" href="/insights/iea-energy-and-ai-grid-capacity/">
              <p class="font-display text-4xl font-medium tracking-[-0.06em] text-cobalt">945 TWh</p>
              <h3 class="mt-5 font-display text-xl font-medium tracking-[-0.04em]">data-centre electricity by 2030</h3>
              <p class="mt-3 text-sm leading-relaxed text-muted">IEA projection. Digital expansion is also a power, grid, permitting, and resilience decision.</p>
              <span class="mt-5 inline-flex text-xs font-bold uppercase tracking-[0.1em] text-cobalt underline decoration-cobalt/30 underline-offset-4">IEA ↗</span>
            </a>
          </div>

          <div class="home-thesis-grid mt-14">
            <a class="home-thesis-card" href="/services/operating-model/">
              <span class="home-thesis-card-index" aria-hidden="true">01</span>
              <h3>Capability, not accumulation</h3>
              <p>A bigger data centre, larger constellation, or faster acquisition is not automatically progress. The test is lower friction between energy and useful work, broader access, better recovery, and governance that keeps pace with the power assembled.</p>
            </a>
            <a class="home-thesis-card" href="/services/mergers-acquisitions/">
              <span class="home-thesis-card-index" aria-hidden="true">02</span>
              <h3>M&A as integration</h3>
              <p>A transaction can combine a communications network with a satellite platform, a finance business with a data capability, an industrial operator with an energy asset, or a global brand with a distribution system. The point is a capability neither side could operate as effectively alone.</p>
            </a>
            <a class="home-thesis-card" href="/services/transformation-office/">
              <span class="home-thesis-card-index" aria-hidden="true">03</span>
              <h3>The operating model is the bridge</h3>
              <p>Energy, computation, communications, capital, and human capability only compound when ownership, evidence, service discipline, and local context travel with the strategy.</p>
            </a>
          </div>

          <div class="home-source-note mt-10">
            <p><strong>Evidence trail.</strong> This homepage distills the existing <a href={horizonInsight ? `/insights/${horizonInsight.id}/` : "/insights/"}>2050 thesis</a> and <a href={integrationService ? "/services/mergers-acquisitions/" : "/services/"}>M&amp;A integration capability</a>; external source notes and review dates remain on those routes.</p>
            {mappedSourceLinks.length > 0 && <div class="home-source-links" aria-label="Sources for the 2050 thesis">{mappedSourceLinks.map((source) => <a href={source.displayUrl}>{source.label} <span aria-hidden="true">↗</span></a>)}</div>}
          </div>
        </div>
      </section>

      <section class="section-pad bg-white home-integration" aria-labelledby="home-integration-title">
        <div class="container-site">
          <div class="grid gap-10 lg:grid-cols-[.72fr_1.28fr] lg:items-end lg:gap-24">
            <div>
              <p class="eyebrow text-cobalt">Cross-border M&amp;A</p>
              <h2 id="home-integration-title" class="section-title mt-5 max-w-3xl">Make the integration thesis visible before the integration plan.</h2>
            </div>
            <div>
              <p class="body-copy max-w-3xl">{integrationService?.data.description ?? "Design the integration thesis that turns a transaction into a more capable cross-border operating system."}</p>
              <p class="mt-5 max-w-3xl text-sm leading-relaxed text-muted">Financial diligence remains necessary, but it cannot answer the whole question. The combined system also joins networks, energy exposure, data, brands, talent, service commitments, regulatory obligations, and the decision rights that keep those parts coherent.</p>
              <a class="ink-link mt-7" href="/services/mergers-acquisitions/">{mnaService?.title ?? "Explore M&amp;A and operating integration"} <span aria-hidden="true"></span></a>
            </div>
          </div>

          <ol class="home-integration-grid mt-14" aria-label="Six integration surfaces">
            {integrationSurfaces.map((surface, index) => (
              <li>
                <a class="home-integration-surface" href={surface.href}>
                  <span class="home-integration-index" aria-hidden="true">0{index + 1}</span>
                  <p class="eyebrow text-cobalt">{surface.label}</p>
                  <h3>{surface.title}</h3>
                  <p>{surface.text}</p>
                </a>
              </li>
            ))}
          </ol>

          <div class="home-measurement mt-16">
            <div class="grid gap-8 lg:grid-cols-[.72fr_1.28fr] lg:items-end lg:gap-24">
              <div>
                <p class="eyebrow text-cobalt">Measure the capability</p>
                <h3 class="mt-5 font-display text-4xl font-medium tracking-[-0.05em] md:text-5xl">Value is a service outcome.</h3>
              </div>
              <p class="max-w-3xl text-lg leading-relaxed text-muted">A post-close scorecard should show whether the combined system is becoming more capable, not only whether integration activities are complete.</p>
            </div>
            <div class="home-measurement-table-wrap mt-10" tabindex="0" role="region" aria-label="Suggested operating scorecard">
              <table class="home-measurement-table">
                <caption>Suggested operating measures from the existing M&amp;A and 2050 thesis. These are measures to design, not reported outcomes.</caption>
                <thead><tr><th scope="col">Measure</th><th scope="col">Question it keeps visible</th></tr></thead>
                <tbody>{scorecardMeasures.map((item) => <tr><th scope="row"><a href={item.href}>{item.measure} <span aria-hidden="true">↗</span></a></th><td>{item.question}</td></tr>)}</tbody>
              </table>
            </div>
            <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm">
              <a class="ink-link" href={changeService ? "/services/transformation-office/" : "/services/"}>{changeService?.title ?? "Explore ITIL change management"} <span aria-hidden="true"></span></a>
              <p class="text-muted">Measurement language is a planning frame, not a claim of client performance.</p>
            </div>
          </div>
        </div>
      </section>

    <SystemMap mediaSrc="/media/original/home-field-controls.avif" mediaAlt="Rail, utility pipes, and power lines crossing a river at dawn" mediaCaption="The system is not an abstraction. It is a set of physical and human dependencies." />
    </div>
  </details>

  <details class="home-collapse-block">
    <summary class="home-collapse-summary">
      <div class="container-site section-pad">
        <p class="eyebrow text-cobalt">Evidence and perspectives</p>
        <h2 class="section-title mt-5 max-w-4xl">Decision-ready proof points, case work, and perspective capsules.</h2>
        <p class="mt-7 max-w-3xl">Keep this block open for the full evidence stack, or use the route buttons to jump to deeper exploration.</p>
        <div class="home-collapse-cta-wrap">
          <a class="btn-dark" href="/resources/" data-track="home_collapsed_cta" data-track-label="resources">Browse reports <span aria-hidden="true">↗</span></a>
          <a class="btn-ghost" href="/work/" data-track="home_collapsed_cta" data-track-label="work">View selected work <span aria-hidden="true">↗</span></a>
          <a class="btn-ghost" href="/insights/" data-track="home_collapsed_cta" data-track-label="insights-all">See all insights <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </summary>
    <div class="home-collapse-content">
    <section class="section-pad bg-white">
      <div class="container-site grid gap-12 lg:grid-cols-[.72fr_1.28fr] lg:gap-24">
      <div>
        <p class="eyebrow text-cobalt">Decision-ready business reports</p>
        <h2 class="section-title mt-5">Research built to enter the working session.</h2>
        <p class="mt-6 max-w-xl leading-relaxed text-muted">Concise operating briefs for leaders deciding how to govern AI, sequence modernization, and make institutional decisions move.</p>
