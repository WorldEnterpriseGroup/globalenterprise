---
import Base from "@/layouts/Base.astro";
import EvidenceBand from "@/components/EvidenceBand.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import SignalIcon from "@/components/SignalIcon.astro";
import AssetImage from "@/components/AssetImage.astro";
import { industries } from "@/data/site";
---

<Base title="Industries | Global Enterprise" description="Global Enterprise supports enterprise services, technology and data, public sector, and education leaders through complex change." keywords={["industry consulting", "federal consulting", "healthcare transformation", "energy infrastructure strategy", "enterprise AI consulting"]}>
  <section class="bg-ink py-20 text-white md:py-28"><div class="container-site grid gap-12 lg:grid-cols-[1fr_.8fr] lg:items-end"><div><p class="eyebrow text-lime">Industries</p><h1 class="section-title mt-7 max-w-5xl">Context changes the answer.</h1><p class="mt-8 max-w-2xl text-xl leading-relaxed text-white/65">We bring a cross-sector view to the work, then take the time to understand the constraints that make your environment different.</p></div><div class="relative overflow-hidden bg-cobalt"><AssetImage src="/media/generated/federal-mission.avif" width={1536} height={1024} loading="eager" decoding="async" alt="Leaders reviewing a cross-sector transformation agenda" class="aspect-[4/3] w-full object-cover opacity-90" /><div class="absolute inset-x-0 bottom-0 bg-ink/75 p-4 text-xs uppercase tracking-[0.12em] text-white/65">Seven contexts · one discipline: make the system work</div></div></div></section>
  <section class="section-pad bg-white"><div class="container-site"><SectionHeading eyebrow="Where we work" title="Deep enough to be useful. Broad enough to see the pattern." /><div class="mt-14 grid gap-px border border-line bg-line md:grid-cols-2">{industries.map((industry) => <a class="group bg-white p-5 transition-colors hover:bg-cobalt hover:text-white md:p-8" href={industry.href}><div class="relative overflow-hidden bg-cobalt"><AssetImage src={industry.image} width={1536} height={1024} loading="lazy" decoding="async" alt={`${industry.title} strategic context`} class="aspect-[2.4/1] w-full object-cover opacity-85 transition duration-500 group-hover:scale-105 group-hover:opacity-100" /></div><div class="flex items-start justify-between gap-5 pt-7"><div><span class="font-display text-3xl text-cobalt transition-colors group-hover:text-lime">{industry.number}</span><h2 class="mt-8 font-display text-3xl font-medium tracking-[-0.04em]">{industry.title}</h2></div><SignalIcon name={industry.number === "7" ? "pulse" : industry.number === "6" ? "compass" : "system"} size={25} /></div><p class="mt-4 max-w-md leading-relaxed text-muted transition-colors group-hover:text-white/70">{industry.description}</p><p class="mt-6 border-t border-line/70 pt-4 text-xs font-bold uppercase leading-relaxed tracking-[0.1em] text-cobalt transition-colors group-hover:border-white/25 group-hover:text-lime">{industry.sourceLabel}</p><span class="mt-7 inline-flex text-xl transition-transform group-hover:translate-x-1 group-hover:-translate-y-1" aria-hidden="true">↗</span></a>)}</div></div></section>
  <EvidenceBand eyebrow="Across the sectors" title="The evidence changes the question." text="Sector context matters because the consequences are different. We use public research, operating experience, and the organization’s own signals to find the decision beneath the problem." limit={5} />
  <section class="section-pad bg-paper"><div class="container-site grid gap-12 lg:grid-cols-[.8fr_1.2fr] lg:gap-24"><SectionHeading eyebrow="The future agenda" title="What has to be true for this system to work?" /><div><p class="max-w-2xl text-2xl leading-snug tracking-[-0.03em] text-ink md:text-3xl">That question travels across sectors. The answer is always shaped by the mission, the people, and the decisions the organization has to make next.</p><div class="mt-10 grid gap-5 sm:grid-cols-3"><div class="border-t border-line pt-4"><p class="text-xs font-bold uppercase tracking-[0.12em] text-cobalt">AI</p><p class="mt-3 text-sm leading-relaxed text-muted">Scale with measurement, governance, and an accountable human role.</p></div><div class="border-t border-line pt-4"><p class="text-xs font-bold uppercase tracking-[0.12em] text-cobalt">Resilience</p><p class="mt-3 text-sm leading-relaxed text-muted">Design continuity into the platform, supplier, and workforce system.</p></div><div class="border-t border-line pt-4"><p class="text-xs font-bold uppercase tracking-[0.12em] text-cobalt">Capability</p><p class="mt-3 text-sm leading-relaxed text-muted">Build the skills and decision rights the future model actually requires.</p></div></div></div></div></section>
  <section class="bg-lime"><div class="container-site flex flex-col gap-8 py-16 md:flex-row md:items-center md:justify-between"><h2 class="max-w-2xl font-display text-4xl font-medium tracking-[-0.05em]">Talk to us about the context behind the problem.</h2><a class="btn-dark shrink-0" href="/contact/">Start a conversation <span aria-hidden="true">↗</span></a></div></section>
</Base>
