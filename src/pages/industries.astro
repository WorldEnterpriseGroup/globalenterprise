---
import Base from "@/layouts/Base.astro";
import EvidenceBand from "@/components/EvidenceBand.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import SignalChart from "@/components/SignalChart.astro";
import AssetImage from "@/components/AssetImage.astro";
import { industries } from "@/data/site";
---

<Base title="Future contexts | Global Enterprise" description="Global Enterprise works across the systems where intelligence, infrastructure, technology, human capability, and digital institutions compound." image="/media/generated/energy-grid.avif" keywords={["future-facing consulting", "AI-native operating model", "frontier intelligence strategy", "resilient infrastructure strategy", "enterprise transformation"]}>
  <section class="bg-ink py-20 text-white md:py-28"><div class="container-site grid gap-12 lg:grid-cols-[1fr_.8fr] lg:items-end"><div><p class="eyebrow text-lime">Future contexts</p><h1 class="section-title mt-7 max-w-5xl">The sectors will change. The underlying questions will not.</h1><p class="mt-8 max-w-2xl text-xl leading-relaxed text-white/65">We work across the systems where intelligence, infrastructure, technology, and human judgment compound. The context changes the expression; the discipline remains rigorous.</p></div><figure class="relative overflow-hidden bg-cobalt"><AssetImage src="/media/generated/energy-grid.avif" width={1536} height={1024} loading="eager" fetchpriority="high" decoding="async" sizes="(min-width: 1024px) 42vw, 100vw" alt="Operators watching an energy landscape through a control-room window" class="aspect-[16/9] w-full object-cover opacity-90" /><figcaption class="absolute inset-x-0 bottom-0 bg-ink/75 p-4 text-xs uppercase tracking-[0.12em] text-white/65">Eight future contexts · one discipline: make the system worthy of trust</figcaption></figure></div></section>
  <section class="section-pad bg-white"><div class="container-site"><SectionHeading eyebrow="Where we work" title="Deep enough to be useful. Broad enough to see the pattern." /><div class="mt-14 divide-y divide-line border-y border-line">{industries.map((industry) => <a class="group grid gap-5 py-7 md:grid-cols-[4rem_1fr_1.2fr_auto] md:items-center" href={industry.href}><span class="font-display text-4xl text-cobalt">{industry.number}</span><div><h2 class="font-display text-2xl font-medium tracking-[-0.04em] transition-colors group-hover:text-cobalt">{industry.title}</h2><p class="mt-2 text-xs font-bold uppercase tracking-[0.1em] text-cobalt">{industry.sourceLabel}</p></div><p class="max-w-xl text-sm leading-relaxed text-muted">{industry.description}</p><span class="text-2xl transition-transform group-hover:translate-x-1 group-hover:-translate-y-1" aria-hidden="true">↗</span></a>)}</div></div></section>
  <section class="section-pad bg-paper"><div class="container-site"><SignalChart variant="industries-overview" /></div></section>
  <EvidenceBand eyebrow="Across future contexts" title="The evidence changes the question." text="Context matters because consequence, time horizon, and trust boundary are different. We use public research, frontier signals, and the organization’s own evidence to find the decision beneath the problem." limit={5} />
  <section class="section-pad bg-paper"><div class="container-site grid gap-12 lg:grid-cols-[.8fr_1.2fr] lg:gap-24"><SectionHeading eyebrow="The future agenda" title="What has to be true for this system to work?" /><div><p class="max-w-2xl text-2xl leading-snug tracking-[-0.03em] text-ink md:text-3xl">That question travels across sectors. The answer is always shaped by the mission, the people, and the decisions the organization has to make next.</p><div class="mt-10 grid gap-5 sm:grid-cols-3"><div class="border-t border-line pt-4"><p class="text-xs font-bold uppercase tracking-[0.12em] text-cobalt">AI</p><p class="mt-3 text-sm leading-relaxed text-muted">Scale with measurement, governance, and an accountable human role.</p></div><div class="border-t border-line pt-4"><p class="text-xs font-bold uppercase tracking-[0.12em] text-cobalt">Resilience</p><p class="mt-3 text-sm leading-relaxed text-muted">Design continuity into the platform, supplier, and workforce system.</p></div><div class="border-t border-line pt-4"><p class="text-xs font-bold uppercase tracking-[0.12em] text-cobalt">Capability</p><p class="mt-3 text-sm leading-relaxed text-muted">Build the skills and decision rights the future model actually requires.</p></div></div></div></div></section>
  <section class="bg-lime"><div class="container-site flex flex-col gap-8 py-16 md:flex-row md:items-center md:justify-between"><h2 class="max-w-2xl font-display text-4xl font-medium tracking-[-0.05em]">Talk to us about the future system behind the problem.</h2><a class="btn-dark shrink-0" href="/contact/">Request a principal dialogue <span aria-hidden="true">↗</span></a></div></section>
</Base>
