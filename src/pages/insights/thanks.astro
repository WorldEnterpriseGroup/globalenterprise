---
import Base from "@/layouts/Base.astro";
---

<Base title="You are subscribed | Global Enterprise" description="You are subscribed to The Signal from Global Enterprise." noindex>
  <section class="bg-ink py-24 text-white md:py-36">
    <div class="container-site grid gap-12 lg:grid-cols-[1fr_.8fr] lg:items-end">
      <div>
        <p class="eyebrow text-lime">The Signal</p>
        <h1 class="section-title mt-7 max-w-4xl">You are on the list.</h1>
        <p class="mt-8 max-w-2xl text-xl leading-relaxed text-white/70">We will send occasional evidence-led notes for the people carrying the next decision.</p>
        <div class="mt-10 flex flex-wrap gap-4"><a class="btn-primary" href="/insights/">Explore insights <span aria-hidden="true">↗</span></a><a class="btn-ghost" href="/">Back to home <span aria-hidden="true">↗</span></a></div>
      </div>
      <div class="border-l-2 border-lime pl-6"><p class="eyebrow text-lime">Good next read</p><a class="mt-5 block max-w-sm text-2xl font-display font-medium tracking-[-0.04em] hover:text-lime" href="/insights/ai-at-scale/">AI at scale is an operating model decision ↗</a></div>
    </div>
  </section>
</Base>
