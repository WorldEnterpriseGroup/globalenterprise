---
import Base from "@/layouts/Base.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import AssetImage from "@/components/AssetImage.astro";
import { businessReports, site } from "@/data/site";
import { resolveEvidenceSource } from "@/data/evidence-routes";

export function getStaticPaths() {
  return businessReports.map((report) => ({ params: { slug: report.slug }, props: { report } }));
}

const { report } = Astro.props;
const others = businessReports.filter((item) => item.slug !== report.slug).slice(0, 2);
const reportMedia = {
  "enterprise-decision-readiness": {
    src: "/media/generated/enterprise-hero.avif",
    width: 1600,
    height: 1067,
    alt: "A quiet executive working room overlooking a city at night",
    caption: "Decision readiness begins before the room fills: the mandate, trade-off, and owner must already be visible.",
    position: "56% 52%",
  },
  "ai-governance-controls": {
    src: "/media/generated/ai-governance.avif",
    width: 1600,
    height: 1067,
    alt: "A team reviewing AI governance controls around a working table",
    caption: "Control belongs in the workflow, close to the judgment and the consequence.",
    position: "50% 48%",
  },
  "modernization-investment-priority": {
    src: "/media/generated/technology-data.avif",
    width: 1600,
    height: 1067,
    alt: "Two operators walking through a data center corridor",
    caption: "Modernization is a sequence across systems, capital, continuity, and time.",
    position: "50% 50%",
  },
  "global-operating-model-brief": {
    src: "/reports/media/global-operating-model-hero.avif",
    width: 1672,
    height: 941,
    alt: "A distributed team works around a world map, connecting regions, partners, and operating decisions",
    caption: "A global operating model is a coordination fabric: shared intent, local context, explicit authority, and learning that travels.",
    position: "50% 50%",
  },
} as const;
const leadMedia = reportMedia[report.slug as keyof typeof reportMedia] ?? reportMedia["enterprise-decision-readiness"];
const sourceLinks = report.sources?.map((source) => resolveEvidenceSource(source)) ?? [];
---

<Base title={`${report.title} | Global Enterprise`} description={report.summary} image={leadMedia.src} imageWidth={leadMedia.width} imageHeight={leadMedia.height} imageAlt={leadMedia.alt} keywords={["enterprise report", "operating model", "AI governance", "modernization planning"]}>
  <section class="bg-ink py-16 text-white md:py-24">
    <div class="container-site grid gap-12 lg:grid-cols-[.88fr_1.12fr] lg:items-end">
      <div>
        <p class="eyebrow text-accent">{report.eyebrow} · {report.format}</p>
        <h1 class="section-title mt-7 max-w-4xl">{report.title}</h1>
        <p class="mt-8 max-w-2xl text-xl leading-relaxed text-white/65">{report.description}</p>
        <div class="mt-9 flex flex-wrap gap-4">
          <a class="btn-primary" href="#request-report">Get the full field guide <span aria-hidden="true">↓</span></a>
          <a class="btn-ghost text-white" href={report.htmlFile}>Read in browser <span aria-hidden="true">↗</span></a>
          <a class="btn-ghost text-white" href="#inside-report">Preview what is inside <span aria-hidden="true">↓</span></a>
        </div>
      </div>
      <figure class="report-hero-figure" style={`--report-position: ${leadMedia.position}`}>
        <AssetImage src={leadMedia.src} width={leadMedia.width} height={leadMedia.height} sizes="(min-width: 1024px) 52vw, 100vw" loading="eager" fetchpriority="high" alt={leadMedia.alt} class="report-hero-image" />
        <figcaption><span>Report field note</span>{leadMedia.caption}</figcaption>
      </figure>
    </div>
  </section>

  <section id="inside-report" class="section-pad bg-paper">
    <div class="container-site grid gap-14 lg:grid-cols-[.92fr_1.08fr] lg:gap-20">
      <div class="report-preview">
        <SectionHeading eyebrow="What this report contains" title="A report worth putting in the room." text={report.summary} />
        <div class="report-depth mt-8 grid gap-4 sm:grid-cols-3">
          <div><span>Read time</span><strong>{report.readingTime}</strong></div>
          <div><span>Format</span><strong>{report.format}</strong></div>
          <div><span>Includes</span><strong>{report.depth}</strong></div>
        </div>
        <div class="mt-10 border-y border-line">
          {report.highlights.map((item) => (
            <div class="report-preview-row"><p>{item}</p></div>
          ))}
        </div>
        <div class="mt-10 grid gap-8 md:grid-cols-2">
          <div>
            <p class="eyebrow">Outcome for teams</p>
            <div class="mt-5 space-y-3 text-sm leading-relaxed text-muted">
              {report.takeaways.map((item) => <p>— {item}</p>)}
            </div>
          </div>
          <div>
            <p class="eyebrow">Research basis</p>
            <ul class="mt-5 space-y-3 text-sm">
              {sourceLinks.map((source) => <li><a class="text-cobalt underline decoration-cobalt/35 underline-offset-4 hover:text-ink" href={source.displayUrl}>{source.label} ↗</a></li>)}
            </ul>
          </div>
        </div>
      </div>

      <div id="request-report" class="report-request">
        <p class="eyebrow text-accent">Request the complete field guide</p>
        <h2>Put the working document in the hands of the team carrying the decision.</h2>
        <p class="report-request-intro">Tell us where the report will be used. The download includes the full framework, practical worksheet, source notes, and limitations—not a one-page teaser.</p>
        <form class="mt-9 grid gap-5" action={site.briefEndpoint || site.formEndpoint} method="POST" data-lead-form data-form-kind={`resource_${report.slug}`} data-corporate-email-only aria-describedby={`resource-form-notice-${report.slug} resource-form-errors-${report.slug}`}>
          <input type="hidden" name="_subject" value={`${report.title} request · Global Enterprise`} />
          <input type="hidden" name="_next" value={`${site.url}/resources/thanks/?resource=${report.slug}`} />
          <input type="hidden" name="_template" value="table" />
          <input type="hidden" name="report" value={report.slug} />
          <input type="hidden" name="form_kind" value={`resource_${report.slug}`} />
          <input type="hidden" name="source_url" value={`${site.url}/resources/${report.slug}/`} />
          <input type="text" name="_honey" tabindex="-1" autocomplete="off" aria-hidden="true" class="absolute -left-[9999px] h-px w-px overflow-hidden" />
          <div id={`resource-form-errors-${report.slug}`} class="form-error-summary" data-form-summary role="alert" aria-live="assertive" tabindex="-1" hidden></div>
          <p id={`resource-form-notice-${report.slug}`} class="form-notice">{site.publicFormNotice} Company email required: Gmail, Yahoo, Hotmail, and Outlook.com accounts are not eligible for this brief. The required fields are enough to request the guide; the optional fields help us route a relevant follow-up.</p>
          <fieldset class="form-fieldset">
            <legend>Delivery details</legend>
            <div class="grid gap-5 sm:grid-cols-2">
              <label class="field-label" for={`resource-name-${report.slug}`}>Name <span class="required-note">Required</span>
                <input id={`resource-name-${report.slug}`} type="text" name="name" autocomplete="name" placeholder="Your name" required aria-required="true" aria-invalid="false" />
              </label>
              <label class="field-label" for={`resource-email-${report.slug}`}>Work email <span class="required-note">Required</span>
                <input id={`resource-email-${report.slug}`} type="email" name="email" autocomplete="email" placeholder="name@organization.gov or company.com" required aria-required="true" aria-invalid="false" />
              </label>
              <label class="field-label" for={`resource-org-${report.slug}`}>Organization <span class="required-note">Required</span>
                <input id={`resource-org-${report.slug}`} type="text" name="organization" autocomplete="organization" placeholder="Agency, company, university, or institution" required aria-required="true" aria-invalid="false" />
              </label>
              <label class="field-label" for={`resource-context-${report.slug}`}>Use case <span class="required-note">Required</span>
                <select id={`resource-context-${report.slug}`} name="use_case" required aria-required="true" aria-invalid="false">
                  <option value="" selected disabled>Pick what you are evaluating</option>
                  <option value="ai_rollout_governance">AI rollout and governance</option>
                  <option value="data_platform_cost_controls">Data platform and cost controls</option>
                  <option value="legacy_modernization_migration">Legacy modernization and migration</option>
                  <option value="executive_operating_model_review">Executive operating model review</option>
                  <option value="public_sector_systems_modernization">Public sector systems modernization</option>
                </select>
              </label>
            </div>
          </fieldset>
          <fieldset class="form-fieldset" aria-describedby={`resource-routing-help-${report.slug}`}>
            <legend>Optional routing context</legend>
            <p id={`resource-routing-help-${report.slug}`} class="form-helper">These short choices help us understand the decision context without asking for sensitive operating details. The planning horizon is optional.</p>
            <div class="grid gap-5 sm:grid-cols-2">
              <label class="field-label" for={`resource-role-${report.slug}`}>Role in the decision <span class="required-note">Required</span>
                  <select id={`resource-role-${report.slug}`} name="role" required aria-required="true" aria-invalid="false">
                  <option value="" selected disabled>Choose a role</option>
                  <option value="executive_leadership">Executive leadership</option>
                  <option value="operations_transformation">Operations or transformation</option>
                  <option value="technology_data_security">Technology, data, or security</option>
                  <option value="finance_procurement_risk">Finance, procurement, or risk</option>
                  <option value="policy_strategy_research">Policy, strategy, or research</option>
                  <option value="other_cross_functional">Other / cross-functional</option>
                </select>
              </label>
              <label class="field-label" for={`resource-stage-${report.slug}`}>Decision stage <span class="required-note">Required</span>
                  <select id={`resource-stage-${report.slug}`} name="decision_stage" required aria-required="true" aria-invalid="false">
                  <option value="" selected disabled>Choose a stage</option>
                  <option value="exploring_problem">Exploring the problem</option>
                  <option value="building_case">Building the case</option>
                  <option value="comparing_approaches">Comparing approaches</option>
                  <option value="planning_transition">Planning a transition</option>
                  <option value="operating_learning">Operating and learning</option>
                </select>
              </label>
              <label class="field-label" for={`resource-horizon-${report.slug}`}>Useful horizon <span class="optional-note">Optional</span>
                <select id={`resource-horizon-${report.slug}`} name="decision_horizon" aria-required="false" aria-invalid="false">
                  <option value="" selected>Choose a horizon</option>
                  <option value="next_90_days">Next 90 days</option>
                  <option value="this_planning_year">This planning year</option>
                  <option value="longer_term_portfolio_planning">Longer-term portfolio planning</option>
                  <option value="research_only">Research only</option>
                </select>
              </label>
            </div>
          </fieldset>
          <fieldset class="form-fieldset contact-preferences">
            <legend>Contact preferences</legend>
            <label class="checkbox-label" for={`resource-consent-${report.slug}`}>
              <input id={`resource-consent-${report.slug}`} class="mt-1 size-4 shrink-0 accent-cobalt" type="checkbox" name="consent" value="yes" required aria-required="true" aria-invalid="false" />
              <span>I agree to receive this report and be contacted about it. I understand this public form is not for sensitive information. <span class="required-note">Required</span></span>
            </label>
            <label class="checkbox-label" for={`resource-signal-opt-in-${report.slug}`}>
              <input id={`resource-signal-opt-in-${report.slug}`} class="mt-1 size-4 shrink-0 accent-cobalt" type="checkbox" name="signal_opt_in" value="yes" aria-required="false" aria-invalid="false" />
              <span>Also send me occasional evidence-led notes. I can unsubscribe at any time. <span class="optional-note">Optional</span></span>
            </label>
          </fieldset>
          <button class="btn-primary w-fit" type="submit" data-track="resource_download_submit" data-track-label={report.slug}>Send the full field guide <span aria-hidden="true">↗</span></button>
        </form>
      </div>
    </div>
  </section>

  <section class="section-pad bg-white">
    <div class="container-site">
      <p class="eyebrow text-cobalt">Continue the working set</p>
      <div class="mt-8 grid border-y border-line md:grid-cols-2 md:divide-x md:divide-line">
        {others.map((item) => <a class="related-report" href={`/resources/${item.slug}/`}><span>{item.eyebrow} · {item.readingTime}</span><strong>{item.title}</strong><small>{item.summary}</small><b>See report contents ↗</b></a>)}
      </div>
    </div>
  </section>
</Base>

<style>
  .report-hero-figure { margin: 0; border: 1px solid rgb(255 255 255 / 20%); background: var(--color-cobalt); box-shadow: 1rem 1rem 0 rgb(49 91 142 / 28%); }
  :global(.report-hero-image) { display: block; width: 100%; aspect-ratio: 16 / 10; object-fit: cover; object-position: var(--report-position); filter: saturate(0.82) contrast(1.04); }
  .report-hero-figure figcaption { display: grid; grid-template-columns: auto 1fr; gap: 1rem; padding: 0.9rem 1rem; border-top: 1px solid rgb(255 255 255 / 15%); color: rgb(255 255 255 / 66%); font-size: 0.72rem; line-height: 1.5; }
  .report-hero-figure figcaption span { color: var(--color-accent); font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; }
  .report-preview-row { display: grid; grid-template-columns: 2.75rem minmax(0, 1fr); gap: 1rem; padding-block: 1rem; border-bottom: 1px solid var(--color-line); }
  .report-preview-row:last-child { border-bottom: 0; }
  .report-preview-row span { color: var(--color-cobalt); font-family: var(--font-display); font-size: 1.3rem; }
  .report-preview-row p { color: var(--color-muted); font-size: 0.9rem; line-height: 1.55; }
  .report-depth { border-block: 1px solid var(--color-line); }
  .report-depth > div { padding: 1rem 0; border-bottom: 1px solid var(--color-line); }
  .report-depth > div:last-child { border-bottom: 0; }
  .report-depth span { display: block; color: var(--color-cobalt); font-size: 0.67rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; }
  .report-depth strong { display: block; margin-top: 0.45rem; color: var(--color-ink); font-family: var(--font-display); font-size: 1.05rem; font-weight: 500; line-height: 1.2; }
  .report-request { align-self: start; padding: clamp(1.75rem, 4vw, 3.5rem); background: var(--color-ink); color: white; box-shadow: 1rem 1rem 0 rgb(49 91 142 / 18%); }
  .report-request h2 { margin-top: 1.25rem; font-family: var(--font-display); font-size: clamp(2.15rem, 4vw, 3.55rem); font-weight: 400; letter-spacing: -0.045em; line-height: 1.02; }
  .report-request-intro { margin-top: 1.25rem; color: rgb(255 255 255 / 66%); line-height: 1.65; }
  .report-request .form-fieldset { min-width: 0; margin: 0; padding: 0; border: 0; }
  .report-request .form-fieldset + .form-fieldset { margin-top: 1.75rem; padding-top: 1.5rem; border-top: 1px solid rgb(255 255 255 / 16%); }
  .report-request legend { color: rgb(255 255 255 / 88%); font-size: 0.72rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; }
  .report-request .field-label { display: grid; gap: 0.45rem; color: rgb(255 255 255 / 82%); font-size: 0.82rem; font-weight: 700; }
  .report-request .required-note, .report-request .optional-note { margin-left: 0.35rem; color: var(--color-accent); font-size: 0.62rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
  .report-request .optional-note { color: rgb(255 255 255 / 72%); }
  .report-request .form-notice, .report-request .form-helper { max-width: 46rem; color: rgb(255 255 255 / 76%); font-size: 0.78rem; line-height: 1.55; }
  .report-request .form-notice { margin-bottom: 1.75rem; padding-left: 0.85rem; border-left: 2px solid var(--color-accent); }
  .report-request .form-helper { margin-top: 0.65rem; margin-bottom: 1.25rem; }
  .report-request .form-error-summary, .report-request .form-field-error { display: block; margin-top: 0.45rem; color: var(--color-accent); font-size: 0.78rem; line-height: 1.5; }
  .report-request .form-error-summary { margin-bottom: 0.25rem; padding-left: 0.85rem; border-left: 2px solid var(--color-accent); }
  .report-request .form-error-summary[hidden], .report-request .form-field-error[hidden] { display: none; }
  .report-request [aria-invalid="true"] { border-bottom-color: var(--color-accent); }
  .report-request input[type="checkbox"][aria-invalid="true"] { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  .report-request input:not([type="checkbox"]), .report-request select { width: 100%; min-height: 3.4rem; border: 0; border-bottom: 1px solid rgb(255 255 255 / 32%); border-radius: 0; background: transparent; color: white; font-size: 1rem; outline: none; }
  .report-request select { color-scheme: dark; }
  .report-request input:focus, .report-request select:focus { border-color: var(--color-accent); }
  .report-request .checkbox-label { display: flex; align-items: flex-start; gap: 0.75rem; margin-top: 1rem; color: rgb(255 255 255 / 82%); font-size: 0.82rem; font-weight: 400; line-height: 1.55; }
  .report-request .checkbox-label:first-of-type { margin-top: 1.15rem; }
  .related-report { display: grid; align-content: start; min-height: 18rem; padding: clamp(1.5rem, 4vw, 3rem); }
  .related-report > span { color: var(--color-cobalt); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; }
  .related-report strong { max-width: 32rem; margin-top: 1rem; font-family: var(--font-display); font-size: clamp(1.65rem, 3vw, 2.5rem); font-weight: 400; letter-spacing: -0.04em; line-height: 1.05; }
  .related-report small { max-width: 34rem; margin-top: 1rem; color: var(--color-muted); font-size: 0.82rem; line-height: 1.55; }
  .related-report b { align-self: end; margin-top: 2rem; color: var(--color-cobalt); font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; }
  .related-report:hover strong { color: var(--color-cobalt); }

  @media (max-width: 640px) {
    .report-hero-figure figcaption { grid-template-columns: 1fr; }
    .related-report { min-height: 0; border-bottom: 1px solid var(--color-line); }
  }
</style>
