---
import Base from "@/layouts/Base.astro";
import NewsletterSignup from "@/components/NewsletterSignup.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import AssetImage from "@/components/AssetImage.astro";
import { businessReports } from "@/data/site";

const keyReports = businessReports.slice(0, 3);
---

<Base title="Resources | Global Enterprise" description="Business reports and decision briefs designed for leaders carrying modern enterprise complexity." image="/media/original/home-evidence-archive.avif" keywords={["enterprise operating reports", "AI governance", "digital modernization", "decision readiness", "infrastructure modernization"]}>
  <section class="bg-ink py-16 text-white md:py-24">
    <div class="container-site grid gap-12 lg:grid-cols-[.82fr_1.18fr] lg:items-end">
      <div>
        <p class="eyebrow text-lime">Research-backed resources</p>
        <h1 class="section-title mt-7 max-w-4xl">Decision-ready reports for the room where the work begins.</h1>
        <p class="mt-8 max-w-2xl text-xl leading-relaxed text-white/70">Use public evidence as a practical operating advantage. These resources are concise, reusable, and built around the decisions leaders actually have to make.</p>
        <a class="btn-primary mt-9" href="#report-library">Browse the library <span aria-hidden="true">↓</span></a>
      </div>
      <figure class="resource-hero-figure">
        <AssetImage src="/media/original/home-intelligence-workshop.avif" width={1536} height={1024} sizes="(min-width: 1024px) 54vw, 100vw" loading="eager" fetchpriority="high" alt="Two engineers examining an unfinished mechanical component at a scarred workshop bench" class="resource-hero-image" />
        <figcaption><span>Field note 01</span> Research earns its place when a team can handle it, test it, and use it to choose.</figcaption>
      </figure>
    </div>
  </section>

  <section id="report-library" class="section-pad bg-paper">
    <div class="container-site">
      <div class="grid gap-10 lg:grid-cols-[.62fr_1.38fr] lg:gap-20">
        <div>
          <SectionHeading eyebrow="Reports library" title="Choose the decision in front of you." text="Each brief gives a leadership team a framing, a control set, and a practical sequence for the next working session." />
          <div class="resource-proof mt-10">
            <p class="eyebrow text-lime">The editorial contract</p>
            <p>Public evidence. Explicit caveats. A useful first move.</p>
          </div>
        </div>
        <div class="border-y border-line">
          {keyReports.map((report, index) => (
            <article class="resource-row">
              <p class="resource-row-number">0{index + 1}</p>
              <div>
                <p class="eyebrow text-cobalt">{report.eyebrow}</p>
                <h2>{report.title}</h2>
                <p class="resource-row-summary">{report.summary}</p>
                <ul>
                  {report.highlights.slice(0, 3).map((point) => <li>{point}</li>)}
                </ul>
                <a class="ink-link mt-7" href={`/resources/${report.slug}/`} data-track="resource_page" data-track-label={report.slug}>Preview and request the report</a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <NewsletterSignup dark />
</Base>

<style>
  .resource-hero-figure { margin: 0; border: 1px solid rgb(255 255 255 / 20%); background: var(--color-cobalt); box-shadow: 1rem 1rem 0 rgb(49 91 142 / 28%); }
  :global(.resource-hero-image) { display: block; width: 100%; aspect-ratio: 16 / 10; object-fit: cover; object-position: 48% 50%; filter: saturate(0.82) contrast(1.04); }
  .resource-hero-figure figcaption { display: grid; grid-template-columns: auto 1fr; gap: 1rem; padding: 0.9rem 1rem; border-top: 1px solid rgb(255 255 255 / 15%); color: rgb(255 255 255 / 66%); font-size: 0.72rem; line-height: 1.5; }
  .resource-hero-figure figcaption span { color: var(--color-lime); font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; }
  .resource-proof { padding: 1.5rem; background: var(--color-cobalt); color: white; }
  .resource-proof p:last-child { margin-top: 1.25rem; font-family: var(--font-display); font-size: clamp(1.65rem, 3vw, 2.4rem); line-height: 1.05; letter-spacing: -0.035em; }
  .resource-row { display: grid; grid-template-columns: 3.5rem minmax(0, 1fr); gap: 1.5rem; padding-block: clamp(2rem, 4vw, 3.25rem); border-bottom: 1px solid var(--color-line); }
  .resource-row:last-child { border-bottom: 0; }
  .resource-row-number { color: var(--color-cobalt); font-family: var(--font-display); font-size: 2rem; line-height: 1; }
  .resource-row h2 { margin-top: 0.7rem; max-width: 42rem; font-family: var(--font-display); font-size: clamp(1.8rem, 3vw, 2.7rem); font-weight: 400; letter-spacing: -0.045em; line-height: 1.02; }
  .resource-row-summary { max-width: 46rem; margin-top: 1rem; color: var(--color-muted); line-height: 1.65; }
  .resource-row ul { display: grid; gap: 0.55rem; margin-top: 1.25rem; color: var(--color-muted); font-size: 0.82rem; }
  .resource-row li { padding-left: 1rem; border-left: 2px solid var(--color-line); }

  @media (max-width: 520px) {
    .resource-hero-figure figcaption { grid-template-columns: 1fr; }
    .resource-row { grid-template-columns: 2.5rem minmax(0, 1fr); gap: 0.75rem; }
  }
</style>
