---
import Base from "@/layouts/Base.astro";
import AssetImage from "@/components/AssetImage.astro";
import { services } from "@/data/site";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const entries = await getCollection("servicePages");
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const serviceMeta = services.find((service) => service.slug === entry.id);
const serviceImage = serviceMeta?.image ?? "/media/generated/enterprise-hero.avif";
---

<Base title={`${entry.data.title} | Global Enterprise`} description={entry.data.description} image={serviceImage} keywords={[entry.data.title, ...entry.data.tags, "enterprise transformation"]} serviceSchema={{ name: entry.data.title, description: entry.data.description }}>
  <section class="bg-cobalt py-20 text-white md:py-28"><div class="container-site grid gap-12 lg:grid-cols-[.72fr_1.18fr_.8fr] lg:items-end"><div><p class="eyebrow text-lime">{entry.data.eyebrow}</p><p class="mt-7 font-display text-7xl font-bold tracking-[-0.08em] text-lime">{entry.data.number}</p></div><div><h1 class="section-title max-w-4xl">{entry.data.title}</h1><p class="mt-7 max-w-2xl text-xl leading-relaxed text-white/75">{entry.data.description}</p></div><div class="relative overflow-hidden bg-ink"><AssetImage src={serviceImage} width={1536} height={1024} loading="eager" decoding="async" alt={`${entry.data.title} working session`} class="aspect-[4/3] w-full object-cover opacity-85" /></div></div></section>
  <section class="section-pad bg-white"><div class="container-site grid gap-12 lg:grid-cols-[.7fr_1.3fr] lg:gap-24"><div><p class="eyebrow">Capability note</p><div class="mt-8 flex flex-wrap gap-2">{entry.data.tags.map((tag) => <span class="pill">{tag}</span>)}</div><a class="btn-dark mt-10" href="/contact/">Talk through the brief <span aria-hidden="true">↗</span></a></div><article class="prose max-w-3xl text-lg leading-relaxed text-muted prose-headings:font-display prose-headings:tracking-[-0.06em] prose-headings:text-ink prose-h2:mt-12 prose-h2:text-4xl prose-p:my-5"><Content /></article></div></section>
  <section class="section-pad bg-paper"><div class="container-site"><p class="eyebrow">How the work moves</p><h2 class="section-title mt-5 max-w-4xl">A capability becomes valuable when it can travel through the organization.</h2><div class="mt-14 grid gap-px border border-line bg-line md:grid-cols-3"><article class="bg-paper p-8 md:p-10"><p class="eyebrow text-cobalt">Frame</p><h3 class="mt-12 font-display text-2xl font-medium tracking-[-0.04em]">Name the decision</h3><p class="mt-4 leading-relaxed text-muted">Clarify the mandate, the decision, the service promise, and the constraint that makes the work consequential.</p></article><article class="bg-paper p-8 md:p-10"><p class="eyebrow text-cobalt">Shape</p><h3 class="mt-12 font-display text-2xl font-medium tracking-[-0.04em]">Design the system</h3><p class="mt-4 leading-relaxed text-muted">Design the workflow, architecture, roles, evidence, and controls around the people who will operate the change.</p></article><article class="bg-paper p-8 md:p-10"><p class="eyebrow text-cobalt">Transfer</p><h3 class="mt-12 font-display text-2xl font-medium tracking-[-0.04em]">Make it durable</h3><p class="mt-4 leading-relaxed text-muted">Create the measures, cadence, and capability that let the organization improve the system after the engagement.</p></article></div></div></section>
  <section class="bg-lime"><div class="container-site flex flex-col gap-8 py-16 md:flex-row md:items-center md:justify-between"><h2 class="max-w-2xl font-display text-5xl font-bold tracking-[-0.07em]">Make the system easier to run.</h2><a class="btn-dark shrink-0" href="/contact/">Start a conversation <span aria-hidden="true">↗</span></a></div></section>
</Base>
