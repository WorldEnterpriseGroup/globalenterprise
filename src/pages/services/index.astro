---
import Base from "@/layouts/Base.astro";
import EngagementCards from "@/components/EngagementCards.astro";
import EvidenceBand from "@/components/EvidenceBand.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import ArchitectureMap from "@/components/ArchitectureMap.astro";
import AssetImage from "@/components/AssetImage.astro";
import IntelligenceStack from "@/components/IntelligenceStack.astro";
import { services } from "@/data/site";
---

<Base title="Capabilities | Global Enterprise" description="Explore Global Enterprise capabilities across AI/ML, data labs, AI cost management, operating models, quantum intelligence, and enterprise change." image="/media/original/services-control-room.avif" keywords={["enterprise AI consulting", "AI cost management", "data lab build out", "quantum intelligence consulting", "ITIL change management"]}>
  <section class="bg-paper py-20 md:py-28"><div class="container-site grid gap-12 lg:grid-cols-[1fr_.72fr] lg:items-end"><div><p class="eyebrow">Capabilities</p><h1 class="section-title mt-7 max-w-5xl">Capability is the difference between a strategy on paper and a system that can carry it.</h1><p class="body-copy mt-8 max-w-2xl text-xl">We connect frontier intelligence to operating discipline: AI/ML, data labs, cost governance, architecture, human capability, and change systems that can carry consequential decisions.</p></div><div><div class="border-l-2 border-cobalt pl-6"><p class="font-display text-6xl font-medium tracking-[-0.08em] text-cobalt">06</p><p class="mt-4 max-w-xs text-sm leading-relaxed text-muted">Connected disciplines, sequenced around the decision rather than sold as isolated workstreams.</p></div><figure class="mt-8 overflow-hidden border border-line bg-white shadow-[.8rem_.8rem_0_rgba(16,19,29,.08)]"><AssetImage src="/media/original/services-control-room.avif" width={1536} height={1024} loading="eager" decoding="async" alt="An operator walking through a real utility control room lined with analog meters" class="aspect-[16/9] w-full object-cover" /><figcaption class="border-t border-line px-4 py-3 text-xs leading-relaxed text-muted">Capability is what remains operable after the strategy leaves the room.</figcaption></figure></div></div></section>
  <section class="bg-white"><div class="container-site"><IntelligenceStack /></div></section>
  <section class="bg-white"><div class="container-site divide-y divide-line border-y border-line">{services.map((service) => <a class="group grid gap-5 py-8 md:grid-cols-[4rem_1.2fr_1fr_auto] md:items-center" href={`/services/${service.slug}/`}><span class="font-display text-4xl font-bold tracking-[-0.08em] text-cobalt">{service.number}</span><div><h2 class="font-display text-3xl font-medium tracking-[-0.06em] transition-colors group-hover:text-cobalt">{service.title}</h2><p class="mt-2 text-sm font-bold text-cobalt">{service.short}</p></div><div><p class="max-w-md leading-relaxed text-muted">{service.description}</p><div class="mt-3 flex flex-wrap gap-2">{service.tags.map((tag) => <span class="pill">{tag}</span>)}</div></div><span class="text-2xl transition-transform group-hover:translate-x-1 group-hover:-translate-y-1" aria-hidden="true">↗</span></a>)}</div></section>
  <section class="section-pad bg-paper"><div class="container-site"><ArchitectureMap variant="services-portfolio" eyebrow="Capability architecture · connected disciplines" title="Six capabilities, one operating system." caption="The portfolio is strongest when strategy, workflow, platform, capability, and evidence reinforce each other instead of becoming parallel workstreams." /></div></section>
  <section class="section-pad bg-white"><div class="container-site"><SectionHeading eyebrow="Ways to work together" title="Choose the starting level, then let the evidence set the pace." text="The first move can be a private mandate session, a targeted diagnostic, or a longer transformation partnership. Each route is designed to make the next decision clearer." /><div class="mt-14"><EngagementCards /></div></div></section>
  <EvidenceBand eyebrow="The evidence behind the portfolio" title="Capabilities are only useful when they change an outcome." text="These signals explain why we bring operating model, technology, AI, and capability work together instead of selling isolated workstreams." limit={4} />
  <section class="section-pad bg-ink text-white"><div class="container-site grid gap-12 lg:grid-cols-[.8fr_1.2fr]"><SectionHeading eyebrow="Where we start" title="A mandate, not a package." /><div><p class="text-2xl font-bold leading-snug tracking-[-0.03em] md:text-4xl">The right first move depends on the institutional question, the consequence, and the horizon in front of you.</p><p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/65">We begin with the decision surface: what must be true, what is getting in the way, and what evidence would justify the next release of capability.</p><a class="btn-primary mt-8" href="/contact/">Request a principal dialogue <span aria-hidden="true">↗</span></a></div></div></section>
</Base>
