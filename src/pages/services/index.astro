---
import Base from "@/layouts/Base.astro";
import EvidenceBand from "@/components/EvidenceBand.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import SignalIcon from "@/components/SignalIcon.astro";
import AssetImage from "@/components/AssetImage.astro";
import { services } from "@/data/site";
---

<Base title="Capabilities | Global Enterprise" description="Explore Global Enterprise capabilities across operating model design, intelligent automation, cloud and data, leadership, transformation, and foresight." keywords={["enterprise consulting capabilities", "operating model consulting", "AI and automation consulting", "cloud and data strategy", "transformation office"]}>
  <section class="bg-paper py-20 md:py-28"><div class="container-site grid gap-12 lg:grid-cols-[1fr_.72fr] lg:items-end"><div><p class="eyebrow">Capabilities</p><h1 class="section-title mt-7 max-w-5xl">The parts of transformation that have to work together.</h1><p class="body-copy mt-8 max-w-2xl text-xl">We connect strategy to systems, and systems to the people responsible for outcomes.</p></div><div class="relative overflow-hidden bg-ink"><AssetImage src="/media/generated/enterprise-hero.avif" width={1536} height={1024} loading="eager" decoding="async" alt="A quiet enterprise strategy room prepared for a working session" class="aspect-[4/3] w-full object-cover opacity-90" /></div></div></section>
  <section class="bg-white"><div class="container-site grid gap-px border-x border-line bg-line md:grid-cols-2">{services.map((service) => <a class="group bg-white p-5 transition-colors hover:bg-cobalt hover:text-white md:p-8" href={`/services/${service.slug}/`}><div class="relative overflow-hidden bg-cobalt"><AssetImage src={service.image} width={1536} height={1024} loading="lazy" decoding="async" alt={`${service.title} in practice`} class="aspect-[2.1/1] w-full object-cover opacity-85 transition duration-500 group-hover:scale-105 group-hover:opacity-100" /></div><div class="flex items-start justify-between pt-7"><div><span class="font-display text-4xl font-bold tracking-[-0.08em] text-cobalt transition-colors group-hover:text-lime">{service.number}</span><h2 class="mt-12 font-display text-3xl font-bold tracking-[-0.07em]">{service.title}</h2></div><SignalIcon name={service.number === "2" ? "pulse" : service.number === "4" ? "people" : "system"} size={26} /></div><p class="mt-4 text-lg font-bold text-cobalt transition-colors group-hover:text-lime">{service.short}</p><p class="mt-5 max-w-md leading-relaxed text-muted transition-colors group-hover:text-white/70">{service.description}</p><div class="mt-8 flex flex-wrap gap-2">{service.tags.map((tag) => <span class="pill transition-colors group-hover:border-white/30 group-hover:text-white/75">{tag}</span>)}</div></a>)}</div></section>
  <EvidenceBand eyebrow="The evidence behind the portfolio" title="Capabilities are only useful when they change an outcome." text="These signals explain why we bring operating model, technology, AI, and capability work together instead of selling isolated workstreams." limit={4} />
  <section class="section-pad bg-ink text-white"><div class="container-site grid gap-12 lg:grid-cols-[.8fr_1.2fr]"><SectionHeading eyebrow="Where we start" title="A question, not a package." /><div><p class="text-2xl font-bold leading-snug tracking-[-0.03em] md:text-4xl">The right first step depends on the constraint that is holding the system back.</p><p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/65">We usually begin with a short working session: what needs to be true, what is getting in the way, and what would change if the system worked better?</p><a class="btn-primary mt-8" href="/contact/">Set up a working session <span aria-hidden="true">↗</span></a></div></div></section>
</Base>
