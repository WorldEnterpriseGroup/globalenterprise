---
import Base from "@/layouts/Base.astro";
import SolutionDiagram from "@/components/SolutionDiagram.astro";
import { getCollection } from "astro:content";
import { services, solutionPages } from "@/data/site";

export function getStaticPaths() {
  return solutionPages.map((solution) => ({ params: { slug: solution.slug }, props: { solution } }));
}

const { solution } = Astro.props;
const relatedServices = solution.serviceSlugs.map((slug) => services.find((service) => service.slug === slug)).filter(Boolean);
const cases = (await getCollection("caseStudies")).slice(0, 2);
---

<Base title={`${solution.eyebrow} solutions | Global Enterprise`} description={solution.description} keywords={[solution.eyebrow, ...solution.focus, "enterprise transformation"]}>
  <section class="bg-ink py-20 text-white md:py-28"><div class="container-site grid gap-12 lg:grid-cols-[1fr_.72fr] lg:items-end"><div><a class="eyebrow text-lime" href="/solutions/">Solutions · Back to all</a><h1 class="section-title mt-7 max-w-5xl">{solution.title}</h1><p class="mt-8 max-w-2xl text-xl leading-relaxed text-white/65">{solution.description}</p></div><div class="border-l-2 border-lime pl-6"><p class="font-display text-6xl font-medium tracking-[-0.08em] text-lime">{solution.focus.length.toString().padStart(2, "0")}</p><p class="mt-4 max-w-xs text-sm leading-relaxed text-white/65">Focus areas keep the starting point specific without turning it into a package.</p></div></div></section>
  <section class="section-pad bg-white"><div class="container-site grid gap-12 lg:grid-cols-[.7fr_1.3fr] lg:gap-24"><div><p class="eyebrow">The future state</p><h2 class="mt-6 font-display text-4xl font-medium tracking-[-0.05em] md:text-5xl">What durable advantage looks like.</h2></div><div><p class="max-w-3xl text-2xl leading-snug tracking-[-0.03em] text-ink md:text-3xl">{solution.promise}</p><p class="body-copy mt-7 max-w-3xl">We connect the immediate decision to the operating model, technology, evidence, economics, and capability required to make the change durable.</p></div></div></section>
  <section class="section-pad bg-paper"><div class="container-site"><SolutionDiagram variant={`solution-${solution.slug}`} /></div></section>
  <section class="section-pad bg-paper"><div class="container-site grid gap-12 lg:grid-cols-[.72fr_1.28fr] lg:gap-24"><div><p class="eyebrow">What we make real</p><h2 class="section-title mt-5 max-w-3xl">The work has to hold at the point of consequence.</h2></div><div class="grid gap-px border border-line bg-line md:grid-cols-3">{solution.focus.map((item) => <div class="bg-paper p-8 md:p-9"><p class="eyebrow text-cobalt">Focus</p><h3 class="mt-12 font-display text-xl font-medium leading-tight tracking-[-0.04em]">{item}</h3></div>)}</div></div></section>
  <section class="section-pad bg-white"><div class="container-site"><p class="eyebrow">How we move</p><h2 class="section-title mt-5 max-w-4xl">From strategic question to an institution that can carry the answer.</h2><div class="mt-14 grid gap-px border border-line bg-line md:grid-cols-3">{solution.moves.map((move) => <article class="bg-white p-8 md:min-h-[20rem] md:p-10"><p class="eyebrow text-cobalt">Move</p><p class="mt-12 text-xl font-medium leading-tight tracking-[-0.03em]">{move}</p></article>)}</div></div></section>
  <section class="section-pad bg-cobalt text-white"><div class="container-site grid gap-12 lg:grid-cols-[.72fr_1.28fr] lg:gap-24"><div><p class="eyebrow text-lime">Capabilities in the room</p><h2 class="section-title mt-5">The right disciplines close to the decision.</h2></div><div class="divide-y divide-white/15 border-y border-white/15">{relatedServices.map((service) => service && <a class="group grid gap-4 py-6 md:grid-cols-[4rem_1fr_auto] md:items-center" href={`/services/${service.slug}/`}><span class="font-display text-3xl text-lime">{service.number}</span><div><h3 class="font-display text-2xl font-medium tracking-[-0.04em] group-hover:text-lime">{service.title}</h3><p class="mt-2 text-sm text-white/60">{service.description}</p></div><span class="text-2xl transition-transform group-hover:translate-x-1 group-hover:-translate-y-1" aria-hidden="true">↗</span></a>)}</div></div></section>
  <section class="section-pad bg-white"><div class="container-site"><div class="flex flex-col justify-between gap-8 md:flex-row md:items-end"><div><p class="eyebrow">Related field notes</p><h2 class="section-title mt-5">Evidence from the work.</h2></div><a class="btn-ghost shrink-0" href="/case-studies/">View all work <span aria-hidden="true">↗</span></a></div><div class="mt-12 grid gap-8 md:grid-cols-2">{cases.map((entry) => <a class="group border-t border-line pt-6" href={`/case-studies/${entry.id}/`}><p class="text-xs font-bold uppercase tracking-[0.12em] text-cobalt">{entry.data.sector} · {entry.data.service}</p><h3 class="mt-4 font-display text-3xl font-medium tracking-[-0.05em] group-hover:text-cobalt">{entry.data.title}</h3><p class="mt-4 max-w-xl leading-relaxed text-muted">{entry.data.result}</p><span class="mt-6 inline-block text-cobalt">Read the field note ↗</span></a>)}</div></div></section>
  <section class="bg-lime"><div class="container-site flex flex-col gap-8 py-16 md:flex-row md:items-center md:justify-between"><h2 class="max-w-2xl font-display text-4xl font-medium tracking-[-0.05em]">Start with the consequence behind the question.</h2><a class="btn-dark shrink-0" href="/contact/">Request a principal dialogue <span aria-hidden="true">↗</span></a></div></section>
</Base>
