---
import Base from "@/layouts/Base.astro";
import AssetImage from "@/components/AssetImage.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import { solutionPages } from "@/data/site";
---

<Base title="Solutions | Global Enterprise" description="Focused starting points for enterprise AI, modernization, operating model design, and healthcare transformation." keywords={["enterprise AI solution", "modernization strategy", "operating model design", "healthcare transformation"]}>
  <section class="bg-ink py-20 text-white md:py-28"><div class="container-site grid gap-12 lg:grid-cols-[1fr_.72fr] lg:items-end"><div><p class="eyebrow text-lime">Solutions</p><h1 class="section-title mt-7 max-w-5xl">Start with the problem leaders are carrying now.</h1><p class="mt-8 max-w-2xl text-xl leading-relaxed text-white/65">Focused entry points for the moments when strategy, technology, and the operating system have to move together.</p></div><div class="relative overflow-hidden bg-cobalt"><AssetImage src="/media/generated/ai-governance.avif" width={1536} height={1024} loading="eager" decoding="async" alt="Leaders reviewing an enterprise transformation agenda" class="aspect-[4/3] w-full object-cover opacity-90" /></div></div></section>
  <section class="section-pad bg-white"><div class="container-site"><SectionHeading eyebrow="Where to begin" title="A useful answer starts with the right question." text="Choose the context that sounds closest to your brief; each path connects a specific problem to the capabilities, decisions, and evidence that can move it forward." /><div class="mt-14 grid gap-px border border-line bg-line md:grid-cols-2">{solutionPages.map((solution, index) => <a class="group bg-white p-5 transition-colors hover:bg-cobalt hover:text-white md:p-8" href={`/solutions/${solution.slug}/`}><div class="relative overflow-hidden bg-cobalt"><AssetImage src={solution.image} width={1536} height={1024} loading="lazy" decoding="async" alt={`${solution.eyebrow} strategy working session`} class="aspect-[2.2/1] w-full object-cover opacity-85 transition duration-500 group-hover:scale-105 group-hover:opacity-100" /></div><div class="flex items-start justify-between gap-5 pt-7"><div><span class="font-display text-3xl text-cobalt transition-colors group-hover:text-lime">0{index + 1}</span><h2 class="mt-8 font-display text-3xl font-medium tracking-[-0.05em]">{solution.eyebrow}</h2></div><span class="text-2xl transition-transform group-hover:translate-x-1 group-hover:-translate-y-1" aria-hidden="true">↗</span></div><p class="mt-5 text-lg font-bold text-cobalt transition-colors group-hover:text-lime">{solution.title}</p><p class="mt-4 leading-relaxed text-muted transition-colors group-hover:text-white/70">{solution.description}</p></a>)}</div></div></section>
  <section class="bg-lime"><div class="container-site flex flex-col gap-8 py-16 md:flex-row md:items-center md:justify-between"><h2 class="max-w-2xl font-display text-4xl font-medium tracking-[-0.05em]">The starting point can be specific without being narrow.</h2><a class="btn-dark shrink-0" href="/contact/">Bring us the brief <span aria-hidden="true">↗</span></a></div></section>
</Base>
