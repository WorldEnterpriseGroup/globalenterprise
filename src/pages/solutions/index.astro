---
import Base from "@/layouts/Base.astro";
import AssetImage from "@/components/AssetImage.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import { solutionPages } from "@/data/site";
---

<Base title="Strategic pathways | Global Enterprise" description="Strategic pathways for AI-native operations, modernization, data labs, quantum intelligence, and institutional change." image="/media/original/solutions-care-handoff.avif" keywords={["enterprise AI solution", "AI cost management", "data lab build out", "quantum intelligence strategy", "operating model design", "modernization strategy"]}>
  <section class="bg-ink py-20 text-white md:py-28"><div class="container-site grid gap-12 lg:grid-cols-[1fr_.72fr] lg:items-end"><div><p class="eyebrow text-lime">Strategic pathways</p><h1 class="section-title mt-7 max-w-5xl">Six pathways through the decisions that make change hold.</h1><p class="mt-8 max-w-2xl text-xl leading-relaxed text-white/65">Each pathway connects a consequential question to the capabilities, evidence, economics, and change architecture required to make the answer durable.</p></div><div><div class="border-l-2 border-lime pl-6"><p class="font-display text-6xl font-medium tracking-[-0.08em] text-lime">06</p><p class="mt-4 max-w-xs text-sm leading-relaxed text-white/65">Each pathway names the decision, the system around it, and the first useful move.</p></div><figure class="mt-8 overflow-hidden border border-white/20 bg-cobalt"><AssetImage src="/media/original/solutions-care-handoff.avif" width={1536} height={1024} loading="eager" decoding="async" alt="Two hospital staff members comparing a paper checklist beside a supply cart" class="aspect-[16/9] w-full object-cover opacity-90" /><figcaption class="border-t border-white/15 px-4 py-3 text-xs leading-relaxed text-white/60">A pathway earns its name when the handoff is visible.</figcaption></figure></div></div></section>
  <section class="section-pad bg-white"><div class="container-site"><SectionHeading eyebrow="Where to begin" title="The right pathway is a point of view about the system." text="Choose the context closest to the mandate. Each path is specific enough to act on and broad enough to see the whole institution." /><div class="mt-14 divide-y divide-line border-y border-line">{solutionPages.map((solution, index) => <a class="group grid gap-5 py-8 md:grid-cols-[4rem_1fr_1.2fr_auto] md:items-center" href={`/solutions/${solution.slug}/`}><span class="font-display text-4xl text-cobalt">0{index + 1}</span><div><p class="eyebrow text-cobalt">Pathway</p><h2 class="mt-3 font-display text-3xl font-medium tracking-[-0.05em] transition-colors group-hover:text-cobalt">{solution.eyebrow}</h2></div><div><p class="font-bold text-cobalt">{solution.title}</p><p class="mt-3 max-w-xl leading-relaxed text-muted">{solution.description}</p></div><span class="text-2xl transition-transform group-hover:translate-x-1 group-hover:-translate-y-1" aria-hidden="true">↗</span></a>)}</div></div></section>
  <section class="bg-lime"><div class="container-site flex flex-col gap-8 py-16 md:flex-row md:items-center md:justify-between"><h2 class="max-w-2xl font-display text-4xl font-medium tracking-[-0.05em]">A pathway is useful when it clarifies the decision behind the work.</h2><a class="btn-dark shrink-0" href="/contact/">Request a principal dialogue <span aria-hidden="true">↗</span></a></div></section>
</Base>
