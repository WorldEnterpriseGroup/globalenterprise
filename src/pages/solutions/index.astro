---
import Base from "@/layouts/Base.astro";
import AssetImage from "@/components/AssetImage.astro";
import { solutionPages } from "@/data/site";
---

<Base title="Strategic pathways | Global Enterprise" description="Strategic pathways for AI-native operations, modernization, data labs, quantum intelligence, and institutional change." image="/media/original/solutions-care-handoff.avif" keywords={["enterprise AI solution", "AI cost management", "data lab build out", "quantum intelligence strategy", "operating model design", "modernization strategy"]}>
  <section class="bg-ink py-20 text-white md:py-28">
    <div class="container-site grid gap-12 lg:grid-cols-[1fr_.72fr] lg:items-end">
      <div>
        <p class="eyebrow text-accent">Strategic pathways</p>
        <h1 class="section-title mt-7 max-w-5xl">Pathways through the decisions that make change hold.</h1>
        <p class="mt-8 max-w-2xl text-xl leading-relaxed text-white/65">Each pathway connects a consequential question to the capabilities, evidence, economics, and change architecture required to make the answer durable.</p>
      </div>
      <div>
        <div class="border-l-2 border-accent pl-6"><p class="max-w-xs text-sm leading-relaxed text-white/65">Follow the question first. The pathway names the system around it and the first useful move.</p></div>
        <figure class="mt-8 overflow-hidden border border-white/20 bg-cobalt">
          <AssetImage src="/media/original/solutions-care-handoff.avif" width={1536} height={1024} loading="eager" decoding="async" alt="Two hospital staff members comparing a paper checklist beside a supply cart" class="aspect-[16/9] w-full object-cover opacity-90" />
          <figcaption class="border-t border-white/15 px-4 py-3 text-xs leading-relaxed text-white/60">A pathway earns its name when the handoff is visible.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="section-pad bg-white" aria-labelledby="pathway-map-heading">
    <div class="container-site">
      <div class="solution-pathway-intro">
        <div>
          <p class="eyebrow text-cobalt">Decision-led wayfinding</p>
          <h2 id="pathway-map-heading" class="section-title mt-5 max-w-4xl">Start with the decision. Let the system set the route.</h2>
        </div>
        <p class="max-w-sm border-l-2 border-cobalt pl-5 text-sm leading-relaxed text-muted">These are not packages or maturity scores. They are distinct starting questions for leaders who need the next move to be specific.</p>
      </div>

      <div class="solution-pathway-map" data-diagram-id="solutions-decision-pathway" aria-labelledby="pathway-map-heading">
        <div class="solution-pathway-axis" aria-hidden="true"><span>Question</span><i></i><span>System</span><i></i><span>First move</span></div>
        <ol class="solution-pathway-list">
          {solutionPages.map((solution) => (
            <li class="solution-pathway-item">
              <a class="solution-pathway-link" href={`/solutions/${solution.slug}/`}>
                <div class="solution-pathway-index"><span aria-hidden="true">↗</span><small>pathway</small></div>
                <div class="solution-pathway-copy">
                  <p class="eyebrow text-cobalt">{solution.eyebrow}</p>
                  <h3>{solution.title}</h3>
                  <p>{solution.description}</p>
                </div>
                <dl class="solution-pathway-facts">
                  <div><dt>Decision lens</dt><dd>{solution.focus[0]}</dd></div>
                  <div><dt>First move</dt><dd>{solution.moves[0]}</dd></div>
                </dl>
                <span class="solution-pathway-arrow" aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ol>
        <p class="solution-pathway-note">Read across each line: the context names the question, the lens names what must be made visible, and the move gives the first testable step.</p>
      </div>
    </div>
  </section>

  <section class="bg-accent"><div class="container-site flex flex-col gap-8 py-16 md:flex-row md:items-center md:justify-between"><h2 class="max-w-2xl font-display text-4xl font-medium tracking-[-0.05em]">A pathway is useful when it clarifies the decision behind the work.</h2><a class="btn-dark shrink-0" href="/contact/">Request a leadership engagement <span aria-hidden="true">↗</span></a></div></section>
</Base>

<style>
  .solution-pathway-intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 0.5fr);
    align-items: end;
    gap: 3rem;
  }

  .solution-pathway-map {
    position: relative;
    margin-top: clamp(2.4rem, 5vw, 4.5rem);
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    padding-block: 1.25rem 1.6rem;
  }

  .solution-pathway-axis {
    display: grid;
    grid-template-columns: 7rem auto 1fr auto 1fr;
    align-items: center;
    gap: 0.75rem;
    color: var(--color-muted);
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .solution-pathway-axis i {
    display: block;
    width: 3.5rem;
    height: 1px;
    background: var(--color-cobalt);
  }

  .solution-pathway-axis span:last-child {
    text-align: right;
  }

  .solution-pathway-list {
    display: grid;
    gap: 0;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .solution-pathway-item {
    border-top: 1px solid var(--color-line);
  }

  .solution-pathway-link {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1.2fr) minmax(16rem, 0.8fr) auto;
    gap: 1.25rem;
    align-items: center;
    padding: 1.5rem 0.25rem;
    color: inherit;
    text-decoration: none;
  }

  .solution-pathway-link:hover .solution-pathway-copy h3,
  .solution-pathway-link:focus-visible .solution-pathway-copy h3 {
    color: var(--color-cobalt);
  }

  .solution-pathway-link:focus-visible {
    outline: 3px solid var(--color-cobalt);
    outline-offset: 4px;
  }

  .solution-pathway-index {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }

  .solution-pathway-index span {
    display: grid;
    width: 2.7rem;
    height: 2.7rem;
    place-items: center;
    border: 1px solid var(--color-cobalt);
    border-radius: 999px;
    color: var(--color-cobalt);
    font-family: var(--font-display);
    font-size: 1.25rem;
    letter-spacing: -0.04em;
  }

  .solution-pathway-index small {
    color: var(--color-muted);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .solution-pathway-copy h3 {
    margin-top: 0.55rem;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.4vw, 2rem);
    font-weight: 500;
    letter-spacing: -0.05em;
    line-height: 1.05;
    transition: color 180ms ease;
  }

  .solution-pathway-copy > p:last-child {
    max-width: 42rem;
    margin-top: 0.65rem;
    color: var(--color-muted);
    font-size: 0.8rem;
    line-height: 1.5;
  }

  .solution-pathway-facts {
    display: grid;
    gap: 0.8rem;
    margin: 0;
  }

  .solution-pathway-facts div {
    border-left: 2px solid var(--color-accent);
    padding-left: 0.75rem;
  }

  .solution-pathway-facts dt {
    color: var(--color-muted);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .solution-pathway-facts dd {
    margin-top: 0.25rem;
    color: var(--color-ink);
    font-size: 0.74rem;
    font-weight: 700;
    line-height: 1.35;
  }

  .solution-pathway-arrow {
    align-self: center;
    color: var(--color-cobalt);
    font-size: 1.8rem;
    transition: transform 180ms ease;
  }

  .solution-pathway-link:hover .solution-pathway-arrow,
  .solution-pathway-link:focus-visible .solution-pathway-arrow {
    transform: translate(0.2rem, -0.2rem);
  }

  .solution-pathway-note {
    margin-top: 1.25rem;
    color: var(--color-muted);
    font-size: 0.72rem;
    line-height: 1.5;
  }

  @media (max-width: 900px) {
    .solution-pathway-link {
      grid-template-columns: 5.5rem minmax(0, 1fr) auto;
    }

    .solution-pathway-facts {
      grid-column: 2 / -1;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .solution-pathway-arrow {
      grid-column: 3;
      grid-row: 1;
    }
  }

  @media (max-width: 700px) {
    .solution-pathway-intro {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .solution-pathway-axis {
      display: none;
    }

    .solution-pathway-link {
      grid-template-columns: 1fr auto;
      gap: 1rem;
      padding-block: 1.35rem;
    }

    .solution-pathway-index {
      grid-column: 1 / -1;
    }

    .solution-pathway-copy {
      grid-column: 1 / -1;
    }

    .solution-pathway-facts {
      grid-column: 1 / -1;
      grid-template-columns: 1fr;
    }

    .solution-pathway-arrow {
      position: absolute;
      right: 0.25rem;
      top: 1.35rem;
    }

    .solution-pathway-item {
      position: relative;
    }
  }
</style>
