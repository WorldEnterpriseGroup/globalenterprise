---
import Base from "@/layouts/Base.astro";
import AssetImage from "@/components/AssetImage.astro";
---

<Base title="Terms | Global Enterprise" description="Global Enterprise website terms of use." noindex keywords={["Global Enterprise terms", "website terms of use", "consulting website"]}><section class="bg-white py-20 md:py-28"><div class="container-site grid gap-12 lg:grid-cols-[1fr_.72fr] lg:items-start"><div><p class="eyebrow">Terms</p><h1 class="section-title mt-7">Use the site thoughtfully.</h1><p class="body-copy mt-8 max-w-2xl text-xl">A clear boundary around the material makes it more useful for everyone who reads it.</p></div><div class="relative overflow-hidden bg-cobalt"><AssetImage src="/media/generated/enterprise-hero.avif" width={1536} height={1024} loading="eager" decoding="async" alt="A quiet enterprise strategy room prepared for a working session" class="aspect-[4/3] w-full object-cover opacity-90" /></div></div></section><section class="section-pad bg-white"><div class="container-site max-w-3xl"><div class="prose max-w-none text-lg leading-relaxed text-muted prose-headings:font-display prose-headings:tracking-[-0.06em] prose-headings:text-ink prose-h2:mt-12 prose-h2:text-4xl"><p>The material on this site is provided for general information about Global Enterprise and its capabilities. It is not legal, financial, or professional advice for a specific situation.</p><h2>Content</h2><p>We work to keep the information accurate and useful, but we do not guarantee that every page is complete or current. You may link to this site for informational purposes without implying endorsement.</p><h2>Contact</h2><p>Questions about these terms can be sent to <a href="mailto:info@globalenterprise.com">info@globalenterprise.com</a>.</p></div></div></section></Base>
