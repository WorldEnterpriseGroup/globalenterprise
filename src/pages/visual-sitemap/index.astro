---
import Base from "@/layouts/Base.astro";
import { sitemapGroups, sitemapPages } from "@/data/sitemap";

const numberFor = (index: number) => String(index + 1);
---

<Base title="Visual sitemap | Global Enterprise" description="A visual, navigable map of the Global Enterprise site architecture." noindex>
  <div class="bg-[#eef1f4] text-ink">
    <header class="border-b border-line bg-white px-5 py-12 md:px-12 lg:px-16">
      <div class="mx-auto max-w-[1400px]">
        <p class="eyebrow">Site architecture</p>
        <div class="mt-6 flex flex-col justify-between gap-8 lg:flex-row lg:items-end">
          <div>
            <h1 class="section-title max-w-5xl">The Global Enterprise site, mapped.</h1>
            <p class="body-copy mt-5 max-w-3xl text-lg">A navigable view of the pages, evidence, capabilities, industries, and points of view that make up the new enterprise experience.</p>
          </div>
          <a class="btn-dark shrink-0" href="/visual-sitemap/compact.html">Open compact view <span aria-hidden="true">↗</span></a>
        </div>
        <div class="mt-8 flex flex-wrap gap-x-8 gap-y-2 text-sm font-bold text-muted"><span>{sitemapPages.length} numbered pages</span><span>{sitemapGroups.length} architecture groups</span><span>All routes are live</span></div>
      </div>
    </header>

    <nav class="border-b border-line bg-[#f8f9fa] px-5 py-8 md:px-12 lg:px-16" aria-label="Page directory">
      <div class="mx-auto max-w-[1400px]">
        <p class="text-xs font-bold uppercase tracking-[0.14em]">Numbered page directory</p>
        <div class="mt-5 grid gap-x-8 gap-y-2 sm:grid-cols-2 lg:grid-cols-4">
          {sitemapPages.map((page, index) => <a class="flex gap-2 text-sm text-ink transition-colors hover:text-cobalt hover:underline" href={`#page-${numberFor(index)}`}><span class="font-bold tabular-nums text-cobalt">{numberFor(index)}</span><span>{page.label}</span></a>)}
        </div>
      </div>
    </nav>

    <main class="mx-auto max-w-[1400px] px-5 py-10 md:px-12 lg:px-16 lg:py-14">
      {sitemapGroups.map((group) => (
        <section class="mb-14" aria-labelledby={`group-${group.title.toLowerCase().replaceAll(" ", "-")}`}>
          <div class="mb-5 flex items-end justify-between gap-4 border-b border-line pb-4"><div><p class="eyebrow">Directory</p><h2 id={`group-${group.title.toLowerCase().replaceAll(" ", "-")}`} class="mt-3 font-display text-3xl font-medium tracking-[-0.05em]">{group.title}</h2></div><p class="text-xs font-bold uppercase tracking-[0.12em] text-muted">{group.pages.length} pages</p></div>
          <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
            {group.pages.map((page) => {
              const index = sitemapPages.findIndex((item) => item.href === page.href);
              return <a id={`page-${numberFor(index)}`} class="group overflow-hidden rounded-lg border border-line bg-white shadow-[0_2px_8px_rgb(28_39_49_/_8%)] transition hover:-translate-y-1 hover:border-cobalt hover:shadow-[0_8px_20px_rgb(28_39_49_/_12%)]" href={page.href}>
                <div class="flex aspect-[1.55/1] flex-col justify-between bg-gradient-to-br from-ink via-[#172f5b] to-cobalt p-5 text-white"><span class="self-start rounded border border-white/50 bg-cobalt px-2 py-1 text-xs font-bold tabular-nums">{numberFor(index)}</span><span class="font-display text-2xl font-medium leading-tight tracking-[-0.04em]">{page.label}</span></div>
                <div class="border-t border-line p-4"><p class="text-sm font-bold">{page.kind}</p><p class="mt-2 text-sm leading-relaxed text-muted">{page.description}</p><p class="mt-4 text-xs font-bold uppercase tracking-[0.1em] text-cobalt">Open page ↗</p></div>
              </a>;
            })}
          </div>
        </section>
      ))}
    </main>
  </div>
</Base>
